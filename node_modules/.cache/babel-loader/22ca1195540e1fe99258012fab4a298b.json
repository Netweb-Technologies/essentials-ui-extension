{"remainingRequest":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js??ruleSet[1].rules[4]!/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js??ruleSet[0].use[0]!/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js??ruleSet[0].use[1]!/home/ubuntu/essentials-ui-extension/pkg/harvester/components/FilterBySriov.vue?vue&type=template&id=2dfb91da&scoped=true","dependencies":[{"path":"/home/ubuntu/essentials-ui-extension/pkg/harvester/components/FilterBySriov.vue","mtime":1773206911344},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js","mtime":1773205228903},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js","mtime":1773205228903}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["/home/ubuntu/essentials-ui-extension/pkg/harvester/components/FilterBySriov.vue"],"names":[],"mappings":";;qBAuEO,KAAK,EAAC,QAAQ;;;EAGf,KAAK,EAAC,wBAAwB;;;EAgB1B,GAAG,EAAC,gBAAgB;EACpB,KAAK,EAAC,sBAAsB;;qBASzB,KAAK,EAAC,cAAc;;;;;;wBA7B/B,oBAyCM,OAzCN,UAyCM;KAvCI,iBAAW;uBADnB,oBAQO,QARP,UAQO;4CAJF,iBAAW,IAAG,GAAC;UAAA,oBAGhB;YAFA,KAAK,EAAC,iBAAiB;YACtB,OAAK,uCAAE,eAAM;;;;;IAIlB,aA6Ba;MA5BX,cAAY,EAAC,qBAAqB;MAClC,OAAO,EAAC,OAAO;MACf,SAAS,EAAC,YAAY;MACrB,QAAQ,EAAE,EAAE;;MAaF,MAAM,WACf,CASM;QATN,oBASM,OATN,UASM;UARJ,oBAOM;YANJ,aAKE;cAJQ,KAAK,EAAE,iBAAW;sEAAX,iBAAW;cACzB,OAAO,EAAE,yBAAkB;cAC3B,UAAU,EAAE,IAAI;cAChB,KAAK,EAAE,YAAK;;;;;wBAlBrB,CASO;QATP,YASO,2BATP,CASO;UARL,oBAOS,UAPT,UAOS;YAHP,YAEO,0BAFP,CAEO;gDADF,YAAK","sourcesContent":["<script>\nimport LabeledSelect from '@shell/components/form/LabeledSelect.vue';\n\nexport default {\n  name: 'HarvesterFilterLabel',\n\n  emits: ['change-rows'],\n\n  components: { LabeledSelect },\n\n  props: {\n    rows: {\n      type:     Array,\n      required: true,\n    },\n\n    parentSriovOptions: {\n      type:     Array,\n      required: true,\n    },\n\n    parentSriovLabel: {\n      type:     String,\n      required: true,\n    },\n\n    label: {\n      type:     String,\n      required: true,\n    },\n\n  },\n\n  data() {\n    return { parentSriov: this.$route.query?.parentSriov || null };\n  },\n\n  methods: {\n    remove() {\n      this.parentSriov = null;\n      this.filterRows();\n    },\n\n    filterRows() {\n      const rows = this.rows.filter((row) => {\n        if (!this.parentSriov) {\n          return true;\n        }\n\n        const label = row.labels[this.parentSriovLabel];\n\n        return label === this.parentSriov;\n      });\n\n      this.$emit('change-rows', rows, this.parentSriov);\n    }\n  },\n\n  watch: {\n    parentSriov: {\n      deep:      true,\n      immediate: true,\n      handler() {\n        this.filterRows();\n      }\n    }\n  }\n};\n</script>\n\n<template>\n  <div class=\"filter\">\n    <span\n      v-if=\"parentSriov\"\n      class=\"banner-item bg-warning\"\n    >\n      {{ parentSriov }} <i\n        class=\"icon icon-close\"\n        @click=\"remove()\"\n      />\n    </span>\n\n    <v-dropdown\n      popper-class=\"filter-parent-sriov\"\n      trigger=\"click\"\n      placement=\"bottom-end\"\n      :distance=\"20\"\n    >\n      <slot name=\"header\">\n        <button\n          ref=\"actionDropDown\"\n          class=\"btn bg-primary mr-10\"\n        >\n          <slot name=\"title\">\n            {{ label }}\n          </slot>\n        </button>\n      </slot>\n\n      <template #popper>\n        <div class=\"filter-popup\">\n          <div>\n            <LabeledSelect\n              v-model:value=\"parentSriov\"\n              :options=\"parentSriovOptions\"\n              :searchable=\"true\"\n              :label=\"label\"\n            />\n          </div>\n        </div>\n      </template>\n    </v-dropdown>\n  </div>\n</template>\n\n<style lang=\"scss\" scoped>\n.filter {\n  display: inline-block;\n\n  .banner-item {\n    display: inline-block;\n    font-size: 16px;\n    margin-right: 10px;\n    padding: 6px;\n    border-radius: 2px;\n\n    i {\n      cursor: pointer;\n      vertical-align: middle;\n    }\n  }\n}\n.filter-popup {\n  width: 300px;\n}\n\n:deep() .box {\n  display: grid;\n  grid-template-columns: 40% 40% 10%;\n  column-gap: 1.75%;\n  margin-bottom: 10px;\n}\n\n.required {\n  color: var(--error);\n}\n\n</style>\n\n<style lang=\"scss\">\n.filter-parent-sriov .v-popper__arrow-container {\n  display: none;\n}\n</style>\n"]}]}