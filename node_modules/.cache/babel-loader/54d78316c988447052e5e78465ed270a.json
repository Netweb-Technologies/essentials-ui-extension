{"remainingRequest":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js??ruleSet[1].rules[4]!/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js??ruleSet[0].use[0]!/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js??ruleSet[0].use[1]!/home/ubuntu/essentials-ui-extension/pkg/harvester/components/DiskTags.vue?vue&type=template&id=45a03e75&scoped=true","dependencies":[{"path":"/home/ubuntu/essentials-ui-extension/pkg/harvester/components/DiskTags.vue","mtime":1773206911344},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js","mtime":1773205228903},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js","mtime":1773205228903}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["/home/ubuntu/essentials-ui-extension/pkg/harvester/components/DiskTags.vue"],"names":[],"mappings":";;qBAiHS,KAAK,EAAC,OAAO;qBACX,KAAK,EAAC,YAAY;qBAUpB,KAAK,EAAC,OAAO;;;;EAiCd,KAAK,EAAC,WAAW;;;;;;;wBA7CvB,oBAwDM;IAvDJ,oBAUM,OAVN,UAUM;MATJ,oBAQM,OARN,UAQM;SANI,eAAQ;2BADhB,aAGE;;cADC,CAAC,EAAE,eAAQ;;aAEO,YAAK;6BAA1B,oBAEW;kDADN,YAAK;;;;;;IAId,oBA2CM,OA3CN,UA2CM;yBA1CJ,oBAaM,6BAZe,YAAK,GAAhB,GAAG,EAAE,CAAC;8BADhB,aAaM;UAXH,GAAG,EAAE,CAAC;UACP,KAAK,EAAC,KAAK;;4BAEX,CAEO;YAFP,oBAEO,+BADF,GAAG;;aAGA,kBAAS;+BADjB,oBAIE;;kBAFA,KAAK,EAAC,8BAA8B;kBACnC,OAAK,GAAG,CAAC,KAAK,oBAAW,CAAC,GAAG;;;;;;;;;OAI1B,mBAAU,KAAK,kBAAY;yBADnC,oBAeO;;YAbL,KAAK,EAAC,SAAS;YACd,OAAK,0CAAE,iEAAiB;;sCAEzB,oBAAoC,OAAjC,KAAK,EAAC,wBAAwB;;YACjC,oBAQO;eANG,kBAAW;iCADnB,aAGE;;oBADC,CAAC,EAAE,kBAAW;;mBAEI,eAAQ;mCAA7B,oBAEW;wDADN,eAAQ;;;;;WAKJ,mBAAU,IAAI,kBAAY;2BADvC,oBAWO,QAXP,UAWO;8BAPL,oBAME;gBALA,GAAG,EAAC,aAAa;6EACR,gBAAU;gBACnB,IAAI,EAAC,MAAM;gBACV,MAAI,0CAAE,mDAAU;gBAChB,SAAO,mEAAgB,mDAAU;;8BAHzB,gBAAU","sourcesContent":["<script>\nimport { _VIEW, _EDIT, _CREATE } from '@shell/config/query-params';\nimport Tag from '@shell/components/Tag';\n\nexport default {\n  name: 'Tags',\n\n  emits: ['update:value'],\n\n  components: { Tag },\n\n  props: {\n    value: {\n      type:     Array,\n      required: true,\n    },\n\n    label: {\n      type:    String,\n      default: '',\n    },\n\n    labelKey: {\n      type:    String,\n      default: '',\n    },\n\n    addLabel: {\n      type:    String,\n      default: '',\n    },\n\n    addLabelKey: {\n      type:    String,\n      default: '',\n    },\n\n    canAdd: {\n      type:    Boolean,\n      default: true,\n    },\n\n    mode: {\n      type:    String,\n      default: _CREATE,\n    },\n\n    disabled: {\n      type:    Boolean,\n      default: false,\n    },\n  },\n\n  data() {\n    return {\n      tags:         this.value,\n      inputVisible: false,\n      inputValue:   '',\n    };\n  },\n\n  computed: {\n    isCreate() {\n      return this.mode === _CREATE;\n    },\n\n    isView() {\n      return this.mode === _VIEW;\n    },\n\n    isEdit() {\n      return this.mode === _EDIT;\n    },\n\n    canRemove() {\n      return !this.isView;\n    },\n\n    addVisible() {\n      return this.canAdd && !this.isView;\n    },\n  },\n\n  methods: {\n    onClickPlusButton() {\n      this.inputVisible = true;\n      this.$nextTick(() => {\n        if ( this.$refs.addTagInput ) {\n          this.$refs.addTagInput.focus();\n        }\n      });\n    },\n\n    confirmAdd() {\n      if (this.inputValue && !this.value.includes(this.inputValue)) {\n        this.tags.push(this.inputValue);\n        this.$emit('update:value', this.tags);\n      }\n\n      this.inputValue = '';\n      this.inputVisible = false;\n    },\n\n    onRemoveTag(tag) {\n      this.tags = this.tags.filter((v) => v !== tag);\n      this.$emit('update:value', this.tags);\n    },\n  }\n};\n</script>\n\n<template>\n  <div>\n    <div class=\"label\">\n      <div class=\"text-label\">\n        <t\n          v-if=\"labelKey\"\n          :k=\"labelKey\"\n        />\n        <template v-else-if=\"label\">\n          {{ label }}\n        </template>\n      </div>\n    </div>\n    <div class=\"mt-10\">\n      <Tag\n        v-for=\"(tag, i) in value\"\n        :key=\"i\"\n        class=\"tag\"\n      >\n        <span>\n          {{ tag }}\n        </span>\n        <i\n          v-if=\"canRemove\"\n          class=\"icon icon-close ml-5 icon-sm\"\n          @click=\"(e) => onRemoveTag(tag)\"\n        />\n      </Tag>\n      <span\n        v-if=\"addVisible && !inputVisible\"\n        class=\"tag add\"\n        @click=\"onClickPlusButton\"\n      >\n        <i class=\"icon icon-plus icon-sm\" />\n        <span>\n          <t\n            v-if=\"addLabelKey\"\n            :k=\"addLabelKey\"\n          />\n          <template v-else-if=\"addLabel\">\n            {{ addLabel }}\n          </template>\n        </span>\n      </span>\n      <span\n        v-else-if=\"addVisible && inputVisible\"\n        class=\"tag input\"\n      >\n        <input\n          ref=\"addTagInput\"\n          v-model=\"inputValue\"\n          type=\"text\"\n          @blur=\"confirmAdd\"\n          @keydown.enter.prevent=\"confirmAdd\"\n        />\n      </span>\n    </div>\n  </div>\n</template>\n\n<style lang=\"scss\" scoped>\n  .tag {\n    border: 1px solid var(--primary);\n    border-radius: var(--border-radius);\n    box-sizing: border-box;\n    margin: 0;\n    padding: 0;\n    font-size: 14px;\n    line-height: 20px;\n    list-style: none;\n    display: inline-block;\n    height: auto;\n    margin-inline-end: 8px;\n    padding-inline: 7px;\n    white-space: nowrap;\n    background: var(--accent-btn);\n    opacity: 1;\n    text-align: start;\n    color: var(--link);\n    margin-bottom: 10px;\n    margin-right: 8px;\n    padding-top: 8px;\n    padding-bottom: 8px;\n\n    i {\n      cursor: pointer;\n    }\n\n    &.add {\n      background: var(--body-bg);\n      border-style: dashed;\n      cursor: pointer;\n    }\n\n    &.input {\n      border: none;\n      border-radius: none;\n      background: var(--body-bg);\n      padding: 0px;\n    }\n  }\n</style>\n"]}]}