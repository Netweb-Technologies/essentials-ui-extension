{"remainingRequest":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js??ruleSet[1].rules[4]!/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js??ruleSet[0].use[0]!/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js??ruleSet[0].use[1]!/home/ubuntu/essentials-ui-extension/pkg/harvester/components/settings/overcommit-config.vue?vue&type=template&id=673b2f97","dependencies":[{"path":"/home/ubuntu/essentials-ui-extension/pkg/harvester/components/settings/overcommit-config.vue","mtime":1773206911348},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js","mtime":1773205228903},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js","mtime":1773205228903}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["/home/ubuntu/essentials-ui-extension/pkg/harvester/components/settings/overcommit-config.vue"],"names":["mode"],"mappings":";;qBAoDO,KAAK,EAAC,KAAK;qBACT,KAAK,EAAC,aAAa;;;;;wBAD1B,oBAiCM,OAjCN,UAiCM;IAhCJ,oBA+BM,OA/BN,UA+BM;MA9BJ,aASE;QARQ,KAAK,EAAE,uBAAiB,CAAC,GAAG;;gDAArB,uBAAiB,CAAC,GAAG;UAOrB,eAAM;;QANrB,WAAS,EAAC,uBAAuB;QACjC,MAAM,EAAC,GAAG;QACT,KAAK,EAAE,CAAC;QACT,QAAQ,EAAR,EAAQ;QACP,IAAI,EAAEA,SAAI;QACX,KAAK,EAAC,OAAO;;;MAGf,aASE;QARQ,KAAK,EAAE,uBAAiB,CAAC,MAAM;;gDAAxB,uBAAiB,CAAC,MAAM;UAOxB,eAAM;;QANrB,WAAS,EAAC,0BAA0B;QACpC,MAAM,EAAC,GAAG;QACT,KAAK,EAAE,CAAC;QACT,QAAQ,EAAR,EAAQ;QACP,IAAI,EAAEA,SAAI;QACX,KAAK,EAAC,OAAO;;;MAGf,aASE;QARQ,KAAK,EAAE,uBAAiB,CAAC,OAAO;;gDAAzB,uBAAiB,CAAC,OAAO;UAOzB,eAAM;;QANrB,WAAS,EAAC,2BAA2B;QACrC,MAAM,EAAC,GAAG;QACT,KAAK,EAAE,CAAC;QACT,QAAQ,EAAR,EAAQ;QACP,IAAI,EAAEA,SAAI;QACX,KAAK,EAAC,OAAO","sourcesContent":["<script>\nimport CreateEditView from '@shell/mixins/create-edit-view';\nimport UnitInput from '@shell/components/form/UnitInput';\n\nexport default {\n  name: 'HarvesterOvercommitConfig',\n\n  components: { UnitInput },\n\n  mixins: [CreateEditView],\n\n  data() {\n    let parseDefaultValue = {};\n\n    try {\n      parseDefaultValue = JSON.parse(this.value.value);\n    } catch (error) {\n      parseDefaultValue = JSON.parse(this.value.default);\n    }\n\n    return {\n      parseDefaultValue,\n      errors: []\n    };\n  },\n\n  created() {\n    this.update();\n  },\n\n  methods: {\n    update() {\n      const value = JSON.stringify(this.parseDefaultValue);\n\n      this.value['value'] = value;\n    }\n  },\n\n  watch: {\n    value: {\n      handler(neu) {\n        const parseDefaultValue = JSON.parse(neu.value);\n\n        this['parseDefaultValue'] = parseDefaultValue;\n      },\n      deep: true\n    }\n  }\n};\n</script>\n\n<template>\n  <div class=\"row\">\n    <div class=\"col span-12\">\n      <UnitInput\n        v-model:value=\"parseDefaultValue.cpu\"\n        label-key=\"harvester.generic.cpu\"\n        suffix=\"%\"\n        :delay=\"0\"\n        required\n        :mode=\"mode\"\n        class=\"mb-20\"\n        @update:value=\"update\"\n      />\n      <UnitInput\n        v-model:value=\"parseDefaultValue.memory\"\n        label-key=\"harvester.generic.memory\"\n        suffix=\"%\"\n        :delay=\"0\"\n        required\n        :mode=\"mode\"\n        class=\"mb-20\"\n        @update:value=\"update\"\n      />\n      <UnitInput\n        v-model:value=\"parseDefaultValue.storage\"\n        label-key=\"harvester.generic.storage\"\n        suffix=\"%\"\n        :delay=\"0\"\n        required\n        :mode=\"mode\"\n        class=\"mb-20\"\n        @update:value=\"update\"\n      />\n    </div>\n  </div>\n</template>\n"]}]}