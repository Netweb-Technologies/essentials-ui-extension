{"remainingRequest":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js??ruleSet[1].rules[4]!/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js??ruleSet[0].use[0]!/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js??ruleSet[0].use[1]!/home/ubuntu/essentials-ui-extension/pkg/harvester/edit/kubevirt.io.virtualmachine/CompatibilityMatrix.vue?vue&type=template&id=18eeebf6","dependencies":[{"path":"/home/ubuntu/essentials-ui-extension/pkg/harvester/edit/kubevirt.io.virtualmachine/CompatibilityMatrix.vue","mtime":1773206911362},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js","mtime":1773205228903},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js","mtime":1773205228903}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["/home/ubuntu/essentials-ui-extension/pkg/harvester/edit/kubevirt.io.virtualmachine/CompatibilityMatrix.vue"],"names":["t"],"mappings":";;qBA4EO,KAAK,EAAC,eAAe;qBACnB,KAAK,EAAC,uBAAuB;qBAC3B,KAAK,EAAC,cAAc;qBAClB,KAAK,EAAC,YAAY;;;;;wBAH7B,oBAiCM,OAjCN,UAiCM;IAhCJ,oBAaM,OAbN,UAaM;MAZJ,oBAKM,OALN,UAKM;QAJJ,oBAEM,OAFN,UAEM,mBADDA,MAAC;;QAEN,oBAAsD,8BAA9CA,MAAC;;;yBAEX,oBAKM,6BAJoB,qBAAY,GAA5B,QAAQ,EAAE,CAAC;8BADrB,oBAKM,SAHH,GAAG,EAAE,CAAC;UAEP,oBAA6B,+BAAlB,QAAQ;;;;;uBAGvB,oBAiBM,6BAhBqB,qBAAc,GAA/B,SAAS,EAAE,CAAC;4BADtB,oBAiBM,SAfH,GAAG,EAAE,CAAC;uCAEP,oBAMM;UAJJ,KAAK,mBAAC,0BAA0B,iBACT,sBAAa,CAAC,SAAS;;4CAE3C,SAAS,CAAC,QAAQ,CAAC,IAAI;;qCAJT,sBAAa,CAAC,SAAS;;;2BAM1C,oBAKE,6BAJwB,qBAAY,GAA5B,QAAQ,EAAE,CAAC;gCADrB,oBAKE;YAHC,GAAG,EAAE,CAAC;YACP,KAAK,mBAAC,aAAa,iBACI,sBAAa,CAAC,QAAQ,EAAE,SAAS","sourcesContent":["<script>\nimport { mapGetters } from 'vuex';\nexport default {\n  props: {\n    /**\n     * deviceId/vendorId is unique per type of device - there may be multiple CRD objects for a given device\n     * {\n     *  [deviceId/vendorId]: {\n     *      nodes: array of devicecrd.status.nodeName's for given device,\n     *      deviceCRDs: array of all instances of given device\n     *      }\n     * }\n     */\n    enabledDevices: {\n      type:     Array,\n      required: true\n    },\n    /**\n * {\n *  [node name]: [devices]\n * }\n */\n    devicesByNode: {\n      type:     Object,\n      required: true\n    },\n\n    /**\n * {\n *  [deviceCRD.status.resourceName]: {\n *      count: number of this device in use by other vms\n *      usedBy: [names of all vms using this device]\n *    }\n * }\n */\n\n    devicesInUse: {\n      type:    Object,\n      default: () => {}\n    }\n  },\n\n  computed: {\n    ...mapGetters({ t: 'i18n/t' }),\n    allNodeNames() {\n      return Object.keys(this.devicesByNode);\n    },\n\n    allDeviceIds() {\n      return Object.keys(this.uniqueDevices);\n    }\n  },\n\n  methods: {\n    nodeNameFromId(id) {\n      return this.devicesByNode[id]?.name;\n    },\n\n    nodeHasDevice(nodeName, deviceCRD) {\n      return deviceCRD.status.nodeName === nodeName;\n    },\n\n    noneAvailable(deviceCRD) {\n      const name = deviceCRD.metadata?.name;\n\n      return !!this.devicesInUse[name];\n    },\n\n    deviceTooltip(deviceCRD) {\n      return `${ deviceCRD?.status?.resourceName }<br/>${ deviceCRD?.status?.description }`;\n    }\n  }\n};\n</script>\n\n<template>\n  <div class=\"compat-matrix\">\n    <div class=\"device-col node-names\">\n      <div class=\"blank-corner\">\n        <div class=\"text-right\">\n          {{ t('harvester.devices.matrixDeviceClaimName') }}\n        </div>\n        <div>{{ t('harvester.devices.matrixHostName') }}</div>\n      </div>\n      <div\n        v-for=\"(nodeName, i) in allNodeNames\"\n        :key=\"i\"\n      >\n        <span>  {{ nodeName }}</span>\n      </div>\n    </div>\n    <div\n      v-for=\"(deviceCRD, i) in enabledDevices\"\n      :key=\"i\"\n    >\n      <div\n        v-clean-tooltip=\"deviceTooltip(deviceCRD)\"\n        class=\"compat-cell device-label\"\n        :class=\"{'text-muted': noneAvailable(deviceCRD)}\"\n      >\n        {{ deviceCRD.metadata.name }}\n      </div>\n      <div\n        v-for=\"(nodeName, k) in allNodeNames\"\n        :key=\"k\"\n        class=\"compat-cell\"\n        :class=\"{'has-device': nodeHasDevice(nodeName, deviceCRD)}\"\n      />\n    </div>\n  </div>\n</template>\n\n<style lang='scss'>\n.compat-matrix {\n    display: flex;\n}\n\n.device-col {\n    display: flex;\n    flex-direction: column;\n\n    border-right: 1px solid var(--border);\n\n    &>*{\n        border-bottom: 1px solid var(--border);\n    }\n}\n\n.compat-cell {\n    flex-basis: 1em;\n    padding: 0px 10px 0px 10px;\n\n    &.has-device {\n        background-color: var(--info-banner-bg);\n    }\n}\n\n.node-label, .device-label {\n    display: flex;\n    align-items: center;\n    color: var(--input-label);\n}\n\n.node-label{\n    padding: 0 10px;\n    justify-content: center;\n}\n\n.node-label, .device-label, .compat-cell, .blank-corner {\n    flex-basis: calc(2em + 10px);\n}\n\n.blank-corner {\n  background: linear-gradient(\n              to top right,\n              #fff 0%,\n              #fff calc(50% - 1px),\n                var(--body-text) 50%,\n              #fff calc(50% + 1px),\n              #fff 100%\n           );\n\n  DIV.text-right {\n    padding-left: 80px;\n  }\n}\n</style>\n"]}]}