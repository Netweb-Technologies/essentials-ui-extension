AI;UACjB,IAAI,EAAE,WAAI;;4BAEX,CAOE;YAPF,aAOE;cANQ,KAAK,EAAE,YAAK,CAAC,IAAI;;sDAAV,YAAK,CAAC,IAAI;gBAKV,eAAM;;cAJpB,KAAK,EAAEA,MAAC;cACR,OAAO,EAAE,iBAAW;cACpB,IAAI,EAAE,WAAI;cACX,QAAQ,EAAR,EAAQ;;;;;;;;IAOhB,oBAqCM,OArCN,UAqCM;MApCJ,oBAiBM,OAjBN,UAiBM;QAbJ,aAYiB;UAXd,IAAI,EAAEA,MAAC;UACP,KAAK,EAAE,YAAK,CAAC,SAAS;UACtB,IAAI,EAAE,WAAI;;4BAEX,CAME;YANF,aAME;cALQ,KAAK,EAAE,YAAK,CAAC,SAAS;;sDAAf,YAAK,CAAC,SAAS;gBAIf,eAAM;;cAHpB,KAAK,EAAEA,MAAC;cACR,IAAI,EAAE,WAAI;cACX,QAAQ,EAAR,EAAQ;;;;;;;MAKd,oBAiBM,OAjBN,UAiBM;QAbJ,aAYiB;UAXd,IAAI,EAAEA,MAAC;UACP,KAAK,EAAE,YAAK,CAAC,GAAG;UAChB,IAAI,EAAE,WAAI;;4BAEX,CAME;YANF,aAME;cALQ,KAAK,EAAE,YAAK,CAAC,GAAG;;sDAAT,YAAK,CAAC,GAAG;gBAIT,eAAM;;cAHpB,KAAK,EAAEA,MAAC;cACR,OAAO,EAAE,qBAAe;cACxB,IAAI,EAAE,WAAI;;;;;;;;IAMnB,oBAgBM,OAhBN,UAgBM;OAdI,YAAK,CAAC,aAAa;yBAD3B,oBAcM,OAdN,UAcM;YAVJ,aASiB;cARd,IAAI,EAAEA,MAAC;cACP,KAAK,EAAE,YAAK,CAAC,aAAa,CAAC,UAAU;cACrC,IAAI,EAAE,WAAI;;gCAEX,CAGE;gBAHF,aAGE;kBAFC,IAAI,EAAEA,MAAC;kBACP,KAAK,EAAE,YAAK,CAAC,aAAa,CAAC,UAAU;;;;;;;;;KAMtC,YAAK,CAAC,aAAa,IAAI,YAAK,CAAC,aAAa,CAAC,KAAK,IAAI,YAAK,CAAC,aAAa,CAAC,KAAK,CAAC,OAAO;uBAD7F,aAKE;;UAHA,KAAK,EAAC,OAAO;UACb,KAAK,EAAC,OAAO;UACZ,KAAK,EAAE,YAAK,CAAC,aAAa,CAAC,KAAK,CAAC,OAAO","sourcesContent":["<script>\nimport { LabeledInput } from '@components/Form/LabeledInput';\nimport LabeledSelect from '@shell/components/form/LabeledSelect';\nimport InputOrDisplay from '@shell/components/InputOrDisplay';\nimport { VOLUME_TYPE, InterfaceOption } from '../../../../config/harvester-map';\nimport { Banner } from '@components/Banner';\n\nexport default {\n  name: 'HarvesterEditContainer',\n\n  emits: ['update'],\n\n  components: {\n    LabeledInput, LabeledSelect, InputOrDisplay, Banner\n  },\n\n  props: {\n    mode: {\n      type:    String,\n      default: 'create'\n    },\n\n    value: {\n      type:     Object,\n      required: true\n    },\n  },\n\n  data() {\n    return {\n      VOLUME_TYPE,\n      InterfaceOption\n    };\n  },\n\n  watch: {\n    'value.type'(neu) {\n      if (neu === 'cd-rom') {\n        this.value['bus'] = 'sata';\n        this.update();\n      }\n    },\n  },\n\n  methods: {\n    update() {\n      this.$emit('update');\n    }\n  }\n};\n</script>\n\n<template>\n  <div>\n    <div class=\"row mb-20\">\n      <div\n        data-testid=\"input-hec-name\"\n        class=\"col span-6\"\n      >\n        <InputOrDisplay\n          :name=\"t('harvester.fields.name')\"\n          :value=\"value.name\"\n          :mode=\"mode\"\n        >\n          <LabeledInput\n            v-model:value=\"value.name\"\n            :label=\"t('harvester.fields.name')\"\n            required\n            :mode=\"mode\"\n            @update:value=\"update\"\n          />\n        </InputOrDisplay>\n      </div>\n      <div\n        data-testid=\"input-hec-type\"\n        class=\"col span-6\"\n      >\n        <InputOrDisplay\n          :name=\"t('harvester.fields.type')\"\n          :value=\"value.type\"\n          :mode=\"mode\"\n        >\n          <LabeledSelect\n            v-model:value=\"value.type\"\n            :label=\"t('harvester.fields.type')\"\n            :options=\"VOLUME_TYPE\"\n            :mode=\"mode\"\n            required\n            @update:value=\"update\"\n          />\n        </InputOrDisplay>\n      </div>\n    </div>\n\n    <div class=\"row mb-20\">\n      <div\n        data-testid=\"input-hec-container\"\n        class=\"col span-6\"\n      >\n        <InputOrDisplay\n          :name=\"t('harvester.virtualMachine.volume.dockerImage')\"\n          :value=\"value.container\"\n          :mode=\"mode\"\n        >\n          <LabeledInput\n            v-model:value=\"value.container\"\n            :label=\"t('harvester.virtualMachine.volume.dockerImage')\"\n            :mode=\"mode\"\n            required\n            @update:value=\"update\"\n          />\n        </InputOrDisplay>\n      </div>\n      <div\n        data-testid=\"input-hec-bus\"\n        class=\"col span-6\"\n      >\n        <InputOrDisplay\n          :name=\"t('harvester.virtualMachine.volume.bus')\"\n          :value=\"value.bus\"\n          :mode=\"mode\"\n        >\n          <LabeledSelect\n            v-model:value=\"value.bus\"\n            :label=\"t('harvester.virtualMachine.volume.bus')\"\n            :options=\"InterfaceOption\"\n            :mode=\"mode\"\n            @update:value=\"update\"\n          />\n        </InputOrDisplay>\n      </div>\n    </div>\n    <div class=\"row mb-20\">\n      <div\n        v-if=\"value.volumeBackups\"\n        class=\"col span-6\"\n      >\n        <InputOrDisplay\n          :name=\"t('harvester.virtualMachine.volume.readyToUse')\"\n          :value=\"value.volumeBackups.readyToUse\"\n          :mode=\"mode\"\n        >\n          <LabelValue\n            :name=\"t('harvester.virtualMachine.volume.readyToUse')\"\n            :value=\"value.volumeBackups.readyToUse\"\n          />\n        </InputOrDisplay>\n      </div>\n    </div>\n    <Banner\n      v-if=\"value.volumeBackups && value.volumeBackups.error && value.volumeBackups.error.message\"\n      color=\"error\"\n      class=\"mb-20\"\n      :label=\"value.volumeBackups.error.message\"\n    />\n  </div>\n</template>\n"]}]}