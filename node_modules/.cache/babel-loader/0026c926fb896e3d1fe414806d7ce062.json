{"remainingRequest":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js??ruleSet[1].rules[4]!/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js??ruleSet[0].use[0]!/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js??ruleSet[0].use[1]!/home/ubuntu/essentials-ui-extension/pkg/harvester/formatters/HarvesterVFAddress.vue?vue&type=template&id=9a87d58c&scoped=true","dependencies":[{"path":"/home/ubuntu/essentials-ui-extension/pkg/harvester/formatters/HarvesterVFAddress.vue","mtime":1773206911370},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js","mtime":1773205228903},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js","mtime":1773205228903}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["/home/ubuntu/essentials-ui-extension/pkg/harvester/formatters/HarvesterVFAddress.vue"],"names":["t"],"mappings":";;qBAgDO,KAAK,EAAC,KAAK;;;qBA6BL,KAAK,EAAC,WAAW;;;;;;;wBA7B5B,oBA+CM,OA/CN,UA+CM;uBA9CJ,oBAWO,6BAViB,aAAI,CAAC,OAAO,GAA1B,EAAE,EAAE,KAAK;4BADnB,oBAWO,UATJ,GAAG,EAAE,KAAK;QAEX,aAIc;UAHX,EAAE,EAAE,EAAE,CAAC,EAAE;;4BAEV,CAAa;8CAAV,EAAE,CAAC,IAAI;;;;;SAGA,KAAK,GAAG,aAAI,CAAC,OAAO,CAAC,MAAM;2BAAvC,oBAAsD,oBAAT,IAAE;;;;;IAGjD,aAgCa;MA/BX,OAAO,EAAC,OAAO;MACf,SAAS,EAAC,KAAK;;MAYJ,MAAM,WACf,CAeM;QAfN,oBAeM,OAfN,UAeM;UAdJ,oBAaM;+BAZJ,oBAWO,6BAViB,aAAI,CAAC,SAAS,GAA5B,EAAE,EAAE,KAAK;oCADnB,oBAWO,UATJ,GAAG,EAAE,KAAK;gBAEX,aAIc;kBAHX,EAAE,EAAE,EAAE,CAAC,EAAE;;oCAEV,CAAa;sDAAV,EAAE,CAAC,IAAI;;;;;iBAGA,KAAK,GAAG,aAAI,CAAC,SAAS,CAAC,MAAM;mCAAzC,oBAAwD,oBAAT,IAAE;;;;;;;wBAhCpD,CAWW;SAFJ,eAAM,CAAC,MAAM,GAAG,oBAAc;2BAA1C,oBAQO;yDARqC,cACxC;cAAA,oBAME;gBALF,IAAI,EAAC,oBAAoB;gBACzB,KAAK,EAAC,WAAW;gBAChB,OAAK,sDAAU,aAAO,IAAI,aAAO;kCAE/BA,MAAC","sourcesContent":["<script>\nimport { PRODUCT_NAME as HARVESTER_PRODUCT } from '../config/harvester';\n\nexport default {\n  name: 'HarvesterVFAddress',\n\n  props: {\n    row: {\n      type:     Object,\n      required: true\n    },\n  },\n\n  data() {\n    return { showAll: false, limitedNumbers: 3 };\n  },\n\n  computed: {\n    allVFs() {\n      return this.row.status?.vfAddresses || [];\n    },\n\n    rows() {\n      const out = this.allVFs.map((O) => {\n        const [prefix, middle, suffix] = O.split(':');\n        const q = `${ this.row.spec?.nodeName }-${ prefix }${ middle }${ suffix.replace('.', '') }`;\n        const to = {\n          name:   `${ HARVESTER_PRODUCT }-c-cluster-resource`,\n          params: { cluster: this.$store.getters['clusterId'], resource: this.row.childDevice },\n          query:  { q }\n        };\n\n        return {\n          to,\n          name: O\n        };\n      });\n\n      return {\n        visible:   out.slice(0, this.limitedNumbers),\n        invisible: out.slice(this.limitedNumbers)\n      };\n    },\n  }\n};\n</script>\n\n<template>\n  <div class=\"vfs\">\n    <span\n      v-for=\"(vf, index) in rows.visible\"\n      :key=\"index\"\n    >\n      <router-link\n        :to=\"vf.to\"\n      >\n        {{ vf.name }}\n      </router-link>\n\n      <span v-if=\"index < rows.visible.length - 1\">, </span>\n    </span>\n\n    <v-dropdown\n      trigger=\"click\"\n      placement=\"top\"\n    >\n      <span v-if=\"allVFs.length > limitedNumbers\">\n        , <a\n          href=\"javascript:void(0)\"\n          class=\"show-more\"\n          @click.prevent=\"showAll = !showAll\"\n        >\n          {{ t('harvester.sriov.showMore') }}\n        </a>\n      </span>\n\n      <template #popper>\n        <div class=\"vfs-popup\">\n          <div>\n            <span\n              v-for=\"(vf, index) in rows.invisible\"\n              :key=\"index\"\n            >\n              <router-link\n                :to=\"vf.to\"\n              >\n                {{ vf.name }}\n              </router-link>\n\n              <span v-if=\"index < rows.invisible.length - 1\">, </span>\n            </span>\n          </div>\n        </div>\n      </template>\n    </v-dropdown>\n  </div>\n</template>\n\n<style lang=\"scss\" scoped>\n\n  .vfs {\n    min-width: 380px;\n\n    .show-more {\n      font-size: 12px;\n    }\n  }\n  .popover .popover-inner .vfs-popup a {\n    color: var(--link);\n\n    &:hover {\n      text-decoration: underline;\n      color: var(--body-text);\n    }\n  }\n</style>\n"]}]}