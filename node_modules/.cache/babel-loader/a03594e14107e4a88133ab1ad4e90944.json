{"remainingRequest":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js??ruleSet[1].rules[4]!/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js??ruleSet[0].use[0]!/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js??ruleSet[0].use[1]!/home/ubuntu/essentials-ui-extension/pkg/harvester/edit/harvesterhci.io.cloudtemplate.vue?vue&type=template&id=1704ef62&scoped=true","dependencies":[{"path":"/home/ubuntu/essentials-ui-extension/pkg/harvester/edit/harvesterhci.io.cloudtemplate.vue","mtime":1773206911359},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js","mtime":1773205228903},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js","mtime":1773205228903}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["/home/ubuntu/essentials-ui-extension/pkg/harvester/edit/harvesterhci.io.cloudtemplate.vue"],"names":["doneRoute","mode","value","errors","applyHooks","save","done","$emit","t","isCreate"],"mappings":";;qBAiGa,KAAK,EAAC,OAAO;qBASb,KAAK,EAAC,eAAe;;;;;;;;;;wBAhChC,aA2Cc;IA1CX,YAAU,EAAEA,cAAS;IACrB,IAAI,EAAEC,SAAI;IACV,QAAQ,EAAEC,UAAK;IACf,MAAM,EAAEC,WAAM;IACd,aAAW,EAAEC,eAAU;IACvB,QAAM,EAAEC,SAAI;IACZ,QAAM,EAAEC,SAAI;IACZ,OAAK,4BAAE,CAAC,EAAEH,WAAM,CAAC,CAAC;;sBAEnB,CAKE;MALF,aAKE;QAJC,KAAK,EAAED,UAAK;QACZ,IAAI,EAAED,SAAI;QACV,UAAU,EAAE,IAAI;QAChB,gBAAY,uCAAEM,UAAK,iBAAiB,MAAM;;;MAG7C,aAyBS,qBAzBA,WAAS,EAAE,IAAI;0BACtB,CAuBM;UAvBN,aAuBM;YAtBJ,IAAI,EAAC,QAAQ;YACZ,KAAK,EAAEC,MAAC;YACR,MAAM,EAAE,CAAC;;8BAEV,CAOM;cAPN,oBAOM,OAPN,UAOM;gBANJ,aAKE;kBAJQ,KAAK,EAAE,UAAI;0EAAJ,UAAI;kBAClB,KAAK,EAAEA,MAAC;kBACR,QAAQ,GAAGC,aAAQ;kBACnB,OAAO,EAAE,cAAK;;;;cAInB,oBAQM,OARN,UAQM;gBAPJ,aAME;kBALA,GAAG,EAAC,UAAU;kBACN,KAAK,EAAE,YAAM;0EAAN,YAAM;kBACrB,KAAK,EAAC,aAAa;kBAClB,aAAW,EAAER,SAAI;kBACjB,WAAS,EAAE,eAAM","sourcesContent":["<script>\nimport Tabbed from '@shell/components/Tabbed';\nimport Tab from '@shell/components/Tabbed/Tab';\nimport CruResource from '@shell/components/CruResource';\nimport LabeledSelect from '@shell/components/form/LabeledSelect';\nimport NameNsDescription from '@shell/components/form/NameNsDescription';\nimport YamlEditor from '@shell/components/YamlEditor';\n\nimport CreateEditView from '@shell/mixins/create-edit-view';\nimport { HCI } from '@pkg/harvester/config/labels-annotations';\n\nexport default {\n  name: 'HarvesterEditCloudTemplate',\n\n  emits: ['update:value'],\n\n  components: {\n    Tab,\n    Tabbed,\n    YamlEditor,\n    CruResource,\n    LabeledSelect,\n    NameNsDescription,\n  },\n\n  mixins: [CreateEditView],\n\n  inheritAttrs: false,\n\n  data() {\n    return {\n      config: this.value.data?.cloudInit || '',\n      type:   this.value?.metadata?.labels?.[HCI.CLOUD_INIT] || 'user',\n    };\n  },\n\n  computed: {\n    types() {\n      return [{\n        label: 'User Data',\n        value: 'user'\n      }, {\n        label: 'Network Data',\n        value: 'network'\n      }];\n    },\n  },\n\n  created() {\n    if (this.registerBeforeHook) {\n      this.registerBeforeHook(this.updateBeforeSave);\n    }\n  },\n\n  methods: {\n    update() {\n      this.value.data = { cloudInit: this.config };\n    },\n\n    updateBeforeSave() {\n      if (this.isCreate) {\n        this.value.metadata.labels = {\n          ...this.value.metadata.labels,\n          [HCI.CLOUD_INIT]: this.type,\n        };\n\n        this.value.data = { cloudInit: this.config };\n      }\n    }\n  }\n};\n</script>\n\n<template>\n  <CruResource\n    :done-route=\"doneRoute\"\n    :mode=\"mode\"\n    :resource=\"value\"\n    :errors=\"errors\"\n    :apply-hooks=\"applyHooks\"\n    @finish=\"save\"\n    @cancel=\"done\"\n    @error=\"e=>errors=e\"\n  >\n    <NameNsDescription\n      :value=\"value\"\n      :mode=\"mode\"\n      :namespaced=\"true\"\n      @update:value=\"$emit('update:value', $event)\"\n    />\n\n    <Tabbed :side-tabs=\"true\">\n      <Tab\n        name=\"basics\"\n        :label=\"t('harvester.host.tabs.basics')\"\n        :weight=\"1\"\n      >\n        <div class=\"mb-20\">\n          <LabeledSelect\n            v-model:value=\"type\"\n            :label=\"t('harvester.cloudTemplate.templateType')\"\n            :disabled=\"!isCreate\"\n            :options=\"types\"\n          />\n        </div>\n\n        <div class=\"resource-yaml\">\n          <YamlEditor\n            ref=\"yamlUser\"\n            v-model:value=\"config\"\n            class=\"yaml-editor\"\n            :editor-mode=\"mode === 'view' ? 'VIEW_CODE' : 'EDIT_CODE'\"\n            @onChanges=\"update\"\n          />\n        </div>\n      </Tab>\n    </Tabbed>\n  </CruResource>\n</template>\n\n<style lang=\"scss\" scoped>\n  $yaml-height: 200px;\n\n  :deep() .yaml-editor{\n    flex: 1;\n    min-height: $yaml-height;\n    & .code-mirror .CodeMirror {\n      position: initial;\n      height: auto;\n      min-height: $yaml-height;\n    }\n  }\n</style>\n"]}]}