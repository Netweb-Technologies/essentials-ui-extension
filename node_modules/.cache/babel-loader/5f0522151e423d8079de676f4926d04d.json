put\n        v-model:value.number=\"numVFs\"\n        type=\"number\"\n        min=\"1\"\n        required\n        :label=\"t('harvester.sriov.numVFs')\"\n      />\n    </template>\n\n    <template #actions>\n      <div class=\"buttons actions\">\n        <button\n          class=\"btn role-secondary mr-10\"\n          @click=\"close\"\n        >\n          {{ t('generic.cancel') }}\n        </button>\n\n        <AsyncButton\n          mode=\"enable\"\n          @click=\"save\"\n        />\n      </div>\n    </template>\n  </Card>\n</template>\n\n<style lang=\"scss\" scoped>\n.actions {\n  width: 100%;\n}\n\n.buttons {\n  display: flex;\n  justify-content: flex-end;\n  width: 100%;\n}\n</style>\n"]}]}