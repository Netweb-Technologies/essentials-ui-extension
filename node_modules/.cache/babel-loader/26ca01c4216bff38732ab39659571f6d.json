   :namespace=\"resourceType.metadata.namespace\"\n          :mode=\"mode\"\n          :searchable=\"false\"\n          @update:sshKey=\"updateSSH\"\n        />\n      </div>\n    </div>\n  </div>\n</template>\n"]}]}