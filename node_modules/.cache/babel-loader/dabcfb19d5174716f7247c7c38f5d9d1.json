{"remainingRequest":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js??ruleSet[1].rules[4]!/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js??ruleSet[0].use[0]!/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js??ruleSet[0].use[1]!/home/ubuntu/essentials-ui-extension/pkg/harvester/edit/kubeovn.io.vpc/StaticRoutes.vue?vue&type=template&id=c9d9a1d2&scoped=true","dependencies":[{"path":"/home/ubuntu/essentials-ui-extension/pkg/harvester/edit/kubeovn.io.vpc/StaticRoutes.vue","mtime":1773206911362},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js","mtime":1773205228903},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js","mtime":1773205228903}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["/home/ubuntu/essentials-ui-extension/pkg/harvester/edit/kubeovn.io.vpc/StaticRoutes.vue"],"names":["t"],"mappings":";;;;EAoGM,KAAK,EAAC,kBAAkB;;qBAMjB,KAAK,EAAC,mBAAmB;qBACtB,KAAK,EAAC,WAAW;qBAGjB,KAAK,EAAC,gBAAgB;;EAKxB,KAAK,EAAC,gBAAgB;EACtB,QAAQ,EAAC,GAAG;;qBAIb,KAAK,EAAC,eAAe;qBACnB,KAAK,EAAC,WAAW;;;sBAYjB,KAAK,EAAC,gBAAgB;;;;;;;;;;;wBA3CnC,oBA0EM;IAzEJ,aAMS,qBAND,KAAK,EAAC,MAAM;wBAClB,CAIE;QAJF,aAIE;UAHA,CAAC,EAAC,sCAAsC;UACvC,GAAG,EAAE,IAAI;UACT,GAAG,EAAE,+BAAsB;;;;;;KAIxB,UAAI,CAAC,MAAM;uBADnB,oBAyDM,OAzDN,UAyDM;6BArDJ,oBAoDM,6BAnDiB,UAAI,GAAjB,GAAG,EAAE,GAAG;kCADlB,oBAoDM,SAlDH,GAAG,EAAE,GAAG;cAET,oBAaM,OAbN,UAaM;gBAZJ,oBAEO,QAFP,UAEO;kBADL,aAA+C,gBAA5C,CAAC,EAAC,uCAAuC;;;gBAE9C,oBAQO,QARP,UAQO;kBAPL,aAAoD,gBAAjD,CAAC,EAAC,4CAA4C;;kCACjD,oBAKE,KALF,UAKE;yDAJ2B,yBAAgB;qDACpB,yBAAgB;;;;;cAM7C,oBAiCM,OAjCN,UAiCM;gBAhCJ,oBAWM,OAXN,UAWM;mBAVQ,eAAM;qCAAlB,oBAEO,qCADF,GAAG,CAAC,IAAI;qDAEb,oBAME;;2DAJS,GAAG,CAAC,IAAI;wBACjB,IAAI,EAAC,MAAM;wBACV,WAAW,EAAEA,MAAC;wBACd,OAAK,0CAAE,6CAAW;;sCAHV,GAAG,CAAC,IAAI;;;;gBAMrB,oBAWM,OAXN,WAWM;mBAVQ,eAAM;qCAAlB,oBAEO,sCADF,GAAG,CAAC,SAAS;qDAElB,oBAME;;2DAJS,GAAG,CAAC,SAAS;wBACtB,IAAI,EAAC,MAAM;wBACV,WAAW,EAAEA,MAAC;wBACd,OAAK,0CAAE,6CAAW;;sCAHV,GAAG,CAAC,SAAS;;;;iBAOlB,mBAAU;mCADlB,oBAOS;;sBALP,IAAI,EAAC,QAAQ;sBACb,KAAK,EAAC,oBAAoB;sBACzB,OAAK,aAAE,eAAM,CAAC,GAAG;;sBAElB,aAAwB,gBAArB,CAAC,EAAC,gBAAgB;;;;;;;;;KAMrB,gBAAO;uBADf,oBAOS;;UALP,IAAI,EAAC,QAAQ;UACb,KAAK,EAAC,uBAAuB;UAC5B,OAAK,uCAAE,YAAG;;UAEX,aAAqB,gBAAlB,CAAC,EAAC,aAAa","sourcesContent":["<script>\nimport debounce from 'lodash/debounce';\nimport { _EDIT, _VIEW } from '@shell/config/query-params';\nimport { removeAt } from '@shell/utils/array';\nimport { Banner } from '@components/Banner';\nimport { DOC } from '../../config/doc-links';\nimport { docLink } from '../../utils/feature-flags';\n\nexport default {\n  name: 'StaticRoutes',\n\n  emits: ['update:value'],\n\n  components: { Banner },\n\n  props: {\n    value: {\n      type:    Array,\n      default: null,\n    },\n    mode: {\n      type:    String,\n      default: _EDIT,\n    },\n  },\n\n  data() {\n    const rows = (this.value || []).map((row) => {\n      return {\n        cidr:      row.cidr || '',\n        nextHopIP: row.nextHopIP || '',\n      };\n    });\n\n    return { rows };\n  },\n\n  computed: {\n    isView() {\n      return this.mode === _VIEW;\n    },\n\n    showAdd() {\n      return !this.isView;\n    },\n\n    showRemove() {\n      return !this.isView;\n    },\n    nextHopIPTooltip() {\n      return this.t('harvester.vpc.staticRoutes.nextHopIP.tooltip');\n    },\n\n    vpcPeeringExamplesLink() {\n      const version = this.$store.getters['harvester-common/getServerVersion']();\n\n      return docLink(DOC.VPC_CONFIGURATION_EXAMPLES, version);\n    },\n  },\n\n  created() {\n    this.queueUpdate = debounce(this.update, 100);\n  },\n\n  methods: {\n    add() {\n      this.rows.push({\n        cidr:      '',\n        nextHopIP: '',\n      });\n      this.queueUpdate();\n    },\n\n    remove(idx) {\n      removeAt(this.rows, idx);\n      this.queueUpdate();\n    },\n\n    update() {\n      if (this.isView) {\n        return;\n      }\n\n      this.$emit('update:value', this.rows);\n    }\n  },\n};\n</script>\n\n<template>\n  <div>\n    <Banner color=\"info\">\n      <t\n        k=\"harvester.vpc.vpcPeerings.infoBanner\"\n        :raw=\"true\"\n        :url=\"vpcPeeringExamplesLink\"\n      />\n    </Banner>\n    <div\n      v-if=\"rows.length\"\n      class=\"static-route-row\"\n    >\n      <div\n        v-for=\"(row, idx) in rows\"\n        :key=\"idx\"\n      >\n        <div class=\"pool-headers cidr\">\n          <span class=\"pool-cidr\">\n            <t k=\"harvester.vpc.staticRoutes.cidr.label\" />\n          </span>\n          <span class=\"pool-nextHopIP\">\n            <t k=\"harvester.vpc.staticRoutes.nextHopIP.label\" />\n            <i\n              v-clean-tooltip=\"{content: nextHopIPTooltip, triggers: ['hover', 'touch', 'focus'] }\"\n              v-stripped-aria-label=\"nextHopIPTooltip\"\n              class=\"icon icon-info\"\n              tabindex=\"0\"\n            />\n          </span>\n        </div>\n        <div class=\"pool-row cidr\">\n          <div class=\"pool-cidr\">\n            <span v-if=\"isView\">\n              {{ row.cidr }}\n            </span>\n            <input\n              v-else\n              v-model=\"row.cidr\"\n              type=\"text\"\n              :placeholder=\"t('harvester.vpc.staticRoutes.cidr.placeholder')\"\n              @input=\"queueUpdate\"\n            />\n          </div>\n          <div class=\"pool-nextHopIP\">\n            <span v-if=\"isView\">\n              {{ row.nextHopIP }}\n            </span>\n            <input\n              v-else\n              v-model=\"row.nextHopIP\"\n              type=\"text\"\n              :placeholder=\"t('harvester.vpc.staticRoutes.nextHopIP.placeholder')\"\n              @input=\"queueUpdate\"\n            />\n          </div>\n          <button\n            v-if=\"showRemove\"\n            type=\"button\"\n            class=\"btn role-link pl-0\"\n            @click=\"remove(idx)\"\n          >\n            <t k=\"generic.remove\" />\n          </button>\n        </div>\n      </div>\n    </div>\n    <button\n      v-if=\"showAdd\"\n      type=\"button\"\n      class=\"btn role-tertiary add\"\n      @click=\"add()\"\n    >\n      <t k=\"generic.add\" />\n    </button>\n  </div>\n</template>\n\n<style lang=\"scss\" scoped>\n  .pool-headers, .pool-row {\n    display: grid;\n    grid-column-gap: $column-gutter;\n    margin-bottom: 10px;\n    align-items: center;\n\n    &.cidr {\n      grid-template-columns: 40%+$column-gutter 40%+$column-gutter 15%;\n    }\n  }\n\n</style>\n"]}]}