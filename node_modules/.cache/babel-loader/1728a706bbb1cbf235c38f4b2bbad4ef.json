{"remainingRequest":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js??ruleSet[1].rules[4]!/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js??ruleSet[0].use[0]!/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js??ruleSet[0].use[1]!/home/ubuntu/essentials-ui-extension/node_modules/@rancher/shell/dialog/AddonConfigConfirmationDialog.vue?vue&type=template&id=d67f2c44&scoped=true","dependencies":[{"path":"/home/ubuntu/essentials-ui-extension/node_modules/@rancher/shell/dialog/AddonConfigConfirmationDialog.vue","mtime":1773205215283},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js","mtime":1773205228903},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js","mtime":1773205228903}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["/home/ubuntu/essentials-ui-extension/node_modules/@rancher/shell/dialog/AddonConfigConfirmationDialog.vue"],"names":["t"],"mappings":";;qBA4FU,KAAK,EAAC,mBAAmB;qBAkBxB,KAAK,EAAC,QAAQ;qBACZ,KAAK,EAAC,SAAS;;;;;;;wBAxB1B,aAuCO;IAtCL,KAAK,EAAC,gBAAgB;IACrB,uBAAqB,EAAE,KAAK;;IAElB,KAAK,WACd,CAEK;MAFL,oBAEK,MAFL,UAEK,mBADAA,MAAC;;IAIG,IAAI,WACb,CAQO;MARP,YAQO,yBARP,CAQO;wBAPL,oBAME;kCALcA,MAAC;oBAAuD,wBAAe;iCAAc,0BAAmB;4BAAc,qBAAc;;;;;IAS7I,OAAO,WAChB,CAcM;MAdN,oBAcM,OAdN,UAcM;QAbJ,oBAYM,OAZN,UAYM;UAXJ,oBAMS;YALP,IAAI,EAAC,QAAQ;YACb,KAAK,EAAC,0BAA0B;YAC/B,OAAK,0CAAE,yCAAK;8BAEVA,MAAC;;UAEN,aAGE;YAFA,IAAI,EAAC,UAAU;YACd,OAAK,EAAE,cAAK","sourcesContent":["<script>\nimport AsyncButton from '@shell/components/AsyncButton';\nimport { Card } from '@components/Card';\nimport { mapGetters } from 'vuex';\n\nimport { labelForAddon } from '@shell/utils/cluster';\nimport { resourceNames } from '@shell/utils/string';\n\nexport default {\n  emits: ['close'],\n\n  components: {\n    Card,\n    AsyncButton,\n  },\n  props: {\n    resources: {\n      type:     Array,\n      required: true\n    },\n    registerBackgroundClosing: {\n      type:     Function,\n      required: true\n    },\n    /**\n     * The names of the addons that have configuration conflicts.\n     */\n    addonNames: {\n      type:    Array,\n      default: () => []\n    },\n    /**\n     * The Kubernetes version the user is upgrading from.\n     */\n    previousKubeVersion: {\n      type:    String,\n      default: ''\n    },\n    /**\n     * The Kubernetes version the user is upgrading to.\n     */\n    newKubeVersion: {\n      type:    String,\n      default: ''\n    }\n  },\n  created() {\n    this.registerBackgroundClosing(this.closing);\n  },\n  computed: {\n    ...mapGetters({ t: 'i18n/t' }),\n\n    formattedAddons() {\n      if (!this.addonNames || this.addonNames.length === 0) {\n        return '';\n      }\n\n      const translatedNames = this.addonNames.map((name) => labelForAddon(this.$store, name, true));\n\n      return resourceNames(translatedNames, null, this.t, false);\n    }\n  },\n  methods: {\n    continue(value) {\n      if (this.resources[0]) {\n        this.resources[0](value);\n        delete this.resources[0];\n        this.$emit('close');\n      }\n    },\n\n    close() {\n      this.continue(false);\n    },\n\n    closing() {\n      this.continue(false);\n    },\n\n    apply(buttonDone) {\n      this.continue(true);\n    }\n  }\n};\n</script>\n\n<template>\n  <Card\n    class=\"prompt-restore\"\n    :show-highlight-border=\"false\"\n  >\n    <template #title>\n      <h4 class=\"text-default-text\">\n        {{ t('addonConfigConfirmation.title') }}\n      </h4>\n    </template>\n\n    <template #body>\n      <slot name=\"body\">\n        <span\n          v-clean-html=\"t('addonConfigConfirmation.body', {\n            addons: formattedAddons,\n            previousKubeVersion,\n            newKubeVersion\n          }, true)\"\n        />\n      </slot>\n    </template>\n\n    <template #actions>\n      <div class=\"bottom\">\n        <div class=\"buttons\">\n          <button\n            type=\"button\"\n            class=\"btn role-secondary mr-10\"\n            @click=\"close\"\n          >\n            {{ t('generic.cancel') }}\n          </button>\n          <AsyncButton\n            mode=\"continue\"\n            @click=\"apply\"\n          />\n        </div>\n      </div>\n    </template>\n  </Card>\n</template>\n<style lang='scss' scoped>\n.prompt-restore {\n  margin: 0;\n}\n\n.bottom {\n  display: flex;\n  flex-direction: column;\n  flex: 1;\n\n  .buttons {\n    display: flex;\n    justify-content: flex-end;\n    width: 100%;\n  }\n}\n</style>\n"]}]}