{"remainingRequest":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js??ruleSet[1].rules[4]!/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js??ruleSet[0].use[0]!/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js??ruleSet[0].use[1]!/home/ubuntu/essentials-ui-extension/pkg/harvester/edit/loadbalancer.harvesterhci.io.ippool/Selector.vue?vue&type=template&id=05988d92","dependencies":[{"path":"/home/ubuntu/essentials-ui-extension/pkg/harvester/edit/loadbalancer.harvesterhci.io.ippool/Selector.vue","mtime":1773206911368},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js","mtime":1773205228903},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js","mtime":1773205228903}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["/home/ubuntu/essentials-ui-extension/pkg/harvester/edit/loadbalancer.harvesterhci.io.ippool/Selector.vue"],"names":["queueUpdate","t"],"mappings":";;qBA0ES,KAAK,EAAC,WAAW;qBACf,KAAK,EAAC,YAAY;qBASlB,KAAK,EAAC,YAAY;;;;;;;wBAX3B,oBA4BM;IA3BJ,oBAoBM,OApBN,UAoBM;MAnBJ,oBAQM,OARN,UAQM;QAPJ,aAME;UALQ,KAAK,EAAE,cAAQ,CAAC,OAAO;;kDAAhB,cAAQ,CAAC,OAAO;YAIhBA,gBAAW;;UAHzB,KAAK,EAAEC,MAAC;UACR,OAAO,EAAE,uBAAc;UACvB,IAAI,EAAE,WAAI;;;;MAIf,oBASM,OATN,UASM;QARJ,aAOE;UANQ,KAAK,EAAS,cAAQ,CAAC,QAAQ;;kDAAjB,cAAQ,CAAC,QAAQ;YAKxB,eAAM;;0BALrB,gBAAwC;UACvC,KAAK,EAAEA,MAAC;UACR,IAAI,EAAE,WAAI;UACX,IAAI,EAAC,QAAQ;UACb,GAAG,EAAC,GAAG;;;;;IAKb,aAKE;MAJQ,KAAK,EAAE,cAAQ,CAAC,KAAK;;8CAAd,cAAQ,CAAC,KAAK;QAGd,eAAM;;MAFrB,KAAK,EAAC,aAAa;MAClB,IAAI,EAAE,WAAI","sourcesContent":["<script>\nimport debounce from 'lodash/debounce';\n\nimport LabeledSelect from '@shell/components/form/LabeledSelect';\nimport { LabeledInput } from '@components/Form/LabeledInput';\n\nimport { NETWORK_ATTACHMENT } from '@shell/config/types';\nimport { _EDIT } from '@shell/config/query-params';\nimport Priority from './Priority';\n\nexport default {\n  emits: ['update:value'],\n\n  components: {\n    LabeledSelect,\n    LabeledInput,\n    Priority,\n  },\n\n  props: {\n    value: {\n      type:    Object,\n      default: () => {\n        return {};\n      },\n    },\n    mode: {\n      type:    String,\n      default: _EDIT,\n    },\n  },\n\n  data() {\n    const selector = this.value || {\n      network:  '',\n      priority: 0,\n      scope:    [],\n    };\n\n    return { selector };\n  },\n\n  computed: {\n    networkOptions() {\n      const networks = this.$store.getters['harvester/all'](NETWORK_ATTACHMENT) || [];\n\n      return [{\n        label: this.t('generic.none'),\n        value: '',\n      }, ...networks.map((n) => ({\n        label: n.id,\n        value: n.id,\n      }))];\n    },\n  },\n\n  created() {\n    this.queueUpdate = debounce(this.update, 500);\n  },\n\n  methods: {\n    update() {\n      if ( this.isView ) {\n        return;\n      }\n\n      this.$emit('update:value', this.selector);\n    }\n  },\n};\n</script>\n\n<template>\n  <div>\n    <div class=\"row mb-20\">\n      <div class=\"col span-6\">\n        <LabeledSelect\n          v-model:value=\"selector.network\"\n          :label=\"t('harvester.ipPool.network.label')\"\n          :options=\"networkOptions\"\n          :mode=\"mode\"\n          @update:value=\"queueUpdate\"\n        />\n      </div>\n      <div class=\"col span-6\">\n        <LabeledInput\n          v-model:value.number=\"selector.priority\"\n          :label=\"t('harvester.ipPool.priority.label')\"\n          :mode=\"mode\"\n          type=\"number\"\n          min=\"0\"\n          @update:value=\"update\"\n        />\n      </div>\n    </div>\n    <Priority\n      v-model:value=\"selector.scope\"\n      class=\"col span-12\"\n      :mode=\"mode\"\n      @update:value=\"update\"\n    />\n  </div>\n</template>\n"]}]}