{"remainingRequest":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js??ruleSet[1].rules[4]!/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js??ruleSet[0].use[0]!/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js??ruleSet[0].use[1]!/home/ubuntu/essentials-ui-extension/pkg/harvester/dialog/HarvesterHotUnplug.vue?vue&type=template&id=0c324c0b&scoped=true","dependencies":[{"path":"/home/ubuntu/essentials-ui-extension/pkg/harvester/dialog/HarvesterHotUnplug.vue","mtime":1773208598734},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js","mtime":1773205228903},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js","mtime":1773205228903}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["/home/ubuntu/essentials-ui-extension/pkg/harvester/dialog/HarvesterHotUnplug.vue"],"names":["t"],"mappings":";;qBAgHQ,KAAK,EAAC,mBAAmB;qBAWtB,KAAK,EAAC,SAAS;qBACb,KAAK,EAAC,SAAS;;;;;;;;wBApB1B,aAuCO;IAtCL,GAAG,EAAC,OAAO;IACX,IAAI,EAAC,OAAO;IACX,uBAAqB,EAAE,KAAK;;IAElB,KAAK,WACd,CAGE;sBAHF,oBAGE,MAHF,UAGE;gCAFcA,MAAC,CAAC,iBAAQ,UAAI,aAAI;;;yBAGlC,oBAKE,6BAJmB,YAAM,GAAjB,GAAG,EAAE,CAAC;8BADhB,aAKE;UAHC,GAAG,EAAE,CAAC;UACP,KAAK,EAAC,OAAO;UACZ,KAAK,EAAE,GAAG;;;;IAIJ,OAAO,WAChB,CAkBM;MAlBN,oBAkBM,OAlBN,UAkBM;QAjBJ,oBAgBM,OAhBN,UAgBM;UAfJ,oBAMS;YALP,IAAI,EAAC,QAAQ;YACb,KAAK,EAAC,0BAA0B;YAC/B,OAAK,0CAAE,yCAAK;8BAEVA,MAAC;;UAGN,aAME;YALA,IAAI,EAAC,OAAO;YACX,cAAY,EAAEA,MAAC,CAAC,uBAAc;YAC9B,eAAa,EAAEA,MAAC,CAAC,uBAAc;YAC/B,eAAa,EAAEA,MAAC,CAAC,uBAAc;YAC/B,OAAK,EAAE,aAAI","sourcesContent":["<script>\nimport { mapState, mapGetters } from 'vuex';\nimport { exceptionToErrorsArray } from '@shell/utils/error';\nimport { Card } from '@components/Card';\nimport { Banner } from '@components/Banner';\nimport AsyncButton from '@shell/components/AsyncButton';\n\nexport default {\n  name: 'HarvesterHotUnplug',\n\n  emits: ['close'],\n\n  components: {\n    AsyncButton,\n    Card,\n    Banner\n  },\n\n  props: {\n    resources: {\n      type:     Array,\n      required: true\n    }\n  },\n\n  data() {\n    return { errors: [] };\n  },\n\n  computed: {\n    ...mapState('action-menu', ['modalData']),\n    ...mapGetters({ t: 'i18n/t' }),\n\n    actionResource() {\n      return this.resources[0];\n    },\n\n    name() {\n      return this.modalData.name;\n    },\n\n    isVolume() {\n      return this.modalData.type === 'volume';\n    },\n\n    titleKey() {\n      return this.isVolume ? 'harvester.virtualMachine.hotUnplug.detachVolume.title' : 'harvester.virtualMachine.hotUnplug.detachNIC.title';\n    },\n\n    actionLabelKey() {\n      return this.isVolume ? 'harvester.virtualMachine.hotUnplug.detachVolume.actionLabel' : 'harvester.virtualMachine.hotUnplug.detachNIC.actionLabel';\n    },\n\n    successMessageKey() {\n      return this.isVolume ? 'harvester.virtualMachine.hotUnplug.detachVolume.success' : 'harvester.virtualMachine.hotUnplug.detachNIC.success';\n    }\n  },\n\n  methods: {\n    close() {\n      this.$emit('close');\n    },\n\n    async save(buttonCb) {\n      try {\n        let res;\n\n        if (this.isVolume) {\n          res = await this.actionResource.doAction('removeVolume', { diskName: this.name });\n        } else {\n          res = await this.actionResource.doAction('removeNic', { interfaceName: this.name });\n        }\n\n        if (res._status === 200 || res._status === 204) {\n          this.$store.dispatch(\n            'growl/success',\n            {\n              title:   this.t('generic.notification.title.succeed'),\n              message: this.t(this.successMessageKey, { name: this.name })\n            },\n            { root: true }\n          );\n\n          this.close();\n          buttonCb(true);\n        } else {\n          const error = [res?.data] || exceptionToErrorsArray(res);\n\n          this.errors = error;\n          buttonCb(false);\n        }\n      } catch (err) {\n        const error = err?.data || err;\n        const message = exceptionToErrorsArray(error);\n\n        this.errors = message;\n        buttonCb(false);\n      }\n    }\n  }\n};\n</script>\n\n<template>\n  <Card\n    ref=\"modal\"\n    name=\"modal\"\n    :show-highlight-border=\"false\"\n  >\n    <template #title>\n      <h4\n        v-clean-html=\"t(titleKey, { name })\"\n        class=\"text-default-text\"\n      />\n      <Banner\n        v-for=\"(err, i) in errors\"\n        :key=\"i\"\n        color=\"error\"\n        :label=\"err\"\n      />\n    </template>\n\n    <template #actions>\n      <div class=\"actions\">\n        <div class=\"buttons\">\n          <button\n            type=\"button\"\n            class=\"btn role-secondary mr-10\"\n            @click=\"close\"\n          >\n            {{ t('generic.cancel') }}\n          </button>\n\n          <AsyncButton\n            mode=\"apply\"\n            :action-label=\"t(actionLabelKey)\"\n            :waiting-label=\"t(actionLabelKey)\"\n            :success-label=\"t(actionLabelKey)\"\n            @click=\"save\"\n          />\n        </div>\n      </div>\n    </template>\n  </Card>\n</template>\n\n<style lang=\"scss\" scoped>\n.actions {\n  width: 100%;\n}\n\n.buttons {\n  display: flex;\n  justify-content: flex-end;\n  width: 100%;\n}\n\n::v-deep(.card-title) {\n  display: block;\n}\n</style>\n"]}]}