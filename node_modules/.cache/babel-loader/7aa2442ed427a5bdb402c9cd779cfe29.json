{"remainingRequest":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js??ruleSet[1].rules[4]!/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js??ruleSet[0].use[0]!/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js??ruleSet[0].use[1]!/home/ubuntu/essentials-ui-extension/node_modules/@rancher/shell/components/ResourceSummary.vue?vue&type=template&id=77d9ce05&scoped=true","dependencies":[{"path":"/home/ubuntu/essentials-ui-extension/node_modules/@rancher/shell/components/ResourceSummary.vue","mtime":1778042288906},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js","mtime":1773205228903},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js","mtime":1773205228903}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["/home/ubuntu/essentials-ui-extension/node_modules/@rancher/shell/components/ResourceSummary.vue"],"names":[],"mappings":";;qBAmHW,KAAK,EAAC,MAAM;qBAIZ,KAAK,EAAC,MAAM;qBAKZ,KAAK,EAAC,QAAQ;;;EACwB,KAAK,EAAC,MAAM;;;;EAGd,KAAK,EAAC,OAAO;;;;wBAnB1D,oBAwBM;IAvBJ,oBAsBM;MArBJ,KAAK,mBAAC,aAAa,iBACI,iBAAQ;MAC9B,OAAK,0CAAE,uDAAY;;MAEpB,oBAEI,OAFJ,UAEI;QADJ,oBAAqD,+BAA5C,aAAI,CAAC,SAAS,OAAO,WAAW;;;MAGzC,oBAGM,OAHN,UAGM;QAFJ,oBAAmC,6BAA5B,uBAAc,CAAC,KAAK;;QAC3B,oBAAiB,4BAAX,aAAI;;;MAGZ,oBAOM,OAPN,UAOM;SANQ,uBAAc,CAAC,YAAY;2BAAvC,oBAEO,QAFP,UAEO,mBADF,uBAAc,CAAC,YAAY;;;SAEpB,uBAAc,CAAC,UAAU;2BAArC,oBAEO,QAFP,UAEO,mBADF,uBAAc,CAAC,UAAU","sourcesContent":["<script>\nimport { COUNT } from '@shell/config/types';\nimport { colorForState } from '@shell/plugins/dashboard-store/resource-class';\n\nexport function colorToCountName(color) {\n  switch (color) {\n  case 'text-success':\n  case 'text-info':\n    return 'useful';\n  case 'text-warning':\n    return 'warningCount';\n  default:\n    return 'errorCount';\n  }\n}\n\nexport function resourceCounts(store, resource) {\n  const inStore = store.getters['currentStore'](COUNT);\n  const clusterCounts = store.getters[`${ inStore }/all`](COUNT)?.[0]?.counts;\n  const summary = clusterCounts?.[resource]?.summary || {};\n\n  const counts = {\n    total:        summary.count || 0,\n    useful:       summary.count || 0,\n    warningCount: 0,\n    errorCount:   0\n  };\n\n  Object.entries(summary.states || {}).forEach((entry) => {\n    const color = colorForState(entry[0]);\n    const count = entry[1];\n    const countName = colorToCountName(color);\n\n    counts['useful'] -= count;\n    counts[countName] += count;\n  });\n\n  return counts;\n}\n\nexport default {\n  props: {\n    resource: {\n      type:    String,\n      default: ''\n    },\n\n    spoofedCounts: {\n      type:    Object,\n      default: null\n    },\n\n    cluster: {\n      type:    String,\n      default: null,\n    },\n  },\n\n  computed: {\n    resourceCounts() {\n      if (this.spoofedCounts) {\n        return this.spoofedCounts;\n      }\n\n      return resourceCounts(this.$store, this.resource);\n    },\n\n    location() {\n      if (this.spoofedCounts) {\n        return this.spoofedCounts.location;\n      }\n\n      const route = {\n        name:   'c-cluster-product-resource',\n        params: {\n          product:  this.$store.getters['currentProduct'].name,\n          resource: this.resource,\n        }\n      };\n\n      if (this.cluster) {\n        route.params.cluster = this.cluster;\n      }\n\n      return route;\n    },\n\n    name() {\n      if (this.spoofedCounts) {\n        return this.spoofedCounts.name;\n      }\n      const inStore = this.$store.getters['currentStore'](this.resource);\n      const schema = this.$store.getters[`${ inStore }/schemaFor`](this.resource);\n\n      return this.$store.getters['type-map/labelFor'](schema, this.resourceCounts.useful);\n    },\n  },\n\n  methods: {\n    goToResource() {\n      if (this.location) {\n        this.$router.push(this.location);\n      }\n    },\n  }\n};\n</script>\n\n<template>\n  <div>\n    <div\n      class=\"modern-card\"\n      :class=\"{ clickable: !!location }\"\n      @click=\"goToResource\"\n    >\n      <div class=\"icon\">\n      <span>{{ name.substring(0, 2).toUpperCase() }}</span>\n    </div>\n\n      <div class=\"info\">\n        <h2>{{ resourceCounts.total }}</h2>\n        <p>{{ name }}</p>\n      </div>\n\n      <div class=\"status\">\n        <span v-if=\"resourceCounts.warningCount\" class=\"warn\">\n          {{ resourceCounts.warningCount }}\n        </span>\n        <span v-if=\"resourceCounts.errorCount\" class=\"error\">\n          {{ resourceCounts.errorCount }}\n        </span>\n      </div>\n    </div>\n  </div>\n</template>\n\n<style lang='scss' scoped>\n.modern-card {\n  display: flex;\n  align-items: center;\n  gap: 14px;\n  padding: 18px;\n  border-radius: 14px;\n  background: #ffffff;\n  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.1);\n  transition: all 0.2s ease;\n  position: relative;\n  min-height: 72px;\n\n  &:hover {\n    transform: translateY(-3px);\n    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.08);\n  }\n\n  &.clickable {\n    cursor: pointer;\n  }\n\n  .icon {\n    width: 42px;\n    height: 42px;\n\n    display: flex;\n    align-items: center;\n    justify-content: center;\n\n    background: rgba(59, 130, 246, 0.12);\n    border-radius: 10px;\n\n    flex-shrink: 0;\n  }\n\n  .icon span {\n    font-size: 12px !important;\n    font-weight: 700 !important;\n    color: #2563eb !important;\n    line-height: 1 !important;\n    opacity: 0.6;\n    display: block !important;\n  }\n\n  .info {\n    flex: 1;\n\n    h2 {\n      margin: 0;\n      font-size: 20px;\n      font-weight: 600;\n      color: #111827;\n    }\n\n    p {\n      margin: 0;\n      font-size: 16px;\n      color: #6b7280;\n    }\n  }\n\n  .status {\n    display: flex;\n    gap: 6px;\n\n    span {\n      font-size: 11px;\n      padding: 3px 8px;\n      border-radius: 999px;\n      color: white;\n    }\n\n    .warn {\n      background: #f59e0b;\n    }\n\n    .error {\n      background: #ef4444;\n    }\n  }\n}\n</style>"]}]}