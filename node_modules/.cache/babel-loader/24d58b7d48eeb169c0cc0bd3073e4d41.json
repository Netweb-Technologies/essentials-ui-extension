{"remainingRequest":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js??ruleSet[1].rules[4]!/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js??ruleSet[0].use[0]!/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js??ruleSet[0].use[1]!/home/ubuntu/essentials-ui-extension/pkg/harvester/components/novnc/NovncConsole.vue?vue&type=template&id=8bb5c49e&scoped=true","dependencies":[{"path":"/home/ubuntu/essentials-ui-extension/pkg/harvester/components/novnc/NovncConsole.vue","mtime":1773206911346},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js","mtime":1773205228903},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js","mtime":1773205228903}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["/home/ubuntu/essentials-ui-extension/pkg/harvester/components/novnc/NovncConsole.vue"],"names":["t"],"mappings":";;;qBAGY,KAAK,EAAC,mBAAmB;qBACxB,KAAK,EAAC,aAAa;qBASlB,KAAK,EAAC,sBAAsB;;qBAO9B,KAAK,EAAC,aAAa;qBAClB,KAAK,EAAC,aAAa;qBAClB,KAAK,EAAC,sBAAsB;qBAOpC,GAAG,EAAC,MAAM;;;;;wBA5Bd,oBA8BM;KA7BO,eAAS,IAAI,kBAAY;uBAApC,oBAgBM;UAfJ,oBAcO,QAdP,UAcO;YAbL,oBAYM,OAZN,UAYM;cAXJ,aAIE;gBAHA,WAAS,EAAC,4BAA4B;gBACtC,KAAK,EAAC,KAAK;gBACX,MAAM,EAAC,KAAK;;;cAEd,oBAEK,6BADAA,MAAC;;cAEN,oBAEK,MAFL,UAEK,mBADAA,MAAC;;;;;;KAKD,kBAAY;uBAAvB,oBAQM;UAPJ,oBAMO,QANP,UAMO;YALL,oBAIM,OAJN,UAIM;cAHJ,oBAEK,MAFL,UAEK,mBADAA,MAAC,uCAAsC,GAAC,oBAAG,gBAAU,IAAG,MAAI,oBAAG,uBAAiB;;;;;;IAK3F,oBAEE,OAFF,UAEE","sourcesContent":["<template>\n  <div>\n    <div v-if=\"connected && disconnected\">\n      <main class=\"main-layout error\">\n        <div class=\"text-center\">\n          <BrandImage\n            file-name=\"error-desert-landscape.svg\"\n            width=\"900\"\n            height=\"300\"\n          />\n          <h1>\n            {{ t('generic.notification.title.warning') }}\n          </h1>\n          <h2 class=\"text-secondary mt-20\">\n            {{ t('vncConsole.error.message') }}\n          </h2>\n        </div>\n      </main>\n    </div>\n    <div v-if=\"reconnecting\">\n      <main class=\"main-layout\">\n        <div class=\"text-center\">\n          <h2 class=\"text-secondary mt-20\">\n            {{ t('vncConsole.reconnecting.message') }}：{{ retryTimes }} of {{ maximumRetryTimes }}\n          </h2>\n        </div>\n      </main>\n    </div>\n    <div\n      ref=\"view\"\n    />\n  </div>\n</template>\n\n<script>\nimport RFB from '@novnc/novnc/core/rfb';\nimport BrandImage from '@shell/components/BrandImage';\n\nexport default {\n  props: {\n    url: {\n      type:    String,\n      default: ''\n    }\n  },\n\n  components: { BrandImage },\n\n  data() {\n    return {\n      rfb:               null,\n      connected:         false,\n      disconnected:      false,\n      reconnectDelay:    3000,\n      reconnecting:      false,\n      maximumRetryTimes: 10,\n      retryTimes:        0,\n      setTimeout:        null,\n    };\n  },\n\n  mounted() {\n    this.$nextTick(() => {\n      this.connect();\n    });\n  },\n\n  beforeUnmount() {\n    this.clearTimeout();\n  },\n\n  methods: {\n    connect() {\n      const rfb = new RFB(this.$refs.view, this.url);\n\n      rfb.addEventListener('connect', () => {\n        this.clearTimeout();\n\n        this.connected = true;\n        this.retryTimes = 0;\n        this.reconnecting = false;\n      });\n\n      rfb.addEventListener('disconnect', (e) => {\n        this.clearTimeout();\n\n        this.disconnected = true;\n        this.rfb = null;\n        this.reconnect();\n      });\n\n      this.rfb = rfb;\n    },\n\n    reconnect() {\n      if (this.retryTimes >= this.maximumRetryTimes) {\n        this.reconnecting = false;\n        this.connected = true;\n        this.disconnected = true;\n\n        return;\n      }\n\n      this.retryTimes += 1;\n      this.reconnecting = true;\n      this.connected = false;\n      this.disconnected = false;\n\n      this.setTimeout = setTimeout(() => {\n        this.connect();\n      }, this.reconnectDelay);\n    },\n\n    clearTimeout() {\n      if (this.setTimeout) {\n        clearTimeout(this.setTimeout);\n      }\n    },\n\n    disconnect() {\n      this.rfb.disconnect();\n    },\n\n    ctrlAltDelete() {\n      this.rfb.sendCtrlAltDel();\n    },\n\n    sendKey(keysym, code, down) {\n      this.rfb.sendKey(keysym, code, down);\n    }\n  }\n};\n</script>\n\n<style lang=\"scss\" scoped>\n  .error {\n    overflow: hidden;\n\n    .row {\n      align-items: center;\n    }\n\n    h1 {\n      font-size: 5rem;\n    }\n\n    .desert-landscape {\n      img {\n        max-width: 100%;\n      }\n    }\n  }\n</style>\n"]}]}