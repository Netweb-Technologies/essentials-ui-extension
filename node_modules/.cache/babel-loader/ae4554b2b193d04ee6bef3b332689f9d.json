{"remainingRequest":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js??ruleSet[1].rules[4]!/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js??ruleSet[0].use[0]!/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js??ruleSet[0].use[1]!/home/ubuntu/essentials-ui-extension/pkg/harvester/dialog/HarvesterCloneTemplate.vue?vue&type=template&id=000bfca4&scoped=true","dependencies":[{"path":"/home/ubuntu/essentials-ui-extension/pkg/harvester/dialog/HarvesterCloneTemplate.vue","mtime":1773206911357},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js","mtime":1773205228903},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js","mtime":1773205228903}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["/home/ubuntu/essentials-ui-extension/pkg/harvester/dialog/HarvesterCloneTemplate.vue"],"names":["t"],"mappings":";;qBAmIW,KAAK,EAAC,SAAS;qBACb,KAAK,EAAC,SAAS;;;;;;;;;wBAjC1B,aAiDO,mBAjDA,uBAAqB,EAAE,KAAK;IACtB,KAAK,WACd,CAA+C;wCAA5CA,MAAC;;IAGK,IAAI,WACb,CAIE;MAJF,aAIE;QAHQ,KAAK,EAAE,cAAQ;gEAAR,cAAQ;QACvB,KAAK,EAAC,OAAO;QACb,KAAK,EAAC,WAAW;;;MAGnB,aAKE;QAJQ,KAAK,EAAE,kBAAY;gEAAZ,kBAAY;QAC3B,KAAK,EAAC,OAAO;QACZ,KAAK,EAAEA,MAAC;QACT,QAAQ,EAAR,EAAQ;;;MAGV,aAGE;QAFQ,KAAK,EAAE,iBAAW;gEAAX,iBAAW;QACzB,KAAK,EAAEA,MAAC;;;yBAEX,oBAKE,6BAJmB,YAAM,GAAjB,GAAG,EAAE,CAAC;8BADhB,aAKE;UAHC,GAAG,EAAE,CAAC;UACP,KAAK,EAAC,OAAO;UACZ,KAAK,EAAE,GAAG;;;;IAIJ,OAAO,WAChB,CAeM;MAfN,oBAeM,OAfN,UAeM;QAdJ,oBAaM,OAbN,UAaM;UAZJ,oBAKS;YAJP,KAAK,EAAC,0BAA0B;YAC/B,OAAK,0CAAE,yCAAK;8BAEVA,MAAC;;UAGN,aAIE;YAHA,IAAI,EAAC,QAAQ;YACZ,QAAQ,GAAG,kBAAY;YACvB,OAAK,EAAE,aAAI","sourcesContent":["<script>\nimport { exceptionToErrorsArray } from '@shell/utils/error';\nimport { mapGetters } from 'vuex';\n\nimport { Card } from '@components/Card';\nimport { Banner } from '@components/Banner';\nimport { Checkbox } from '@components/Form/Checkbox';\nimport AsyncButton from '@shell/components/AsyncButton';\nimport { LabeledInput } from '@components/Form/LabeledInput';\n\nexport default {\n  name: 'HarvesterCloneTemplateModal',\n\n  emits: ['close'],\n\n  components: {\n    AsyncButton,\n    Banner,\n    Card,\n    Checkbox,\n    LabeledInput\n  },\n\n  props: {\n    resources: {\n      type:     Array,\n      required: true\n    }\n  },\n\n  data() {\n    return {\n      templateName: '',\n      description:  '',\n      withData:     false,\n      errors:       []\n    };\n  },\n\n  computed: {\n    ...mapGetters({ t: 'i18n/t' }),\n\n    actionResource() {\n      return this.resources[0];\n    }\n  },\n\n  methods: {\n    close() {\n      this.templateName = '';\n      this.description = '';\n      this.$emit('close');\n    },\n\n    async save(buttonCb) {\n      try {\n        const res = await this.actionResource.doAction(\n          'createTemplate',\n          {\n            name: this.templateName, description: this.description, withData: this.withData\n          },\n          {},\n          false\n        );\n\n        if (res._status === 200 || res._status === 204) {\n          this.$store.dispatch(\n            'growl/success',\n            {\n              title:   this.t('generic.notification.title.succeed'),\n              message: this.t(\n                'harvester.modal.createTemplate.message.success',\n                { templateName: this.templateName }\n              )\n            },\n            { root: true }\n          );\n\n          this.close();\n          buttonCb(true);\n        } else {\n          const error = [res?.data] || exceptionToErrorsArray(res);\n\n          this['errors'] = error;\n          buttonCb(false);\n        }\n      } catch (err) {\n        const error = err?.data || err;\n        const message = exceptionToErrorsArray(error);\n\n        this['errors'] = message;\n        buttonCb(false);\n      }\n    }\n  }\n};\n</script>\n\n<template>\n  <Card :show-highlight-border=\"false\">\n    <template #title>\n      {{ t('harvester.modal.createTemplate.title') }}\n    </template>\n\n    <template #body>\n      <Checkbox\n        v-model:value=\"withData\"\n        class=\"mb-10\"\n        label=\"With Data\"\n      />\n\n      <LabeledInput\n        v-model:value=\"templateName\"\n        class=\"mb-20\"\n        :label=\"t('harvester.modal.createTemplate.name')\"\n        required\n      />\n\n      <LabeledInput\n        v-model:value=\"description\"\n        :label=\"t('harvester.modal.createTemplate.description')\"\n      />\n      <Banner\n        v-for=\"(err, i) in errors\"\n        :key=\"i\"\n        color=\"error\"\n        :label=\"err\"\n      />\n    </template>\n\n    <template #actions>\n      <div class=\"actions\">\n        <div class=\"buttons\">\n          <button\n            class=\"btn role-secondary mr-10\"\n            @click=\"close\"\n          >\n            {{ t('generic.cancel') }}\n          </button>\n\n          <AsyncButton\n            mode=\"create\"\n            :disabled=\"!templateName\"\n            @click=\"save\"\n          />\n        </div>\n      </div>\n    </template>\n  </Card>\n</template>\n\n<style lang=\"scss\" scoped>\n.actions {\n  width: 100%;\n}\n\n.buttons {\n  display: flex;\n  justify-content: flex-end;\n  width: 100%;\n}\n</style>\n"]}]}