{"remainingRequest":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js??ruleSet[1].rules[4]!/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js??ruleSet[0].use[0]!/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js??ruleSet[0].use[1]!/home/ubuntu/essentials-ui-extension/pkg/harvester/promptRemove/kubevirt.io.virtualmachine.vue?vue&type=template&id=2f1d6325","dependencies":[{"path":"/home/ubuntu/essentials-ui-extension/pkg/harvester/promptRemove/kubevirt.io.virtualmachine.vue","mtime":1773206911378},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js","mtime":1773205228903},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js","mtime":1773205228903}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["/home/ubuntu/essentials-ui-extension/pkg/harvester/promptRemove/kubevirt.io.virtualmachine.vue"],"names":["t"],"mappings":";;qBAuIS,KAAK,EAAC,OAAO;qBAIX,KAAK,EAAC,OAAO;;qBAQP,KAAK,EAAC,0BAA0B;;;qBAgBlC,KAAK,EAAC,0BAA0B;qBAatC,KAAK,EAAC,0BAA0B;qBAGhC,KAAK,EAAC,iBAAiB;;;;;wBA7C9B,oBAgDM;IA/CJ,oBAwCM,OAxCN,UAwCM;wCAvCDA,MAAC,2CAAqC,WAAI,MAAK,GAClD;sBAAA,oBAA0D;gCAAtC,sBAAa,CAAC,YAAK,QAAQA,MAAC;;;MAEhD,oBAEM,OAFN,UAEM,mBADDA,MAAC;;OAEK,YAAK,CAAC,MAAM;yBAAvB,oBAmBM;+BAlBJ,oBAiBO,6BAhBe,sBAAa,CAAC,YAAK,IAAI,EAAE,IAArC,IAAI,EAAE,CAAC;oCADjB,oBAiBO,UAfJ,GAAG,EAAE,CAAC;gBAEP,oBAYQ,SAZR,UAYQ;kCAXN,oBAKE;iFAJS,iBAAW;oBACpB,IAAI,EAAC,UAAU;oBACd,KAAK,EAAE,IAAI;oBACX,KAAK,EAAE,IAAI;;sCAHH,iBAAW;;;4CAKtB,oBAGE;oBAFA,KAAK,EAAC,sBAAsB;oBAC5B,IAAI,EAAC,UAAU;;mCACf,GACF,oBAAG,IAAI;;;;;yBAIb,oBAYM;YAXJ,oBAUQ,SAVR,UAUQ;8BATN,oBAGE;6EAFS,iBAAW;gBACpB,IAAI,EAAC,UAAU;;kCADN,iBAAW;;;wCAGtB,oBAGE;gBAFA,KAAK,EAAC,sBAAsB;gBAC5B,IAAI,EAAC,UAAU;;+BACf,GACF,oBAAGA,MAAC;;;;;IAIV,oBAEM,OAFN,UAEM,mBADDA,MAAC;;IAEN,oBAEM,OAFN,UAEM,mBADDA,MAAC,0CAA0B,oBAAc","sourcesContent":["<script>\nimport { mapState, mapGetters } from 'vuex';\nimport { isEmpty } from '@shell/utils/object';\nimport Parse from 'url-parse';\nimport { resourceNames } from '@shell/utils/string';\nimport { HCI } from '../types';\nimport { alternateLabel as alternateLabelButton } from '@shell/utils/platform';\n\nexport default {\n  name: 'HarvesterPromptRemove',\n\n  props: {\n    value: {\n      type:    Array,\n      default: () => {\n        return [];\n      }\n    },\n    names: {\n      type:    Array,\n      default: () => {\n        return [];\n      }\n    },\n    type: {\n      type:     String,\n      required: true\n    },\n    close: {\n      type:     Function,\n      required: true\n    },\n    doneLocation: {\n      type:    Object,\n      default: () => {}\n    }\n  },\n\n  data() {\n    return {\n      checkedList:    [],\n      checkAll:       true,\n      alternateLabel: alternateLabelButton\n    };\n  },\n\n  computed: {\n    ...mapState('action-menu', ['toRemove']),\n    ...mapGetters({ t: 'i18n/t' }),\n\n    removeNameArr() {\n      const out = {};\n\n      this.value.forEach((crd) => {\n        if (crd.type !== HCI.VM) {\n          return;\n        }\n        const volumes = crd.spec.template.spec?.volumes || [];\n        const names = volumes.filter((volume) => volume.persistentVolumeClaim ).map((volume) => {\n          if (volume.persistentVolumeClaim) {\n            return volume.name;\n          }\n        });\n\n        out[crd.id] = names;\n      });\n\n      return out;\n    },\n  },\n\n  watch: {\n    removeNameArr: {\n      handler(neu) {\n        if (this.value.length === 1) {\n          const keys = Object.values(neu[this.value[0].id]);\n\n          this.checkedList.unshift(keys[0]);\n        }\n      },\n      deep:      true,\n      immediate: true\n    }\n  },\n\n  methods: {\n    resourceNames,\n    remove() {\n      let goTo;\n\n      if (this.doneLocation) {\n        // doneLocation will recompute to undefined when delete request completes\n        goTo = { ...this.doneLocation };\n      }\n\n      Promise.all(this.value.map((resource) => {\n        if (resource.type !== HCI.VM) { // maybe is VMI\n          resource.remove();\n\n          return;\n        }\n\n        let removedDisks = '';\n\n        if (this.value.length > 1) {\n          if (this.checkAll) {\n            this.removeNameArr[resource.id].forEach((item) => {\n              removedDisks += `removedDisks=${ item }&`;\n            });\n          }\n        } else {\n          this.checkedList.forEach((item) => {\n            removedDisks += `removedDisks=${ item }&`;\n          });\n          removedDisks.replace(/&$/, '');\n        }\n\n        const parsed = Parse(resource.links.self);\n\n        resource.remove({ url: `${ parsed.pathname }?${ removedDisks }propagationPolicy=Foreground` });\n      })).then((_results) => {\n        if ( goTo && !isEmpty(goTo) ) {\n          this.value?.[0]?.currentRouter().push(goTo);\n        }\n        this.close();\n      }).catch((err) => {\n        this.$emit('errors', err);\n      });\n    }\n  }\n};\n</script>\n\n<template>\n  <div>\n    <div class=\"mt-10\">\n      {{ t('promptRemove.attemptingToRemove', {type}) }}\n      <span v-clean-html=\"resourceNames(names, null, t)\"></span>\n\n      <div class=\"mt-10\">\n        {{ t('harvester.virtualMachine.promptRemove.title') }}\n      </div>\n      <div v-if=\"value.length === 1\">\n        <span\n          v-for=\"(name, i) in removeNameArr[value[0].id]\"\n          :key=\"i\"\n        >\n          <label class=\"checkbox-container mr-15\">\n            <input\n              v-model=\"checkedList\"\n              type=\"checkbox\"\n              :label=\"name\"\n              :value=\"name\"\n            />\n            <span\n              class=\"checkbox-custom mr-5\"\n              role=\"checkbox\"\n            />\n            {{ name }}\n          </label>\n        </span>\n      </div>\n      <div v-else>\n        <label class=\"checkbox-container mr-15\">\n          <input\n            v-model=\"checkedList\"\n            type=\"checkbox\"\n          />\n          <span\n            class=\"checkbox-custom mr-5\"\n            role=\"checkbox\"\n          />\n          {{ t('harvester.virtualMachine.promptRemove.deleteAll') }}\n        </label>\n      </div>\n    </div>\n    <div class=\"text-warning mb-10 mt-10\">\n      {{ t('harvester.virtualMachine.promptRemove.tips') }}\n    </div>\n    <div class=\"text-info mt-20\">\n      {{ t('promptRemove.protip', { alternateLabel }) }}\n    </div>\n  </div>\n</template>\n"]}]}