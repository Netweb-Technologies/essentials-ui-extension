{"remainingRequest":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js??ruleSet[1].rules[4]!/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js??ruleSet[0].use[0]!/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js??ruleSet[0].use[1]!/home/ubuntu/essentials-ui-extension/pkg/harvester/detail/harvesterhci.io.host/VlanStatus/index.vue?vue&type=template&id=028d56d9","dependencies":[{"path":"/home/ubuntu/essentials-ui-extension/pkg/harvester/detail/harvesterhci.io.host/VlanStatus/index.vue","mtime":1773206911352},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js","mtime":1773205228903},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js","mtime":1773205228903}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["/home/ubuntu/essentials-ui-extension/pkg/harvester/detail/harvesterhci.io.host/VlanStatus/index.vue"],"names":["t"],"mappings":";;qBA0DS,KAAK,EAAC,KAAK;qBACT,KAAK,EAAC,aAAa;qBACjB,KAAK,EAAC,YAAY;qBAYtB,KAAK,EAAC,WAAW;qBACf,KAAK,EAAC,YAAY;qBAMlB,KAAK,EAAC,YAAY;qBAOpB,KAAK,EAAC,WAAW;qBACf,KAAK,EAAC,aAAa;;;;;;;;;wBA9B5B,oBA6CM;IA5CJ,oBAaM,OAbN,UAaM;MAZJ,oBAWM,OAXN,UAWM;QAVJ,oBASM,OATN,UASM;4CARDA,MAAC,mCAAkC,eACtC;0BAAA,aAME;YAJC,KAAK,EAAE,uBAAc,CAAC,MAAM;YAC5B,IAAI,EAAE,uBAAc,CAAC,MAAM;YAC3B,KAAK,EAAEA,MAAC;YACT,KAAK,EAAC,mBAAmB;;uCAJR,uBAAc,CAAC,OAAO;;;;;;IAS/C,oBAaM,OAbN,UAaM;MAZJ,oBAKM,OALN,UAKM;QAJJ,aAGE;UAFC,IAAI,EAAEA,MAAC;UACP,KAAK,EAAE,YAAK,CAAC,MAAM,CAAC,cAAc;;;;MAGvC,oBAKM,OALN,UAKM;QAJJ,aAGE;UAFC,IAAI,EAAEA,MAAC;UACP,KAAK,EAAE,YAAK,CAAC,MAAM,CAAC,UAAU;;;;;IAIrC,oBAeM,OAfN,UAeM;MAdJ,oBAaM,OAbN,UAaM;QAZJ,aAWmB;UAVT,KAAK,EAAE,mBAAU;kEAAV,mBAAU;UACxB,IAAI,EAAE,WAAI;UACV,YAAU,EAAE,KAAK;;UAEP,OAAO,WAChB,CAGE,AAJgB,KAAK;YACvB,aAGE;cAFC,KAAK,EAAE,KAAK,CAAC,GAAG,CAAC,KAAK;cACtB,IAAI,EAAE,WAAI","sourcesContent":["<script>\nimport LabelValue from '@shell/components/LabelValue';\nimport ArrayListGrouped from '@shell/components/form/ArrayListGrouped';\nimport { BadgeState } from '@components/BadgeState';\n\nimport { _CREATE } from '@shell/config/query-params';\nimport { findBy } from '@shell/utils/array';\n\nimport { HCI } from '../../../types';\nimport LinkStatus from './LinkStatus';\n\nexport default {\n  name: 'HarvesterHostNetwork',\n\n  components: {\n    LabelValue,\n    LinkStatus,\n    ArrayListGrouped,\n    BadgeState,\n  },\n\n  props: {\n    value: {\n      type:     Object,\n      required: true,\n    },\n\n    mode: {\n      type:    String,\n      default: _CREATE,\n    },\n  },\n\n  computed: {\n    conditions() {\n      return this.value?.status?.conditions || [];\n    },\n\n    readyCondition() {\n      return findBy(this.conditions, 'type', 'ready') || {};\n    },\n\n    linkStatus() {\n      const linkMonitorId = this.value?.status?.linkMonitor;\n      const nodeName = this.value?.status?.node;\n\n      const inStore = this.$store.getters['currentProduct'].inStore;\n      const linkMonitors = this.$store.getters[`${ inStore }/all`](HCI.LINK_MONITOR);\n      const linkMonitor = (linkMonitors.filter((l) => l.id === linkMonitorId) || [])[0] || {};\n\n      return linkMonitor?.status?.linkStatus?.[nodeName] || [];\n    },\n  },\n};\n</script>\n\n<template>\n  <div>\n    <div class=\"row\">\n      <div class=\"col span-12\">\n        <div class=\"pull-right\">\n          {{ t('resourceTabs.conditions.tab') }}:\n          <BadgeState\n            v-clean-tooltip=\"readyCondition.message\"\n            :color=\"readyCondition.status === 'True' ? 'bg-success' : 'bg-error' \"\n            :icon=\"readyCondition.status === 'True' ? 'icon-checkmark' : 'icon-warning' \"\n            :label=\"t('tableHeaders.ready')\"\n            class=\"mr-10 ml-10 state\"\n          />\n        </div>\n      </div>\n    </div>\n    <div class=\"row mt-10\">\n      <div class=\"col span-6\">\n        <LabelValue\n          :name=\"t('harvester.network.clusterNetwork.label')\"\n          :value=\"value.status.clusterNetwork\"\n        />\n      </div>\n      <div class=\"col span-6\">\n        <LabelValue\n          :name=\"t('harvester.vlanStatus.vlanConfig.label')\"\n          :value=\"value.status.vlanConfig\"\n        />\n      </div>\n    </div>\n    <div class=\"row mt-20\">\n      <div class=\"col span-12\">\n        <ArrayListGrouped\n          v-model:value=\"linkStatus\"\n          :mode=\"mode\"\n          :can-remove=\"false\"\n        >\n          <template #default=\"props\">\n            <LinkStatus\n              :value=\"props.row.value\"\n              :mode=\"mode\"\n            />\n          </template>\n        </ArrayListGrouped>\n      </div>\n    </div>\n  </div>\n</template>\n"]}]}