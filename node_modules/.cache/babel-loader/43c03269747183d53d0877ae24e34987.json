{"remainingRequest":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js??ruleSet[1].rules[4]!/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js??ruleSet[0].use[0]!/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js??ruleSet[0].use[1]!/home/ubuntu/essentials-ui-extension/pkg/harvester/dialog/HarvesterImageDownloader.vue?vue&type=template&id=5e549932&scoped=true","dependencies":[{"path":"/home/ubuntu/essentials-ui-extension/pkg/harvester/dialog/HarvesterImageDownloader.vue","mtime":1773206911357},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js","mtime":1773205228903},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js","mtime":1773205228903}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["/home/ubuntu/essentials-ui-extension/pkg/harvester/dialog/HarvesterImageDownloader.vue"],"names":["t"],"mappings":";;qBAqIa,KAAK,EAAC,SAAS;qBACb,KAAK,EAAC,SAAS;;;;;;;;wBA7B5B,aA8CY;IA7CV,KAAK,EAAC,wBAAwB;IAC9B,IAAI,EAAC,uBAAuB;IAC5B,MAAM,EAAC,MAAM;IACZ,KAAK,EAAE,GAAG;IACV,gBAAc,EAAE,KAAK;IACrB,OAAK,EAAE,cAAK;;sBAEb,CAqCO;MArCP,aAqCO,mBArCA,uBAAqB,EAAE,KAAK;QACtB,KAAK,WACd,CAA8C;4CAA3CA,MAAC;;QAGK,IAAI,WACb,CAES;UAFT,aAES,qBAFD,KAAK,EAAC,MAAM;8BAClB,CAA2E;gDAAxEA,MAAC,iDAAiD,yBAAgB;;;;2BAC9D,GACT,oBAAGA,MAAC,kDAAiD,GACrD;oCAAA,oBAAM;oCAAA,oBAAM;;6BACZ,oBAKE,6BAJmB,YAAM,GAAjB,GAAG,EAAE,CAAC;kCADhB,aAKE;cAHC,GAAG,EAAE,CAAC;cACP,KAAK,EAAC,OAAO;cACZ,KAAK,EAAE,GAAG;;;;QAIJ,OAAO,WAChB,CAeM;UAfN,oBAeM,OAfN,UAeM;YAdJ,oBAaM,OAbN,UAaM;cAZJ,oBAKS;gBAJP,KAAK,EAAC,0BAA0B;gBAC/B,OAAK,0CAAE,yCAAK;kCAEVA,MAAC;;cAEN,aAKE;gBAJA,IAAI,EAAC,QAAQ;gBACb,IAAI,EAAC,UAAU;gBACd,QAAQ,EAAE,gCAAuB;gBACjC,OAAK,EAAE,sBAAa","sourcesContent":["<script>\nimport { mapGetters } from 'vuex';\nimport { exceptionToErrorsArray } from '@shell/utils/error';\nimport { HCI } from '../types';\nimport { Card } from '@components/Card';\nimport { Banner } from '@components/Banner';\nimport AsyncButton from '@shell/components/AsyncButton';\nimport AppModal from '@shell/components/AppModal';\n\nexport default {\n  name: 'HarvesterImageDownloaderDialog',\n\n  emits: ['close'],\n\n  components: {\n    AsyncButton, Banner, Card, AppModal\n  },\n\n  props: {\n    resources: {\n      type:     Array,\n      required: true\n    }\n  },\n\n  data() {\n    return { errors: [], isOpen: false };\n  },\n\n  computed: {\n    ...mapGetters({ t: 'i18n/t' }),\n\n    downloadImageInProgress() {\n      return this.$store.getters['harvester-common/isDownloadImageInProgress'];\n    },\n\n    image() {\n      return this.resources[0] || {};\n    },\n\n    imageName() {\n      return this.image?.name || '';\n    },\n\n    imageVirtualSize() {\n      return this.image?.virtualSize || this.image?.downSize || '';\n    }\n  },\n\n  methods: {\n    async cancelDownload() {\n      const url = this.image?.links?.downloadcancel;\n\n      if (url) {\n        await this.$store.dispatch('harvester/request', { url });\n      }\n    },\n\n    async close() {\n      if (this.downloadImageInProgress) {\n        this.$store.commit('harvester-common/setDownloadImageCancel', true);\n        this.$store.commit('harvester-common/setDownloadImageInProgress', false);\n        await this.cancelDownload();\n      }\n      this.$emit('close');\n    },\n\n    async startDownload(buttonCb) {\n      // clean the download image CRD first.\n      await this.cancelDownload();\n      this.$store.commit('harvester-common/setDownloadImageCancel', false);\n      this.$store.commit('harvester-common/setDownloadImageInProgress', false);\n      this.errors = [];\n\n      const name = this.image?.name || '';\n      const namespace = this.image?.namespace || '';\n\n      const imageCrd = {\n        apiVersion: 'harvesterhci.io/v1beta1',\n        type:       HCI.VM_IMAGE_DOWNLOADER,\n        kind:       'VirtualMachineImageDownloader',\n        metadata:   {\n          name,\n          namespace\n        },\n        spec: { imageName: name }\n      };\n\n      const inStore = this.$store.getters['currentProduct'].inStore;\n      const imageCreate = await this.$store.dispatch(`${ inStore }/create`, imageCrd);\n\n      try {\n        await imageCreate.save();\n        this.$store.commit('harvester-common/setDownloadImageId', `${ namespace }/${ name }`, { root: true });\n        this.$store.dispatch('harvester-common/downloadImageProgress', { root: true });\n      } catch (err) {\n        this.errors = exceptionToErrorsArray(err);\n        buttonCb(false);\n      }\n    }\n  },\n};\n</script>\n\n<template>\n  <app-modal\n    class=\"image-downloader-modal\"\n    name=\"image-download-dialog\"\n    height=\"auto\"\n    :width=\"600\"\n    :click-to-close=\"false\"\n    @close=\"close\"\n  >\n    <Card :show-highlight-border=\"false\">\n      <template #title>\n        {{ t('harvester.modal.downloadImage.title') }}\n      </template>\n\n      <template #body>\n        <Banner color=\"info\">\n          {{ t('harvester.modal.downloadImage.banner', { size: imageVirtualSize }) }}\n        </Banner>\n        {{ t('harvester.modal.downloadImage.startMessage') }}\n        <br /><br />\n        <Banner\n          v-for=\"(err, i) in errors\"\n          :key=\"i\"\n          color=\"error\"\n          :label=\"err\"\n        />\n      </template>\n\n      <template #actions>\n        <div class=\"actions\">\n          <div class=\"buttons\">\n            <button\n              class=\"btn role-secondary mr-10\"\n              @click=\"close\"\n            >\n              {{ t('generic.cancel') }}\n            </button>\n            <AsyncButton\n              type=\"submit\"\n              mode=\"download\"\n              :disabled=\"downloadImageInProgress\"\n              @click=\"startDownload\"\n            />\n          </div>\n        </div>\n      </template>\n    </Card>\n  </app-modal>\n</template>\n\n<style lang=\"scss\" scoped>\n.actions {\n  width: 100%;\n}\n\n.buttons {\n  display: flex;\n  justify-content: flex-end;\n  width: 100%;\n}\n</style>\n"]}]}