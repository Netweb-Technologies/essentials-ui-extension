{"remainingRequest":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js??ruleSet[1].rules[4]!/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js??ruleSet[0].use[0]!/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js??ruleSet[0].use[1]!/home/ubuntu/essentials-ui-extension/pkg/harvester/components/HarvesterUpgradeProgressBarList.vue?vue&type=template&id=bdadef62&scoped=true","dependencies":[{"path":"/home/ubuntu/essentials-ui-extension/pkg/harvester/components/HarvesterUpgradeProgressBarList.vue","mtime":1773208598732},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js","mtime":1773205228903},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js","mtime":1773205228903}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["/home/ubuntu/essentials-ui-extension/pkg/harvester/components/HarvesterUpgradeProgressBarList.vue"],"names":["t"],"mappings":";;qBAwCO,KAAK,EAAC,UAAU;qBACG,KAAK,EAAC,mBAAmB;qBAKlC,KAAK,EAAC,WAAW;qBACd,KAAK,EAAC,KAAK;qBAahB,KAAK,EAAC,gBAAgB;qBAepB,KAAK,EAAC,SAAS;;;;;;wBAnC9B,oBA2CM,OA3CN,UA2CM;IA1CJ,oBAA0E;wCAAnE,YAAK,IAAG,GAAC;MAAA,oBAAqD,QAArD,UAAqD,mBAAlB,cAAO,IAAG,GAAC;;;IAC9D,oBAwCM;MAvCJ,oBAsCM;QArCJ,aAoCW;UApCO,IAAI,EAAE,UAAI;iEAAJ,UAAI;;UACf,KAAK,WACd,CAWM;YAXN,oBAWM,OAXN,UAWM;cAVJ,oBAKO,QALP,UAKO;gBAJL,aAGE;kBAFC,aAAW,EAAE,cAAO;kBACrB,qBAAmB,EAAC,MAAM;;;;cAG9B,oBAGgF;gBAF9E,KAAK,EAAC,QAAQ;gBACb,OAAK,0CAAE,uDAAY;kCACjB,UAAI,GAAGA,MAAC,8BAA8BA,MAAC;;;4BAErC,CAEX;;YAAA,oBAmBM,OAnBN,UAmBM;iCAlBJ,oBAiBM,6BAhBgB,WAAI,GAAhB,IAAI,EAAE,CAAC;sCADjB,oBAiBM,SAfH,GAAG,EAAE,CAAC;kBAEP,oBAKI;sDAJC,IAAI,CAAC,IAAI,IAAG,GAAC;oBAAA,oBAGQ;sBAFtB,KAAK,mBAAC,QAAQ,KACH,IAAI,CAAC,KAAK;wCACnB,IAAI,CAAC,KAAK;;;kBAEhB,aAGE;oBAFC,aAAW,EAAE,IAAI,CAAC,OAAO;oBAC1B,qBAAmB,EAAC,MAAM;;;kBAE5B,oBAEI,KAFJ,UAEI,mBADC,IAAI,CAAC,OAAO","sourcesContent":["<script>\nimport Collapse from '@shell/components/Collapse';\nimport PercentageBar from '@shell/components/PercentageBar';\n\nexport default {\n  name:       'HarvesterUpgradeProgressList',\n  components: { PercentageBar, Collapse },\n\n  props: {\n    title: {\n      type:    String,\n      default: ''\n    },\n\n    percent: {\n      type:    Number,\n      default: 0\n    },\n\n    list: {\n      type:    Array,\n      default: () => {\n        return [];\n      }\n    }\n  },\n\n  data() {\n    return { open: true };\n  },\n\n  methods: {\n    handleSwitch() {\n      this.open = !this.open;\n    }\n  }\n};\n</script>\n\n<template>\n  <div class=\"bar-list\">\n    <h4>{{ title }} <span class=\"float-r text-info\">{{ percent }}%</span></h4>\n    <div>\n      <div>\n        <Collapse v-model:open=\"open\">\n          <template #title>\n            <div class=\"total-bar\">\n              <span class=\"bar\">\n                <PercentageBar\n                  :model-value=\"percent\"\n                  preferred-direction=\"MORE\"\n                />\n              </span>\n              <span\n                class=\"on-off\"\n                @click=\"handleSwitch\"\n              > {{ open ? t('harvester.generic.close') : t('harvester.generic.open') }}</span>\n            </div>\n          </template>\n\n          <div class=\"custom-content\">\n            <div\n              v-for=\"(item, i) in list\"\n              :key=\"i\"\n            >\n              <p>\n                {{ item.name }} <span\n                  class=\"status\"\n                  :class=\"{ [item.state]: true }\"\n                >{{ item.state }}</span>\n              </p>\n              <PercentageBar\n                :model-value=\"item.percent\"\n                preferred-direction=\"MORE\"\n              />\n              <p class=\"warning\">\n                {{ item.message }}\n              </p>\n            </div>\n          </div>\n        </Collapse>\n      </div>\n    </div>\n  </div>\n</template>\n\n<style lang=\"scss\" scoped>\n.bar-list {\n  .float-r {\n    float: right;\n  }\n\n  .total-bar {\n    display: flex;\n    user-select: none;\n    > .bar {\n      width: 85%;\n    }\n    .on-off {\n      margin-left: 10px;\n      cursor: pointer;\n    }\n  }\n  .custom-content {\n    margin-bottom: 14px;\n    p {\n      margin-bottom: 4px;\n    }\n    .status {\n      float: right;\n    }\n    .Succeeded, .Upgrading, .Pending {\n      color: var(--success);\n    }\n    .failed {\n      color: var(--error)\n    }\n    .warning {\n      color: var(--error);\n    }\n  }\n}\n</style>\n"]}]}