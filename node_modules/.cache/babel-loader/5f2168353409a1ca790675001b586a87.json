{"remainingRequest":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js??ruleSet[1].rules[4]!/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js??ruleSet[0].use[0]!/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js??ruleSet[0].use[1]!/home/ubuntu/essentials-ui-extension/pkg/harvester/edit/kubeovn.io.vpc/VpcPeerings.vue?vue&type=template&id=78274866&scoped=true","dependencies":[{"path":"/home/ubuntu/essentials-ui-extension/pkg/harvester/edit/kubeovn.io.vpc/VpcPeerings.vue","mtime":1773206911362},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js","mtime":1773205228903},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js","mtime":1773205228903}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["/home/ubuntu/essentials-ui-extension/pkg/harvester/edit/kubeovn.io.vpc/VpcPeerings.vue"],"names":["localConnectPTooltip","t","queueUpdate"],"mappings":";;;;EA6GM,KAAK,EAAC,kBAAkB;;qBAMjB,KAAK,EAAC,6BAA6B;qBAChC,KAAK,EAAC,qBAAqB;;EAK7B,KAAK,EAAC,gBAAgB;EACtB,QAAQ,EAAC,GAAG;;qBAGV,KAAK,EAAC,gBAAgB;qBAIzB,KAAK,EAAC,yBAAyB;qBAC7B,KAAK,EAAC,qBAAqB;;;sBAY3B,KAAK,EAAC,gBAAgB;;;;;;;;;;wBApCnC,oBAkEM;KAhEI,UAAI,CAAC,MAAM;uBADnB,oBAwDM,OAxDN,UAwDM;6BApDJ,oBAmDM,6BAlDiB,UAAI,GAAjB,GAAG,EAAE,GAAG;kCADlB,oBAmDM,SAjDH,GAAG,EAAE,GAAG;cAET,oBAaM,OAbN,UAaM;gBAZJ,oBAQO,QARP,UAQO;kBAPL,aAAwD,gBAArD,CAAC,EAAC,gDAAgD;;kCACrD,oBAKE,KALF,UAKE;yDAJ2B,8BAAqB;qDACzBA,yBAAoB;;;;gBAK/C,oBAEO,QAFP,UAEO;kBADL,aAAmD,gBAAhD,CAAC,EAAC,2CAA2C;;;;cAGpD,oBAgCM,OAhCN,UAgCM;gBA/BJ,oBAWM,OAXN,UAWM;mBAVQ,eAAM;qCAAlB,oBAEO,qCADF,GAAG,CAAC,cAAc;qDAEvB,oBAME;;2DAJS,GAAG,CAAC,cAAc;wBAC3B,IAAI,EAAC,MAAM;wBACV,WAAW,EAAEC,MAAC;wBACd,OAAK,0CAAE,6CAAW;;sCAHV,GAAG,CAAC,cAAc;;;;gBAM/B,oBAUM,OAVN,WAUM;mBATQ,eAAM;qCAAlB,oBAEO,sCADF,GAAG,CAAC,SAAS;;;kBAElB,aAKE;oBAJQ,KAAK,EAAE,GAAG,CAAC,SAAS;mDAAb,GAAG,CAAC,SAAS,aAGbC,gBAAW;oBAFzB,OAAO,EAAE,yBAAgB;oBACzB,IAAI,EAAE,WAAI;;;;iBAKP,mBAAU;mCADlB,oBAOS;;sBALP,IAAI,EAAC,QAAQ;sBACb,KAAK,EAAC,oBAAoB;sBACzB,OAAK,aAAE,eAAM,CAAC,GAAG;;sBAElB,aAAwB,gBAArB,CAAC,EAAC,gBAAgB;;;;;;;;;KAMrB,gBAAO;uBADf,oBAOS;;UALP,IAAI,EAAC,QAAQ;UACb,KAAK,EAAC,uBAAuB;UAC5B,OAAK,uCAAE,YAAG;;UAEX,aAAqB,gBAAlB,CAAC,EAAC,aAAa","sourcesContent":["<script>\nimport debounce from 'lodash/debounce';\nimport { _EDIT, _VIEW } from '@shell/config/query-params';\nimport { removeAt } from '@shell/utils/array';\nimport { HCI } from '../../types';\nimport LabeledSelect from '@shell/components/form/LabeledSelect';\n\nexport default {\n  name: 'VpcPeerings',\n\n  emits: ['update:value'],\n\n  components: { LabeledSelect },\n\n  props: {\n    value: {\n      type:    Array,\n      default: null,\n    },\n    mode: {\n      type:    String,\n      default: _EDIT,\n    },\n    vpc: {\n      type:    Object,\n      default: () => ({}),\n    },\n  },\n\n  async fetch() {\n    await this.$store.dispatch('harvester/findAll', { type: HCI.VPC });\n  },\n\n  data() {\n    const rows = (this.value || []).map((row) => {\n      return {\n        localConnectIP:      row.localConnectIP || '',\n        remoteVpc:      row.remoteVpc || '',\n      };\n    });\n\n    return { rows };\n  },\n\n  computed: {\n    isView() {\n      return this.mode === _VIEW;\n    },\n\n    isEdit() {\n      return this.mode === _EDIT;\n    },\n\n    showAdd() {\n      return !this.isView;\n    },\n\n    showRemove() {\n      return !this.isView;\n    },\n\n    remoteVpcOptions() {\n      const allVpcs = this.$store.getters['harvester/all'](HCI.VPC) || [];\n\n      // filter self vpc if editing\n      const vpcs = this.isEdit ? allVpcs.filter((v) => v.id !== this.vpc.id) : allVpcs;\n\n      return vpcs.map((n) => ({\n        label: n.id,\n        value: n.id,\n      }));\n    },\n    localConnectIPTooltip() {\n      return this.t('harvester.vpc.vpcPeerings.localConnectIP.tooltip');\n    },\n  },\n\n  created() {\n    this.queueUpdate = debounce(this.update, 100);\n  },\n\n  methods: {\n    add() {\n      this.rows.push({\n        localConnectIP:  '',\n        remoteVpc:      '',\n      });\n      this.queueUpdate();\n    },\n\n    remove(idx) {\n      removeAt(this.rows, idx);\n      this.queueUpdate();\n    },\n\n    update() {\n      if (this.isView) {\n        return;\n      }\n      this.$emit('update:value', this.rows);\n    }\n  },\n};\n</script>\n\n<template>\n  <div>\n    <div\n      v-if=\"rows.length\"\n      class=\"static-route-row\"\n    >\n      <div\n        v-for=\"(row, idx) in rows\"\n        :key=\"idx\"\n      >\n        <div class=\"pool-headers localConnectIP\">\n          <span class=\"pool-localConnectIP\">\n            <t k=\"harvester.vpc.vpcPeerings.localConnectIP.label\" />\n            <i\n              v-clean-tooltip=\"{content: localConnectIPTooltip, triggers: ['hover', 'touch', 'focus'] }\"\n              v-stripped-aria-label=\"localConnectPTooltip\"\n              class=\"icon icon-info\"\n              tabindex=\"0\"\n            />\n          </span>\n          <span class=\"pool-remoteVpc\">\n            <t k=\"harvester.vpc.vpcPeerings.remoteVpc.label\" />\n          </span>\n        </div>\n        <div class=\"pool-row localConnectIP\">\n          <div class=\"pool-localConnectIP\">\n            <span v-if=\"isView\">\n              {{ row.localConnectIP }}\n            </span>\n            <input\n              v-else\n              v-model=\"row.localConnectIP\"\n              type=\"text\"\n              :placeholder=\"t('harvester.vpc.vpcPeerings.localConnectIP.placeholder')\"\n              @input=\"queueUpdate\"\n            />\n          </div>\n          <div class=\"pool-remoteVpc\">\n            <span v-if=\"isView\">\n              {{ row.remoteVpc }}\n            </span>\n            <LabeledSelect\n              v-model:value=\"row.remoteVpc\"\n              :options=\"remoteVpcOptions\"\n              :mode=\"mode\"\n              @update:value=\"queueUpdate\"\n            />\n          </div>\n          <button\n            v-if=\"showRemove\"\n            type=\"button\"\n            class=\"btn role-link pl-0\"\n            @click=\"remove(idx)\"\n          >\n            <t k=\"generic.remove\" />\n          </button>\n        </div>\n      </div>\n    </div>\n    <button\n      v-if=\"showAdd\"\n      type=\"button\"\n      class=\"btn role-tertiary add\"\n      @click=\"add()\"\n    >\n      <t k=\"generic.add\" />\n    </button>\n  </div>\n</template>\n\n<style lang=\"scss\" scoped>\n  .pool-headers, .pool-row {\n    display: grid;\n    grid-column-gap: $column-gutter;\n    margin-bottom: 10px;\n    align-items: center;\n\n    &.localConnectIP {\n      grid-template-columns: 40%+$column-gutter 40%+$column-gutter 15%;\n    }\n  }\n</style>\n"]}]}