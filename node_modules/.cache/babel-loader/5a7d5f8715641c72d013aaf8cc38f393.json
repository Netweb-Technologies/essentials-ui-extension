{"remainingRequest":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js??ruleSet[1].rules[4]!/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js??ruleSet[0].use[0]!/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js??ruleSet[0].use[1]!/home/ubuntu/essentials-ui-extension/pkg/harvester/dialog/HarvesterVMSnapshotDialog.vue?vue&type=template&id=723f1c88&scoped=true","dependencies":[{"path":"/home/ubuntu/essentials-ui-extension/pkg/harvester/dialog/HarvesterVMSnapshotDialog.vue","mtime":1773206911358},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js","mtime":1773205228903},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js","mtime":1773205228903}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["/home/ubuntu/essentials-ui-extension/pkg/harvester/dialog/HarvesterVMSnapshotDialog.vue"],"names":["t"],"mappings":";;qBAsHQ,KAAK,EAAC,mBAAmB;qBAyBtB,KAAK,EAAC,SAAS;qBACb,KAAK,EAAC,SAAS;;;;;;;;;wBA9B1B,aA8CO,mBA9CA,uBAAqB,EAAE,KAAK;IACtB,KAAK,WACd,CAGE;sBAHF,oBAGE,MAHF,UAGE;gCAFcA,MAAC;;;IAKR,IAAI,WACb,CAIE;MAJF,aAIE;QAHQ,KAAK,EAAE,uBAAc,CAAC,QAAQ,CAAC,SAAS;gEAAjC,uBAAc,CAAC,QAAQ,CAAC,SAAS;QAC/C,QAAQ,EAAE,IAAI;QACd,KAAK,EAAEA,MAAC;;;MAEX,aAKE;QAJQ,KAAK,EAAE,kBAAY;gEAAZ,kBAAY;QAC3B,KAAK,EAAC,OAAO;QACZ,KAAK,EAAEA,MAAC;QACT,QAAQ,EAAR,EAAQ;;;yBAEV,oBAKE,6BAJmB,YAAM,GAAjB,GAAG,EAAE,CAAC;8BADhB,aAKE;UAHC,GAAG,EAAE,CAAC;UACP,KAAK,EAAC,OAAO;UACZ,KAAK,EAAE,GAAG;;;;IAIJ,OAAO,WAChB,CAeM;MAfN,oBAeM,OAfN,UAeM;QAdJ,oBAaM,OAbN,UAaM;UAZJ,oBAKS;YAJP,KAAK,EAAC,0BAA0B;YAC/B,OAAK,0CAAE,yCAAK;8BAEVA,MAAC;;UAGN,aAIE;YAHA,IAAI,EAAC,QAAQ;YACZ,QAAQ,GAAG,kBAAY;YACvB,OAAK,EAAE,aAAI","sourcesContent":["<script>\nimport { exceptionToErrorsArray } from '@shell/utils/error';\nimport { mapGetters } from 'vuex';\nimport { Card } from '@components/Card';\nimport { Banner } from '@components/Banner';\nimport AsyncButton from '@shell/components/AsyncButton';\nimport { LabeledInput } from '@components/Form/LabeledInput';\nimport { HCI } from '../types';\nimport { BACKUP_TYPE } from '../config/types';\n\nexport default {\n  name: 'HarvesterVMSnapshotDialog',\n\n  emits: ['close'],\n\n  components: {\n    AsyncButton,\n    Card,\n    LabeledInput,\n    Banner\n  },\n\n  props: {\n    resources: {\n      type:     Array,\n      required: true\n    }\n  },\n\n  data() {\n    return {\n      snapshotName:      '',\n      snapshotNamespace: '',\n      errors:            []\n    };\n  },\n\n  computed: {\n    ...mapGetters({ t: 'i18n/t' }),\n\n    actionResource() {\n      return this.resources[0];\n    }\n  },\n\n  methods: {\n    close() {\n      this.snapshotNamespace = '';\n      this.snapshotName = '';\n      this.$emit('close');\n    },\n\n    async save(buttonCb) {\n      if (this.actionResource) {\n        try {\n          const snapshot = await this.$store.dispatch('harvester/create', {\n            metadata: {\n              name:            this.snapshotName,\n              namespace:       this.actionResource.metadata.namespace,\n              ownerReferences: this.getOwnerReferencesFromVM(this.actionResource)\n            },\n            spec: {\n              source: {\n                apiGroup: 'kubevirt.io',\n                kind:     'VirtualMachine',\n                name:     this.actionResource.metadata.name\n              },\n              type: BACKUP_TYPE.SNAPSHOT\n            },\n            type: HCI.BACKUP\n          });\n\n          await snapshot.save();\n\n          this.$store.dispatch(\n            'growl/success',\n            {\n              title:   this.t('generic.notification.title.succeed'),\n              message: this.t('harvester.modal.vmSnapshot.success', { name: this.snapshotName })\n            },\n            { root: true }\n          );\n\n          this.close();\n\n          buttonCb(true);\n        } catch (err) {\n          const error = err?.data || err;\n          const message = exceptionToErrorsArray(error);\n\n          this['errors'] = message;\n          buttonCb(false);\n        }\n      }\n    },\n\n    getOwnerReferencesFromVM(resource) {\n      const name = resource.metadata.name;\n      const kind = resource.kind;\n      const apiVersion = 'kubevirt.io/v1';\n      const uid = resource?.metadata?.uid;\n\n      return [{\n        name,\n        kind,\n        uid,\n        apiVersion,\n      }];\n    },\n  }\n};\n</script>\n\n<template>\n  <Card :show-highlight-border=\"false\">\n    <template #title>\n      <h4\n        v-clean-html=\"t('harvester.modal.vmSnapshot.title')\"\n        class=\"text-default-text\"\n      />\n    </template>\n\n    <template #body>\n      <LabeledInput\n        v-model:value=\"actionResource.metadata.namespace\"\n        :disabled=\"true\"\n        :label=\"t('generic.namespace')\"\n      />\n      <LabeledInput\n        v-model:value=\"snapshotName\"\n        class=\"mt-20\"\n        :label=\"t('generic.name')\"\n        required\n      />\n      <Banner\n        v-for=\"(err, i) in errors\"\n        :key=\"i\"\n        color=\"error\"\n        :label=\"err\"\n      />\n    </template>\n\n    <template #actions>\n      <div class=\"actions\">\n        <div class=\"buttons\">\n          <button\n            class=\"btn role-secondary mr-10\"\n            @click=\"close\"\n          >\n            {{ t('generic.cancel') }}\n          </button>\n\n          <AsyncButton\n            mode=\"create\"\n            :disabled=\"!snapshotName\"\n            @click=\"save\"\n          />\n        </div>\n      </div>\n    </template>\n  </Card>\n</template>\n\n<style lang=\"scss\" scoped>\n.actions {\n  width: 100%;\n}\n\n.buttons {\n  display: flex;\n  justify-content: flex-end;\n  width: 100%;\n}\n</style>\n"]}]}