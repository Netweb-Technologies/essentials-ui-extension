{"remainingRequest":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js??ruleSet[1].rules[4]!/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js??ruleSet[0].use[0]!/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js??ruleSet[0].use[1]!/home/ubuntu/essentials-ui-extension/pkg/harvester/edit/loadbalancer.harvesterhci.io.ippool/Priority.vue?vue&type=template&id=4528a8d7&scoped=true","dependencies":[{"path":"/home/ubuntu/essentials-ui-extension/pkg/harvester/edit/loadbalancer.harvesterhci.io.ippool/Priority.vue","mtime":1773206911368},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js","mtime":1773205228903},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js","mtime":1773205228903}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["/home/ubuntu/essentials-ui-extension/pkg/harvester/edit/loadbalancer.harvesterhci.io.ippool/Priority.vue"],"names":["t","queueUpdate"],"mappings":";;;;;EA6GU,KAAK,EAAC,cAAc;;qBAIhB,KAAK,EAAC,gBAAgB;;;EAK1B,KAAK,EAAC,mBAAmB;;;;EAMzB,KAAK,EAAC,QAAQ;;;;EAmBlB,KAAK,EAAC,QAAQ;;;;;;;;wBA/ClB,oBA0DM;IAzDJ,oBAEK,6BADAA,MAAC;;KAEK,UAAI,CAAC,MAAM;uBAAtB,oBAwCM;UAvCJ,oBAyBM;YAxBJ,KAAK,mBAAC,cAAc;sCAC4B,8BAAqB;;;aAK7D,8BAAqB;+BAD7B,oBAKO,QALP,UAKO;kBADL,aAAwC,gBAArC,CAAC,EAAC,gCAAgC;;;;YAEvC,oBAEO,QAFP,UAEO;cADL,aAA0C,gBAAvC,CAAC,EAAC,kCAAkC;;;aAGjC,8BAAqB;+BAD7B,oBAKO,QALP,UAKO;kBADL,aAA6C,gBAA1C,CAAC,EAAC,qCAAqC;;;;aAGpC,mBAAU;+BADlB,oBAGE,QAHF,UAGE;;;;6BAEJ,oBAYM,6BAXiB,UAAI,GAAjB,GAAG,EAAE,GAAG;kCADlB,oBAYM,SAVH,GAAG,EAAE,GAAG;cAET,aAOE;gBANC,GAAG,EAAE,GAAG;gBACR,IAAI,EAAE,WAAI;gBACV,IAAI,EAAE,UAAI;gBACV,GAAG,EAAE,GAAG;gBACR,gBAAY,EAAEC,gBAAW;gBACzB,QAAM,aAAE,eAAM,CAAC,GAAG;;;;;;;KAKjB,gBAAO;uBADf,oBAYM,OAZN,UAYM;UARJ,oBAOS;YANP,IAAI,EAAC,QAAQ;YACZ,QAAQ,EAAE,mBAAU;YACrB,KAAK,EAAC,uBAAuB;YAC5B,OAAK,uCAAE,YAAG;;YAEX,aAAyC,gBAAtC,CAAC,EAAC,iCAAiC","sourcesContent":["<script>\nimport debounce from 'lodash/debounce';\nimport { _EDIT, _VIEW } from '@shell/config/query-params';\nimport { removeAt } from '@shell/utils/array';\nimport { clone } from '@shell/utils/object';\nimport { mapGetters } from 'vuex';\nimport PriorityRow from './PriorityRow';\n\nexport default {\n  emits: ['update:value'],\n\n  components: { PriorityRow },\n\n  props: {\n    value: {\n      type:    Array,\n      default: null,\n    },\n    mode: {\n      type:    String,\n      default: _EDIT,\n    },\n    autoAddIfEmpty: {\n      type:    Boolean,\n      default: true,\n    }\n  },\n\n  data() {\n    const rows = clone(this.value || []);\n\n    return { rows };\n  },\n\n  computed: {\n    ...mapGetters(['isRancherInHarvester', 'isStandaloneHarvester']),\n\n    isView() {\n      return this.mode === _VIEW;\n    },\n\n    disableAdd() {\n      return this.isStandaloneHarvester && this.rows.some((row) => row.namespace === '*');\n    },\n\n    showAdd() {\n      return !this.isView;\n    },\n\n    showRemove() {\n      return !this.isView;\n    },\n\n    showProjectAndCluster() {\n      return !this.isStandaloneHarvester;\n    },\n  },\n\n  created() {\n    this.queueUpdate = debounce(this.update, 500);\n  },\n\n  methods: {\n    add() {\n      const defaultRow = { namespace: '*' };\n\n      if (!this.showProjectAndCluster) {\n        this.rows.push(defaultRow);\n      } else {\n        this.rows.push({\n          ...defaultRow,\n          project:      '*',\n          guestCluster: '*',\n        });\n      }\n\n      this.queueUpdate();\n    },\n\n    remove(idx) {\n      removeAt(this.rows, idx);\n      this.queueUpdate();\n    },\n\n    update() {\n      if ( this.isView ) {\n        return;\n      }\n\n      this.$emit('update:value', this.rows);\n    }\n  },\n};\n</script>\n\n<template>\n  <div>\n    <h3>\n      {{ t('harvester.ipPool.scope.label') }}\n    </h3>\n    <div v-if=\"rows.length\">\n      <div\n        class=\"pool-headers\"\n        :class=\"{\n          'show-project-and-cluster': showProjectAndCluster,\n        }\"\n      >\n        <span\n          v-if=\"showProjectAndCluster\"\n          class=\"pool-project\"\n        >\n          <t k=\"harvester.ipPool.project.label\" />\n        </span>\n        <span class=\"pool-namespace\">\n          <t k=\"harvester.ipPool.namespace.label\" />\n        </span>\n        <span\n          v-if=\"showProjectAndCluster\"\n          class=\"pool-guestCluster\"\n        >\n          <t k=\"harvester.ipPool.guestCluster.label\" />\n        </span>\n        <span\n          v-if=\"showRemove\"\n          class=\"remove\"\n        />\n      </div>\n      <div\n        v-for=\"(row, idx) in rows\"\n        :key=\"idx\"\n      >\n        <PriorityRow\n          :row=\"row\"\n          :mode=\"mode\"\n          :rows=\"rows\"\n          :idx=\"idx\"\n          @update:value=\"queueUpdate\"\n          @remove=\"remove(idx)\"\n        />\n      </div>\n    </div>\n    <div\n      v-if=\"showAdd\"\n      class=\"footer\"\n    >\n      <button\n        type=\"button\"\n        :disabled=\"disableAdd\"\n        class=\"btn role-tertiary add\"\n        @click=\"add()\"\n      >\n        <t k=\"harvester.ipPool.scope.addLabel\" />\n      </button>\n    </div>\n  </div>\n</template>\n\n<style lang=\"scss\" scoped>\n  .pool-headers {\n    display: grid;\n    grid-column-gap: $column-gutter;\n    margin-bottom: 10px;\n    align-items: center;\n\n    grid-template-columns: 40% 40% 15%;\n\n    &.show-project-and-cluster {\n      grid-template-columns: 25% 25% 25% 15%;\n    }\n  }\n</style>\n"]}]}