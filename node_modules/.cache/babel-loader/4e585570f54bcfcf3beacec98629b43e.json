{"remainingRequest":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js??ruleSet[1].rules[4]!/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js??ruleSet[0].use[0]!/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js??ruleSet[0].use[1]!/home/ubuntu/essentials-ui-extension/pkg/harvester/edit/devices.harvesterhci.io.migconfiguration.vue?vue&type=template&id=2e6aac99","dependencies":[{"path":"/home/ubuntu/essentials-ui-extension/pkg/harvester/edit/devices.harvesterhci.io.migconfiguration.vue","mtime":1773206911358},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js","mtime":1773205228903},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js","mtime":1773205228903}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["/home/ubuntu/essentials-ui-extension/pkg/harvester/edit/devices.harvesterhci.io.migconfiguration.vue"],"names":["doneRoute","mode","errors","applyHooks","save","$attrs","t"],"mappings":";;;;;;;;;;wBAsFE,aA6Cc;IA5CX,YAAU,EAAEA,cAAS;IACrB,QAAQ,EAAE,YAAK;IACf,IAAI,EAAEC,SAAI;IACV,MAAM,EAAEC,WAAM;IACd,aAAW,EAAEC,eAAU;IACxB,oBAAkB,EAAC,QAAQ;IAC1B,QAAM,EAAEC,SAAI;IACZ,OAAK,4BAAE,CAAC,EAAEF,WAAM,CAAC,CAAC;;sBAEnB,CAGE;MAHF,aAGE;QAFC,KAAK,EAAE,YAAK;QACZ,IAAI,EAAED,SAAI;;;MAEb,aA8BS,mBA9BT,YA8BS,AA7BCI,WAAM;QACd,KAAK,EAAC,OAAO;QACZ,WAAS,EAAE,IAAI;;0BAEhB,CAwBM;UAxBN,aAwBM;YAvBJ,IAAI,EAAC,aAAa;YACjB,KAAK,EAAEC,MAAC;YACR,MAAM,EAAE,CAAC;YACV,KAAK,EAAC,gBAAgB;;8BAGpB,CAAuC;iCADzC,oBAiBM,6BAhBuB,iBAAW,GAA9B,OAAO,EAAE,KAAK;sCADxB,oBAiBM,SAfH,GAAG,EAAE,KAAK;kBAEX,aAGE;oBAFC,KAAK,EAAE,mBAAU,CAAC,OAAO;oBAC1B,KAAK,EAAC,OAAO;;;kBAEf,aAQE;oBAPQ,KAAK,EAAE,OAAO,CAAC,SAAS;mDAAjB,OAAO,CAAC,SAAS,wBAMjB,wBAAe,CAAC,MAAM,EAAE,OAAO;oBAL7C,GAAG,EAAE,CAAC;oBACN,QAAQ,EAAE,eAAM;oBACjB,IAAI,EAAC,QAAQ;oBACb,KAAK,EAAC,OAAO;oBACZ,KAAK,KAAKA,MAAC","sourcesContent":["<script>\nimport Tabbed from '@shell/components/Tabbed';\nimport Tab from '@shell/components/Tabbed/Tab';\nimport CruResource from '@shell/components/CruResource';\nimport { LabeledInput } from '@components/Form/LabeledInput';\nimport NameNsDescription from '@shell/components/form/NameNsDescription';\nimport LabelValue from '@shell/components/LabelValue';\nimport CreateEditView from '@shell/mixins/create-edit-view';\n\nexport default {\n  name: 'HarvesterEditMIGConfiguration',\n\n  components: {\n    Tab,\n    Tabbed,\n    CruResource,\n    LabeledInput,\n    NameNsDescription,\n    LabelValue\n  },\n\n  mixins: [CreateEditView],\n\n  inheritAttrs: false,\n\n  props: {\n    value: {\n      type:     Object,\n      required: true,\n    }\n  },\n\n  data() {\n    const { profileSpec } = this.value.spec;\n\n    return { profileSpec: profileSpec || [] };\n  },\n\n  created() {\n    if (this.registerBeforeHook) {\n      this.registerBeforeHook(this.updateBeforeSave);\n    }\n  },\n\n  computed: {\n    isView() {\n      return this.mode === 'view';\n    },\n  },\n  methods: {\n    updateBeforeSave() {\n      // MIGConfiguration CRD don't have any namespace field,\n      // so we need to remove the namespace field before saving\n      delete this.value.metadata.namespace;\n      // enable the MIGConfiguration when saving\n      this.value.spec.enabled = true;\n    },\n\n    labelTitle(profile) {\n      return `${ profile.name } (available : ${ this.available(profile) })`;\n    },\n\n    available(profile) {\n      const count = this.value.status?.profileStatus?.find((p) => p.id === profile.id)?.available;\n\n      return count || 0;\n    },\n\n    updateRequested(neu, profile) {\n      if (neu === null || neu === '') return;\n      const newValue = Number(neu);\n      const availableCount = this.available(profile);\n\n      if (newValue < 0) {\n        profile.requested = 0;\n      } else if ( newValue > availableCount ) {\n        profile.requested = availableCount;\n      } else {\n        profile.requested = newValue;\n      }\n    }\n  },\n};\n</script>\n\n<template>\n  <CruResource\n    :done-route=\"doneRoute\"\n    :resource=\"value\"\n    :mode=\"mode\"\n    :errors=\"errors\"\n    :apply-hooks=\"applyHooks\"\n    finish-button-mode=\"enable\"\n    @finish=\"save\"\n    @error=\"e=>errors=e\"\n  >\n    <NameNsDescription\n      :value=\"value\"\n      :mode=\"mode\"\n    />\n    <Tabbed\n      v-bind=\"$attrs\"\n      class=\"mt-15\"\n      :side-tabs=\"true\"\n    >\n      <Tab\n        name=\"profileSpec\"\n        :label=\"t('harvester.migconfiguration.profileSpec')\"\n        :weight=\"1\"\n        class=\"bordered-table\"\n      >\n        <div\n          v-for=\"(profile, index) in profileSpec\"\n          :key=\"index\"\n        >\n          <LabelValue\n            :value=\"labelTitle(profile)\"\n            class=\"mb-10\"\n          />\n          <LabeledInput\n            v-model:value=\"profile.requested\"\n            :min=\"0\"\n            :disabled=\"isView\"\n            type=\"number\"\n            class=\"mb-20\"\n            :label=\"`${t('harvester.migconfiguration.requested')}`\"\n            @update:value=\"updateRequested($event, profile)\"\n          />\n        </div>\n      </Tab>\n    </Tabbed>\n  </CruResource>\n</template>\n"]}]}