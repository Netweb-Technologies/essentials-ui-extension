{"remainingRequest":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js??ruleSet[1].rules[4]!/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js??ruleSet[0].use[0]!/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js??ruleSet[0].use[1]!/home/ubuntu/essentials-ui-extension/pkg/harvester/edit/harvesterhci.io.keypair.vue?vue&type=template&id=3de082a8&scoped=true","dependencies":[{"path":"/home/ubuntu/essentials-ui-extension/pkg/harvester/edit/harvesterhci.io.keypair.vue","mtime":1773206911359},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js","mtime":1773205228903},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js","mtime":1773205228903}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["/home/ubuntu/essentials-ui-extension/pkg/harvester/edit/harvesterhci.io.keypair.vue"],"names":["doneRoute","mode","errors","applyHooks","save","isCreate","t","$emit","$attrs"],"mappings":";;qBA+ES,KAAK,EAAC,cAAc;;;;;;;;;;wBAT3B,aAgDc;IA/CX,YAAU,EAAEA,cAAS;IACrB,QAAQ,EAAE,YAAK;IACf,IAAI,EAAEC,SAAI;IACV,MAAM,EAAEC,WAAM;IACd,aAAW,EAAEC,eAAU;IACvB,QAAM,EAAEC,SAAI;IACZ,OAAK,4BAAE,CAAC,EAAEF,WAAM,CAAC,CAAC;;sBAEnB,CAQM;MARN,oBAQM,OARN,UAQM;SANIG,aAAQ;2BADhB,aAME;;cAJA,KAAK,EAAC,6BAA6B;cAClC,KAAK,EAAEC,MAAC;cACT,MAAM,EAAC,MAAM;cACZ,UAAQ,EAAE,sBAAa;;;;;qBAI5B,aAME;QALA,GAAG,EAAC,IAAI;QACP,GAAG,EAAE,kBAAY;QACjB,KAAK,EAAE,YAAK;QACZ,IAAI,EAAEL,SAAI;QACV,gBAAY,uCAAEM,UAAK,iBAAiB,MAAM;;;MAG7C,aAoBS,mBApBT,YAoBS,AAnBCC,WAAM;QACd,KAAK,EAAC,OAAO;QACZ,WAAS,EAAE,IAAI;;0BAEhB,CAcM;UAdN,aAcM;YAbJ,IAAI,EAAC,OAAO;YACX,KAAK,EAAEF,MAAC;YACR,MAAM,EAAE,CAAC;YACV,KAAK,EAAC,gBAAgB;;8BAEtB,CAOE;cAPF,aAOE;gBANQ,KAAK,EAAE,eAAS;wEAAT,eAAS;gBACxB,IAAI,EAAC,WAAW;gBACf,IAAI,EAAEL,SAAI;gBACV,YAAU,EAAE,GAAG;gBACf,KAAK,EAAEK,MAAC;gBACT,QAAQ,EAAR,EAAQ","sourcesContent":["<script>\nimport Tabbed from '@shell/components/Tabbed';\nimport Tab from '@shell/components/Tabbed/Tab';\nimport CruResource from '@shell/components/CruResource';\nimport { LabeledInput } from '@components/Form/LabeledInput';\nimport NameNsDescription from '@shell/components/form/NameNsDescription';\nimport FileSelector, { createOnSelected } from '@shell/components/form/FileSelector';\n\nimport { randomStr } from '@shell/utils/string';\nimport CreateEditView from '@shell/mixins/create-edit-view';\n\nexport default {\n  name: 'HarvesterEditKeypair',\n\n  emits: ['update:value'],\n\n  components: {\n    Tab,\n    Tabbed,\n    CruResource,\n    LabeledInput,\n    FileSelector,\n    NameNsDescription\n  },\n\n  mixins: [CreateEditView],\n\n  inheritAttrs: false,\n\n  props: {\n    value: {\n      type:     Object,\n      required: true,\n    }\n  },\n\n  data() {\n    if ( !this.value.spec ) {\n      this.value.spec = {};\n      this.value.metadata = { name: '' };\n    }\n\n    return {\n      publicKey:    this.value.spec.publicKey || '',\n      randomString: '',\n    };\n  },\n\n  watch: {\n    publicKey(neu) {\n      const trimNeu = neu.trim();\n\n      this.value.spec.publicKey = trimNeu;\n\n      const splitSSH = trimNeu.split(/\\s+/);\n\n      if (splitSSH.length === 3 && !this.value.metadata.name) {\n        const keyComment = splitSSH[2];\n\n        this.randomString = randomStr(10).toLowerCase();\n        this.value.metadata.name = keyComment.includes('@') ? keyComment.split('@')[0] : keyComment;\n      }\n    }\n  },\n\n  methods: { onKeySelected: createOnSelected('publicKey') },\n};\n</script>\n\n<template>\n  <CruResource\n    :done-route=\"doneRoute\"\n    :resource=\"value\"\n    :mode=\"mode\"\n    :errors=\"errors\"\n    :apply-hooks=\"applyHooks\"\n    @finish=\"save\"\n    @error=\"e=>errors=e\"\n  >\n    <div class=\"header mb-20\">\n      <FileSelector\n        v-if=\"isCreate\"\n        class=\"btn btn-sm bg-primary mt-10\"\n        :label=\"t('generic.readFromFile')\"\n        accept=\".pub\"\n        @selected=\"onKeySelected\"\n      />\n    </div>\n\n    <NameNsDescription\n      ref=\"nd\"\n      :key=\"randomString\"\n      :value=\"value\"\n      :mode=\"mode\"\n      @update:value=\"$emit('update:value', $event)\"\n    />\n\n    <Tabbed\n      v-bind=\"$attrs\"\n      class=\"mt-15\"\n      :side-tabs=\"true\"\n    >\n      <Tab\n        name=\"basic\"\n        :label=\"t('harvester.sshKey.tabs.basics')\"\n        :weight=\"1\"\n        class=\"bordered-table\"\n      >\n        <LabeledInput\n          v-model:value=\"publicKey\"\n          type=\"multiline\"\n          :mode=\"mode\"\n          :min-height=\"160\"\n          :label=\"t('harvester.sshKey.keypair')\"\n          required\n        />\n      </Tab>\n    </Tabbed>\n  </CruResource>\n</template>\n\n<style lang=\"scss\" scoped>\n.header {\n  display: flex;\n  justify-content: flex-end;\n}\n</style>\n"]}]}