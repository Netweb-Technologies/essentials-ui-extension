{"remainingRequest":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js??ruleSet[1].rules[4]!/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js??ruleSet[0].use[0]!/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js??ruleSet[0].use[1]!/home/ubuntu/essentials-ui-extension/pkg/harvester/formatters/HarvesterVmState.vue?vue&type=template&id=532c3690&scoped=true","dependencies":[{"path":"/home/ubuntu/essentials-ui-extension/pkg/harvester/formatters/HarvesterVmState.vue","mtime":1773206911370},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js","mtime":1773205228903},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js","mtime":1773205228903}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["/home/ubuntu/essentials-ui-extension/pkg/harvester/formatters/HarvesterVmState.vue"],"names":["t"],"mappings":";;qBAmIM,KAAK,EAAC,OAAO;;;;;;;wBARjB,oBAiDO;oBAhDL,aAIE;MAFC,aAAW,EAAE,UAAG;MAChB,cAAa,EAAE,8BAAqB;;eAF7B,iBAAW;;;oBAIrB,oBA0CM,OA1CN,UA0CM;MAtCJ,aAAsB,sBAAZ,GAAG,EAAE,UAAG;;OAEV,uBAAc,CAAC,MAAM;yBAD7B,aAoCa;;YAlCX,GAAG,EAAC,SAAS;YACb,OAAO,EAAC,QAAQ;YAChB,MAAM,EAAC,IAAI;;YAUA,MAAM,WACf,CAmBM;cAnBN,oBAmBM;gBAlBH,YAAU,uCAAE,oBAAW;gBACvB,YAAU,uCAAE,oBAAW;;mCAExB,oBAcI,6BAbyB,uBAAc,GAAjC,OAAO,EAAE,KAAK;wCADxB,oBAcI,OAZD,GAAG,EAAE,KAAK;sDAER,KAAK,QAAO,mBACf;qBACQ,gBAAO,CAAC,UAAG,EAAE,OAAO;uCAD5B,oBAOI;;0BALF,KAAK,EAAC,WAAW;0BACjB,IAAI,EAAC,QAAQ;0BACZ,OAAK,0CAAE,6CAAO;4CAEZA,MAAC;;qCACF,GACJ,oBAAG,OAAO;;;;;8BA1BhB,CAMO;cANP,oBAMO;gBALL,KAAK,EAAC,gBAAgB;gBACrB,YAAU,uCAAE,oBAAW;gBACvB,YAAU,uCAAE,mBAAU;;gBAEvB,oBAAoD,OAAjD,KAAK,EAAC,wCAAwC;;;;;;;;;gBAf5C,iBAAW","sourcesContent":["<script>\nimport VMState from '@shell/components/formatter/BadgeStateFormatter';\nimport HarvesterMigrationState from './HarvesterMigrationState';\n\nexport default {\n  components: { VMState, HarvesterMigrationState },\n  props:      {\n    value: {\n      type:    String,\n      default: ''\n    },\n\n    row: {\n      type:     Object,\n      required: true\n    },\n\n    allNodeNetwork: {\n      type:    Array,\n      default: () => {\n        return [];\n      }\n    },\n\n    allClusterNetwork: {\n      type:    Array,\n      default: () => {\n        return [];\n      }\n    }\n  },\n\n  data() {\n    return {\n      isMigrating: false,\n      timer:       null,\n    };\n  },\n\n  beforeUnmount() {\n    if (this.timer) {\n      clearTimeout(this.timer);\n    }\n  },\n\n  computed: {\n    warningMessage() {\n      const out = [];\n\n      if (this.row?.actualState === 'VM error' && this.row.warningMessage?.message) {\n        out.push(this.row.warningMessage?.message);\n      }\n\n      if (this.row?.migrationMessage) {\n        out.push(this.row?.migrationMessage.message);\n      }\n\n      if (this.row.warningMessage?.message) {\n        if (this.row.warningMessage?.pod) {\n          const pod = this.row.warningMessage.pod;\n\n          if (pod.metadata?.state?.error && !/pod has unbound immediate PersistentVolumeClaims/.test(pod.metadata?.state?.message)) {\n            out.push(pod.metadata?.state?.message);\n          }\n        } else {\n          out.push(this.row.warningMessage?.message);\n        }\n      }\n\n      return out;\n    }\n  },\n\n  methods: {\n    migrationStateChanged(neu) {\n      if (neu === 'Failed') {\n        this.isMigrating = false;\n      } else {\n        this.isMigrating = !!neu;\n      }\n    },\n\n    showMessage(show) {\n      if (this.timer) {\n        clearTimeout(this.timer);\n      }\n\n      if (this.$refs.popover) {\n        if (show) {\n          this.$refs.popover.show();\n        } else {\n          this.$refs.popover.hide();\n        }\n      }\n    },\n\n    delayClose() {\n      this.timer = setTimeout(() => {\n        this.showMessage(false);\n      }, 500);\n    },\n\n    async dismiss() {\n      try {\n        await this.row.doAction('dismissInsufficientResourceQuota');\n      } catch (err) {\n        if (err?._status === 400 || err?._status === 503) {\n          this.$store.dispatch('growl/error', {\n            title:   this.t('harvester.notification.title.error'),\n            message: err?.errors[0]\n          }, { root: true });\n        }\n      }\n    },\n\n    canMiss(row, message) {\n      return row.warningMessage?.message === message && row.warningMessage?.canDismiss;\n    }\n  },\n};\n</script>\n\n<template>\n  <span>\n    <HarvesterMigrationState\n      v-show=\"isMigrating\"\n      :vm-resource=\"row\"\n      @state-changed=\"migrationStateChanged\"\n    />\n    <div\n      v-show=\"!isMigrating\"\n      class=\"state\"\n    >\n      <VMState :row=\"row\" />\n      <v-dropdown\n        v-if=\"warningMessage.length\"\n        ref=\"popover\"\n        trigger=\"manual\"\n        offset=\"16\"\n      >\n        <span\n          class=\"tooltip-target\"\n          @mouseenter=\"showMessage(true)\"\n          @mouseleave=\"delayClose()\"\n        >\n          <i class=\"icon icon-warning icon-lg text-warning\" />\n        </span>\n\n        <template #popper>\n          <div\n            @mouseenter=\"showMessage(true)\"\n            @mouseleave=\"showMessage(false)\"\n          >\n            <p\n              v-for=\"(message, index) in warningMessage\"\n              :key=\"index\"\n            >\n              {{ index + 1 }}.\n              <a\n                v-if=\"canMiss(row, message)\"\n                class=\"text-link\"\n                role=\"button\"\n                @click=\"dismiss\"\n              >\n                {{ t('harvester.upgradePage.dismissMessage') }}\n              </a>\n              {{ message }}\n            </p>\n          </div>\n        </template>\n      </v-dropdown>\n    </div>\n  </span>\n</template>\n\n<style lang=\"scss\" scoped>\n.state {\n  display: flex;\n  justify-content: space-between;\n\n  .icon-warning {\n    margin-top: 2px;\n  }\n}\n</style>\n"]}]}