{"remainingRequest":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js??ruleSet[1].rules[4]!/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js??ruleSet[0].use[0]!/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js??ruleSet[0].use[1]!/home/ubuntu/essentials-ui-extension/pkg/harvester/detail/harvesterhci.io.schedulevmbackup/SnapshotList.vue?vue&type=template&id=77db063b","dependencies":[{"path":"/home/ubuntu/essentials-ui-extension/pkg/harvester/detail/harvesterhci.io.schedulevmbackup/SnapshotList.vue","mtime":1773206911353},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js","mtime":1773205228903},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js","mtime":1773205228903}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["/home/ubuntu/essentials-ui-extension/pkg/harvester/detail/harvesterhci.io.schedulevmbackup/SnapshotList.vue"],"names":["$attrs"],"mappings":";;;;;;;;wBAuEE,aAwBgB,0BAxBhB,YAwBgB,AAvBNA,WAAM;IACb,OAAO,EAAE,gBAAO;IAChB,SAAS,EAAE,KAAK;IAChB,IAAI,EAAE,qBAAY;IAClB,MAAM,EAAE,YAAM;IACf,WAAS,EAAC,MAAM;IAChB,iBAAe,EAAC,KAAK;;IAEV,UAAQ,WACjB,CAYK,CAbe,GAAG;MACvB,oBAYK;QAXH,oBAUO;WARG,GAAG,EAAE,MAAM,EAAE,MAAM;6BAD3B,aAKc;;gBAHX,EAAE,EAAE,GAAG,CAAC,cAAc;;kCAEvB,CAAqB;oDAAlB,GAAG,CAAC,WAAW;;;;6BAEpB,oBAEO,qCADF,GAAG,CAAC,WAAW","sourcesContent":["<script>\nimport ResourceTable from '@shell/components/ResourceTable';\nimport { STATE, NAME, AGE } from '@shell/config/table-headers';\nimport { allSettled } from '../../utils/promise';\nimport { BACKUP_TYPE } from '../../config/types';\nimport { HCI as HCI_ANNOTATIONS } from '@pkg/harvester/config/labels-annotations';\nimport { HCI } from '../../types';\nimport { schema } from '../../list/harvesterhci.io.vmsnapshot';\n\nexport default {\n  name: 'SnapshotList',\n\n  components: { ResourceTable },\n\n  props: {\n\n    id: {\n      type:     String,\n      required: true,\n    },\n  },\n  async fetch() {\n    const hash = await allSettled({ backups: this.$store.dispatch('harvester/findAll', { type: HCI.BACKUP }) });\n\n    this.rows = hash.backups;\n  },\n\n  data() {\n    return {\n      rows: [],\n      schema\n    };\n  },\n\n  computed: {\n    headers() {\n      return [\n        STATE,\n        NAME,\n        {\n          name:      'targetVM',\n          labelKey:  'tableHeaders.targetVm',\n          value:     'attachVM',\n          align:     'left',\n          formatter: 'AttachVMWithName'\n        },\n        {\n          name:      'readyToUse',\n          labelKey:  'tableHeaders.readyToUse',\n          value:     'status.readyToUse',\n          align:     'center',\n          formatter: 'Checked',\n        },\n        AGE\n      ];\n    },\n\n    filteredRows() {\n      let r = this.rows.filter((row) => row.spec?.type === BACKUP_TYPE.SNAPSHOT);\n\n      if (this.id) {\n        r = r.filter((row) => row.metadata.annotations?.[HCI_ANNOTATIONS.SVM_BACKUP_ID] === this.id);\n      }\n\n      return r;\n    },\n  },\n};\n</script>\n\n<template>\n  <ResourceTable\n    v-bind=\"$attrs\"\n    :headers=\"headers\"\n    :groupable=\"false\"\n    :rows=\"filteredRows\"\n    :schema=\"schema\"\n    key-field=\"_key\"\n    default-sort-by=\"age\"\n  >\n    <template #col:name=\"{row}\">\n      <td>\n        <span>\n          <router-link\n            v-if=\"row?.status?.source\"\n            :to=\"row.detailLocation\"\n          >\n            {{ row.nameDisplay }}\n          </router-link>\n          <span v-else>\n            {{ row.nameDisplay }}\n          </span>\n        </span>\n      </td>\n    </template>\n  </ResourceTable>\n</template>\n"]}]}