{"remainingRequest":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js??ruleSet[1].rules[4]!/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js??ruleSet[0].use[0]!/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js??ruleSet[0].use[1]!/home/ubuntu/essentials-ui-extension/pkg/harvester/list/devices.harvesterhci.io.migconfiguration.vue?vue&type=template&id=3a2eeaf6","dependencies":[{"path":"/home/ubuntu/essentials-ui-extension/pkg/harvester/list/devices.harvesterhci.io.migconfiguration.vue","mtime":1773206911371},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js","mtime":1773205228903},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js","mtime":1773205228903}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["/home/ubuntu/essentials-ui-extension/pkg/harvester/list/devices.harvesterhci.io.migconfiguration.vue"],"names":["$fetchState","t","$attrs"],"mappings":";;;;;;;;;;;;UAuHiBA,gBAAW,CAAC,OAAO;qBAAlC,aAAsC;QACrB,oBAAc;uBAA/B,oBAIM;UAHJ,aAES,qBAFD,KAAK,EAAC,SAAS;8BACrB,CAAsC;gDAAnCC,MAAC;;;;;UAGS,sBAAgB,KAAK,iBAAW;yBAAjD,oBAuBM;cArBK,sBAAgB;+BADzB,aAUS;;kBARP,KAAK,EAAC,SAAS;;oCAEf,CAKE;oBALF,aAKE;sBAJC,EAAE,EAAE,iBAAW;sBAChB,cAAY,EAAC,iCAAiC;sBAC9C,cAAY,EAAC,iCAAiC;sBAC9C,cAAY,EAAC,iCAAiC;;;;;;;cAIzC,iBAAW;+BADpB,aAUS;;kBARP,KAAK,EAAC,SAAS;;oCAEf,CAKE;oBALF,aAKE;sBAJC,EAAE,EAAE,gBAAU;sBACf,cAAY,EAAC,gCAAgC;sBAC7C,cAAY,EAAC,gCAAgC;sBAC7C,cAAY,EAAC,gCAAgC;;;;;;;WAInC,kBAAS;2BAAzB,oBA0BM;eAxBI,kCAAyB;iCADjC,aAUS;;oBARP,KAAK,EAAC,SAAS;;sCAEf,CAKE;sBALF,aAKE;wBAJC,EAAE,EAAE,qBAAY;wBACjB,cAAY,EAAC,8CAA8C;wBAC3D,cAAY,EAAC,8CAA8C;wBAC3D,cAAY,EAAC,8CAA8C;;;;;;;gBAItD,kCAAyB;iCADlC,aAIE;;oBAFA,KAAK,EAAC,SAAS;oBACd,KAAK,EAAEA,MAAC;;;;cAEX,aAQE,0BARF,YAQE,AAPQC,WAAM;gBACb,SAAS,EAAE,KAAK;gBAChB,UAAU,EAAE,KAAK;gBACjB,OAAO,EAAE,gBAAO;gBAChB,MAAM,EAAE,YAAM;gBACd,IAAI,EAAE,iBAAQ;gBACf,WAAS,EAAC,MAAM","sourcesContent":["<script>\nimport { STATE, NAME } from '@shell/config/table-headers';\nimport { allHash } from '@shell/utils/promise';\nimport Banner from '@components/Banner/Banner.vue';\nimport Loading from '@shell/components/Loading';\nimport ResourceTable from '@shell/components/ResourceTable';\nimport { HCI } from '../types';\nimport { ADD_ONS } from '../config/harvester-map';\nimport MessageLink from '@shell/components/MessageLink';\n\nexport default {\n  name: 'ListMIGConfigurations',\n\n  inheritAttrs: false,\n\n  components: {\n    Banner,\n    Loading,\n    ResourceTable,\n    MessageLink,\n  },\n\n  async fetch() {\n    const inStore = this.$store.getters['currentProduct'].inStore;\n\n    this.schema = this.$store.getters[`${ inStore }/schemaFor`](HCI.MIG_CONFIGURATION);\n    this.hasAddonSchema = this.$store.getters[`${ inStore }/schemaFor`](HCI.ADD_ONS);\n\n    if (this.hasSchema) {\n      try {\n        const hash = await allHash({\n          migconfigs:  this.$store.dispatch(`${ inStore }/findAll`, { type: HCI.MIG_CONFIGURATION }),\n          vGpuDevices: this.$store.dispatch(`${ inStore }/findAll`, { type: HCI.VGPU_DEVICE }),\n          addons:      this.$store.dispatch(`${ inStore }/findAll`, { type: HCI.ADD_ONS })\n        });\n\n        this.hasPCIAddon = hash.addons.find((addon) => addon.name === ADD_ONS.PCI_DEVICE_CONTROLLER)?.spec?.enabled === true;\n        this.hasSriovgpuAddon = hash.addons.find((addon) => addon.name === ADD_ONS.NVIDIA_DRIVER_TOOLKIT_CONTROLLER)?.spec?.enabled === true;\n        this.hasSRIOVGPUSchema = !!this.$store.getters[`${ inStore }/schemaFor`](HCI.SR_IOVGPU_DEVICE);\n\n        if (this.hasSRIOVGPUSchema) {\n          await this.$store.dispatch(`${ inStore }/findAll`, { type: HCI.SR_IOVGPU_DEVICE });\n        }\n        this.rows = hash.migconfigs;\n      } catch (e) {}\n    }\n  },\n\n  data() {\n    return {\n      rows:              [],\n      schema:            null,\n      hasAddonSchema:    false,\n      hasPCIAddon:       false,\n      hasSriovgpuAddon:  false,\n      hasSRIOVGPUSchema: false,\n      toVGpuAddon:       `${ HCI.ADD_ONS }/harvester-system/${ ADD_ONS.NVIDIA_DRIVER_TOOLKIT_CONTROLLER }?mode=edit`,\n      toPciAddon:        `${ HCI.ADD_ONS }/harvester-system/${ ADD_ONS.PCI_DEVICE_CONTROLLER }?mode=edit`,\n      SRIOVGPUPage:      `${ HCI.ADD_ONS }/harvester-system/${ ADD_ONS.NVIDIA_DRIVER_TOOLKIT_CONTROLLER }?mode=edit`,\n    };\n  },\n\n  computed: {\n    hasSchema() {\n      return !!this.schema;\n    },\n\n    rowsData() {\n      const inStore = this.$store.getters['currentProduct'].inStore;\n      const rows = this.$store.getters[`${ inStore }/all`](HCI.MIG_CONFIGURATION) || [];\n\n      return rows;\n    },\n\n    sriovGPUPage() {\n      return {\n        name:   'harvester-c-cluster-resource',\n        params: { cluster: this.$store.getters['clusterId'], resource: HCI.SR_IOVGPU_DEVICE },\n      };\n    },\n\n    showEnableSRIOVGPUMessage() {\n      return this.rowsData.length === 0;\n    },\n\n    headers() {\n      const cols = [\n        STATE,\n        NAME,\n        {\n          name:  'address',\n          label: 'Address',\n          value: 'spec.gpuAddress',\n          sort:  ['spec.gpuAddress']\n        },\n        {\n          name:     'Configured Profile',\n          label:    'Configured Count',\n          labelKey: 'harvester.tableHeaders.configuredProfiles',\n          value:    'configuredProfiles',\n          sort:     ['configuredProfiles'],\n          align:    'center'\n        },\n        {\n          name:        'status',\n          label:       'Status',\n          labelKey:    'tableHeaders.status',\n          sort:        ['status.status'],\n          value:       'status.status',\n        },\n      ];\n\n      return cols;\n    },\n  }\n};\n</script>\n\n<template>\n  <Loading v-if=\"$fetchState.pending\" />\n  <div v-else-if=\"!hasAddonSchema\">\n    <Banner color=\"warning\">\n      {{ t('harvester.vgpu.noPermission') }}\n    </Banner>\n  </div>\n  <div v-else-if=\"!hasSriovgpuAddon || !hasPCIAddon\">\n    <Banner\n      v-if=\"!hasSriovgpuAddon\"\n      color=\"warning\"\n    >\n      <MessageLink\n        :to=\"toVGpuAddon\"\n        prefix-label=\"harvester.vgpu.goSetting.prefix\"\n        middle-label=\"harvester.vgpu.goSetting.middle\"\n        suffix-label=\"harvester.vgpu.goSetting.suffix\"\n      />\n    </Banner>\n    <Banner\n      v-if=\"!hasPCIAddon\"\n      color=\"warning\"\n    >\n      <MessageLink\n        :to=\"toPciAddon\"\n        prefix-label=\"harvester.pci.goSetting.prefix\"\n        middle-label=\"harvester.pci.goSetting.middle\"\n        suffix-label=\"harvester.pci.goSetting.suffix\"\n      />\n    </Banner>\n  </div>\n  <div v-else-if=\"hasSchema\">\n    <Banner\n      v-if=\"showEnableSRIOVGPUMessage\"\n      color=\"warning\"\n    >\n      <MessageLink\n        :to=\"sriovGPUPage\"\n        prefix-label=\"harvester.migconfiguration.goSriovGPU.prefix\"\n        middle-label=\"harvester.migconfiguration.goSriovGPU.middle\"\n        suffix-label=\"harvester.migconfiguration.goSriovGPU.suffix\"\n      />\n    </Banner>\n    <Banner\n      v-if=\"!showEnableSRIOVGPUMessage\"\n      color=\"warning\"\n      :label=\"t('harvester.migconfiguration.infoBanner')\"\n    />\n    <ResourceTable\n      v-bind=\"$attrs\"\n      :groupable=\"false\"\n      :namespaced=\"false\"\n      :headers=\"headers\"\n      :schema=\"schema\"\n      :rows=\"rowsData\"\n      key-field=\"_key\"\n    />\n  </div>\n</template>\n"]}]}