{"remainingRequest":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js??ruleSet[1].rules[4]!/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js??ruleSet[0].use[0]!/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js??ruleSet[0].use[1]!/home/ubuntu/essentials-ui-extension/pkg/harvester/dialog/ConfirmRelatedToRemoveDialog.vue?vue&type=template&id=a32a3442&scoped=true","dependencies":[{"path":"/home/ubuntu/essentials-ui-extension/pkg/harvester/dialog/ConfirmRelatedToRemoveDialog.vue","mtime":1773206911356},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js","mtime":1773205228903},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js","mtime":1773205228903}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["/home/ubuntu/essentials-ui-extension/pkg/harvester/dialog/ConfirmRelatedToRemoveDialog.vue"],"names":["t"],"mappings":";;qBAsKU,KAAK,EAAC,mBAAmB;qBAMxB,KAAK,EAAC,aAAa;;;EAOpB,KAAK,EAAC,OAAO;;qBAER,KAAK,EAAC,aAAa;qBAQnB,KAAK,EAAC,OAAO;qBAQb,KAAK,EAAC,iBAAiB;;;;;;;;;wBApCpC,aA+DO;IA9DL,KAAK,EAAC,gBAAgB;IACrB,uBAAqB,EAAE,KAAK;;IAElB,KAAK,WACd,CAEK;MAFL,oBAEK,MAFL,UAEK,mBADAA,MAAC,CAAC,cAAK,UAAI,aAAI;;IAIX,IAAI,WACb,CAmCM;MAnCN,oBAmCM,OAnCN,UAmCM;wBAlCJ,oBAEQ;kCADQ,uBAAc;;;SAItB,yBAAgB;2BADxB,oBAuBM,OAvBN,UAuBM;cAnBJ,oBAOM,OAPN,UAOM;gCANJ,oBAKQ;0CAJQA,MAAC;sBAA4D,sBAAa;6BAA+B,mBAAU,CAAC,oBAAW;;;;;cAMjJ,oBAEM,OAFN,UAEM;gBADJ,aAA2C,kCAArB,IAAI,EAAE,oBAAW;;;8BAEzC,oBAIE;gBAHA,EAAE,EAAC,SAAS;6EACH,iBAAW;gBACpB,IAAI,EAAC,MAAM;;8BADF,iBAAW;;;cAGtB,oBAEM,OAFN,UAEM,mBADD,eAAM;;;;2BAGb,oBAKE,6BAJqB,YAAM,GAAnB,KAAK,EAAE,CAAC;gCADlB,aAKE;YAHC,GAAG,EAAE,CAAC;YACN,KAAK,EAAE,KAAK;YACb,KAAK,EAAC,OAAO;;;;;IAKR,OAAO,WAChB,CAKS;MALT,oBAKS;QAJP,KAAK,EAAC,0BAA0B;QAC/B,OAAK,0CAAE,yCAAK;0BAEVA,MAAC;;MAEN,aAKE;QAJA,IAAI,EAAC,QAAQ;QACb,KAAK,EAAC,oBAAoB;QACzB,QAAQ,EAAE,uBAAc;QACxB,OAAK,EAAE,eAAM","sourcesContent":["<script>\nimport { mapState } from 'vuex';\nimport { exceptionToErrorsArray } from '@shell/utils/error';\nimport { alternateLabel } from '@shell/utils/platform';\nimport AsyncButton from '@shell/components/AsyncButton';\nimport { Banner } from '@components/Banner';\nimport { Card } from '@components/Card';\nimport { escapeHtml } from '@shell/utils/string';\nimport CopyToClipboardText from '@shell/components/CopyToClipboardText';\n\n/**\n * @name ConfirmRelatedToRemoveDialog\n * @description Dialog component to confirm the related resources before removing the resource.\n */\nexport default {\n  name: 'ConfirmRelatedToRemoveDialog',\n\n  emits: ['close'],\n\n  components: {\n    AsyncButton,\n    Banner,\n    Card,\n    CopyToClipboardText\n  },\n\n  props: {\n    /**\n     * @property resources to be deleted.\n     * @type {Resource[]} Array of the resource model's instance\n     */\n    resources: {\n      type:     Array,\n      required: true\n    },\n  },\n\n  data() {\n    return { errors: [], confirmName: '' };\n  },\n\n  computed: {\n    ...mapState('action-menu', ['modalData']),\n\n    title() {\n      return this.modalData?.title || 'dialog.promptRemove.title';\n    },\n\n    formattedType() {\n      return this.type.toLowerCase();\n    },\n\n    warningMessage() {\n      if (this.modalData?.warningMessage) return this.modalData.warningMessage;\n\n      const isPlural = this.type.endsWith('s');\n      const thisOrThese = isPlural ? 'these' : 'this';\n      const defaultMessage = this.t('dialog.promptRemove.warningMessage', {\n        type: this.formattedType,\n        thisOrThese,\n      });\n\n      return defaultMessage;\n    },\n\n    names() {\n      return this.resources.map((obj) => obj.nameDisplay).slice(0, 5);\n    },\n\n    resourceNames() {\n      return this.names.reduce((res, name, i) => {\n        if (i >= 5) {\n          return res;\n        }\n        res += `<b>${ escapeHtml(name) }</b>`;\n        if (i === this.names.length - 1) {\n          res += this.plusMore;\n        } else {\n          res += i === this.resources.length - 2 ? ' and ' : ', ';\n        }\n\n        return res;\n      }, '');\n    },\n\n    nameToMatch() {\n      return this.resources[0].nameDisplay;\n    },\n\n    needConfirmation() {\n      const { needConfirmation = true } = this.modalData ;\n\n      return needConfirmation === true;\n    },\n\n    plusMore() {\n      const remaining = this.resources.length - this.names.length;\n\n      return this.t('promptRemove.andOthers', { count: remaining });\n    },\n\n    type() {\n      const types = new Set(this.resources.reduce((array, each) => {\n        array.push(each.type);\n\n        return array;\n      }, []));\n\n      if (types.size > 1) {\n        return this.t('generic.resource', { count: this.resources.length });\n      }\n\n      const schema = this.resources[0]?.schema;\n\n      if ( !schema ) {\n        return `resource${ this.resources.length === 1 ? '' : 's' }`;\n      }\n\n      return this.$store.getters['type-map/labelFor'](schema, this.resources.length);\n    },\n\n    deleteDisabled() {\n      if (!this.needConfirmation) {\n        return false;\n      }\n\n      return this.confirmName !== this.nameToMatch;\n    },\n\n    protip() {\n      return this.t('dialog.promptRemove.protip', { alternateLabel });\n    },\n  },\n\n  methods: {\n    escapeHtml,\n\n    close() {\n      this.confirmName = '';\n      this.errors = [];\n      this.$emit('close');\n    },\n\n    async remove(buttonDone) {\n      try {\n        for (const resource of this.resources) {\n          await resource.remove();\n          if (this.modalData?.extraActionAfterRemove) await this.modalData.extraActionAfterRemove();\n        }\n        buttonDone(true);\n        this.close();\n      } catch (e) {\n        this.errors = exceptionToErrorsArray(e);\n        buttonDone(false);\n      }\n    }\n  }\n};\n</script>\n\n<template>\n  <Card\n    class=\"prompt-related\"\n    :show-highlight-border=\"false\"\n  >\n    <template #title>\n      <h4 class=\"text-default-text\">\n        {{ t(title, { type }, true) }}\n      </h4>\n    </template>\n\n    <template #body>\n      <div class=\"pl-10 pr-10\">\n        <span\n          v-clean-html=\"warningMessage\"\n        ></span>\n\n        <div\n          v-if=\"needConfirmation\"\n          class=\"mt-20\"\n        >\n          <div class=\"mt-10 mb-10\">\n            <span\n              v-clean-html=\"t('dialog.promptRemove.confirmName', {\n                type: formattedType,\n                nameToMatch: escapeHtml(nameToMatch)\n              }, true)\"\n            ></span>\n          </div>\n          <div class=\"mb-10\">\n            <CopyToClipboardText :text=\"nameToMatch\" />\n          </div>\n          <input\n            id=\"confirm\"\n            v-model=\"confirmName\"\n            type=\"text\"\n          />\n          <div class=\"text-info mt-20\">\n            {{ protip }}\n          </div>\n        </div>\n        <Banner\n          v-for=\"(error, i) in errors\"\n          :key=\"i\"\n          :label=\"error\"\n          color=\"error\"\n        />\n      </div>\n    </template>\n\n    <template #actions>\n      <button\n        class=\"btn role-secondary mr-10\"\n        @click=\"close\"\n      >\n        {{ t('generic.cancel') }}\n      </button>\n      <AsyncButton\n        mode=\"delete\"\n        class=\"btn bg-error ml-10\"\n        :disabled=\"deleteDisabled\"\n        @click=\"remove\"\n      />\n    </template>\n  </Card>\n</template>\n\n<style lang='scss' scoped>\n  .actions {\n    text-align: right;\n  }\n</style>\n"]}]}