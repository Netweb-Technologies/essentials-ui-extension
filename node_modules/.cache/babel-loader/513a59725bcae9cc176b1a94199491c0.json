{"remainingRequest":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js??ruleSet[1].rules[4]!/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js??ruleSet[0].use[0]!/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js??ruleSet[0].use[1]!/home/ubuntu/essentials-ui-extension/node_modules/@rancher/shell/components/formatter/Date.vue?vue&type=template&id=4fe9b6d4","dependencies":[{"path":"/home/ubuntu/essentials-ui-extension/node_modules/@rancher/shell/components/formatter/Date.vue","mtime":1773205215283},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js","mtime":1773205228903},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js","mtime":1773205228903}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["/home/ubuntu/essentials-ui-extension/node_modules/@rancher/shell/components/formatter/Date.vue"],"names":[],"mappings":";;;;;;wBAiEE,aAOY,yBAPI,cAAO;sBAlBZ,CAIe;OAeR,eAAQ;yBAAxB,oBAEW;8CADN,aAAI;aAAa,gBAAS;+BAAnB,oBAAqB;+BAAA,oBAA0B,oBAAb,GAAM;;;;OAEpC,eAAQ;yBAAxB,oBAEW;8CADN,aAAI","sourcesContent":["<script>\nimport day from 'dayjs';\nimport { DATE_FORMAT, TIME_FORMAT } from '@shell/store/prefs';\nimport { escapeHtml } from '@shell/utils/string';\n\nexport default {\n  props: {\n    tagName: {\n      type:    String,\n      default: 'span',\n    },\n\n    value: {\n      type:    [String, Date, Number],\n      default: ''\n    },\n\n    multiline: {\n      type:    Boolean,\n      default: false,\n    },\n\n    emptyTextKey: {\n      type:    String,\n      default: ''\n    },\n\n    showDate: {\n      type:    Boolean,\n      default: true,\n    },\n\n    showTime: {\n      type:    Boolean,\n      default: true,\n    },\n\n  },\n\n  computed: {\n\n    date() {\n      if ( !this.value ) {\n        return this.emptyTextKey ? this.$store.getters['i18n/t'](this.emptyTextKey) : '';\n      }\n\n      const dateFormat = escapeHtml( this.$store.getters['prefs/get'](DATE_FORMAT));\n\n      return day(this.value).format(dateFormat);\n    },\n\n    time() {\n      if ( !this.value ) {\n        return '';\n      }\n\n      const timeFormat = escapeHtml( this.$store.getters['prefs/get'](TIME_FORMAT));\n\n      return day(this.value).format(timeFormat);\n    }\n  },\n};\n</script>\n\n<template>\n  <component :is=\"tagName\">\n    <template v-if=\"showDate\">\n      {{ date }}<br v-if=\"multiline\"><span v-else>&nbsp;</span>\n    </template>\n    <template v-if=\"showTime\">\n      {{ time }}\n    </template>\n  </component>\n</template>\n"]}]}