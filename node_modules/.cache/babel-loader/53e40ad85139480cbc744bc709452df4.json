\n          label:       'VF Addresses',\n          labelKey:    'harvester.sriov.vfAddresses',\n          sort:        ['status.vfAddresses'],\n          value:       'status.vfAddresses',\n          formatter:   'HarvesterVFAddress',\n          align:       'center',\n          dashIfEmpty: true,\n        },\n        {\n          ...AGE,\n          sort: 'metadata.creationTimestamp:desc',\n        }\n      ];\n\n      if (this.hasNode) {\n        cols.splice(-1, 0, nodeCol);\n      }\n\n      return cols;\n    },\n  }\n};\n</script>\n\n<template>\n  <ResourceTable\n    v-bind=\"$attrs\"\n    :groupable=\"false\"\n    :namespaced=\"false\"\n    :headers=\"headers\"\n    :schema=\"schema\"\n    :rows=\"rows\"\n    key-field=\"_key\"\n  />\n</template>\n"]}]}