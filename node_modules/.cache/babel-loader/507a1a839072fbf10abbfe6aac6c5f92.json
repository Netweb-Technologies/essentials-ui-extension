{"remainingRequest":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js??ruleSet[1].rules[4]!/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js??ruleSet[0].use[0]!/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js??ruleSet[0].use[1]!/home/ubuntu/essentials-ui-extension/pkg/harvester/components/FilterVMSchedule.vue?vue&type=template&id=1994dff6&scoped=true","dependencies":[{"path":"/home/ubuntu/essentials-ui-extension/pkg/harvester/components/FilterVMSchedule.vue","mtime":1773206911345},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js","mtime":1773205228903},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js","mtime":1773205228903}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["/home/ubuntu/essentials-ui-extension/pkg/harvester/components/FilterVMSchedule.vue"],"names":["t"],"mappings":";;qBAqEI,KAAK,EAAC,oBAAoB;;;EAIxB,KAAK,EAAC,wBAAwB;;;qBA0BvB,KAAK,EAAC,cAAc;;;;;;wBA/B/B,oBA2CM,OA3CN,UA2CM;KAvCI,cAAQ;uBADhB,oBASO,QATP,UASO;4CALFA,MAAC,0DAA2C,cAAQ,SAAS,cAAQ,UAAS,GACjF;UAAA,oBAGE;YAFA,KAAK,EAAC,sBAAsB;YAC3B,OAAK,0CAAE,2CAAM;;;;;IAGlB,aA6Ba;MA5BX,cAAY,EAAC,sBAAsB;MAClC,QAAQ,EAAE,wBAAe,CAAC,MAAM;MACjC,SAAS,EAAC,YAAY;MACtB,MAAM,EAAC,GAAG;MACT,QAAQ,EAAE,EAAE;;MAYF,MAAM,WACf,CASM;QATN,oBASM,OATN,UASM;UARJ,aAOE;YANQ,KAAK,EAAE,cAAQ;;oDAAR,cAAQ;cAKR,iBAAQ;;YAJvB,KAAK,EAAC,aAAa;YACnB,IAAI,EAAC,OAAO;YACX,OAAO,EAAE,wBAAe;YACxB,MAAM,EAAE,wBAAe;;;;wBAjB9B,CAQS;QART,oBAQS;UAPP,GAAG,EAAC,gBAAgB;UACpB,KAAK,EAAC,sBAAsB;UAC3B,QAAQ,GAAG,2BAAkB;;UAE9B,YAEO,0BAFP,CAEO;8CADFA,MAAC","sourcesContent":["<script>\nimport { RadioGroup } from '@components/Form/Radio';\n\nexport default {\n  name: 'HarvesterFilterVMSchedule',\n\n  emits: ['change-rows'],\n\n  components: { RadioGroup },\n\n  props: {\n    rows: {\n      type:     Array,\n      required: true,\n    },\n  },\n\n  data() {\n    return { selected: '' };\n  },\n\n  computed: {\n    scheduleOptions() {\n      const options = this.rows.map((r) => r.sourceSchedule).filter((r) => r);\n\n      return Array.from(new Set(options));\n    },\n    enableFilterButton() {\n      return this.rows.some((r) => r.sourceSchedule !== undefined);\n    }\n  },\n\n  methods: {\n    onSelect(selected) {\n      this.selected = selected;\n      this.filterRows();\n    },\n\n    remove() {\n      this.selected = '';\n      this.filterRows();\n    },\n\n    filterRows() {\n      if (!this.selected) {\n        this.$emit('change-rows', this.rows);\n\n        return;\n      }\n      const filteredRows = this.rows.filter((row) => row.sourceSchedule === this.selected);\n\n      this.$emit('change-rows', filteredRows, this.selected);\n    }\n  },\n\n  watch: {\n    rows: {\n      deep:      true,\n      immediate: false,\n      handler() {\n        this.filterRows();\n      }\n    }\n  }\n};\n</script>\n\n<template>\n  <div\n    class=\"vm-schedule-filter\"\n  >\n    <span\n      v-if=\"selected\"\n      class=\"banner-item bg-warning\"\n    >\n      {{ t('harvester.tableHeaders.vmSchedule') }}{{ selected ? ` = ${selected}`: '' }}\n      <i\n        class=\"icon icon-close ml-5\"\n        @click=\"remove\"\n      />\n    </span>\n    <v-dropdown\n      popper-class=\"vm-schedule-dropdown\"\n      :triggers=\"scheduleOptions.length ? ['click'] : []\"\n      placement=\"bottom-end\"\n      offset=\"1\"\n      :distance=\"20\"\n    >\n      <button\n        ref=\"actionDropDown\"\n        class=\"btn bg-primary mr-10\"\n        :disabled=\"!enableFilterButton\"\n      >\n        <slot name=\"title\">\n          {{ t('harvester.fields.filterSchedule') }}\n        </slot>\n      </button>\n\n      <template #popper>\n        <div class=\"filter-popup\">\n          <RadioGroup\n            v-model:value=\"selected\"\n            class=\"mr-10 ml-10\"\n            name=\"model\"\n            :options=\"scheduleOptions\"\n            :labels=\"scheduleOptions\"\n            @update:value=\"onSelect\"\n          />\n        </div>\n      </template>\n    </v-dropdown>\n  </div>\n</template>\n\n<style lang=\"scss\">\n.vm-schedule-dropdown .v-popper__arrow-container {\n  display: none;\n}\n</style>\n\n<style lang=\"scss\" scoped>\n.vm-schedule-filter {\n  display: inline-block;\n\n  .banner-item {\n    display: inline-block;\n    font-size: 16px;\n    margin-right: 10px;\n    padding: 6px;\n    border-radius: 2px;\n\n    i {\n      cursor: pointer;\n      vertical-align: middle;\n    }\n  }\n}\n.filter-popup {\n  width: max-content;\n}\n\n</style>\n"]}]}