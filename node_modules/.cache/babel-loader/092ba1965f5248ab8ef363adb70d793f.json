{"remainingRequest":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js??ruleSet[1].rules[4]!/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js??ruleSet[0].use[0]!/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js??ruleSet[0].use[1]!/home/ubuntu/essentials-ui-extension/pkg/harvester/formatters/HarvesterVolumeState.vue?vue&type=template&id=40f37e8d&scoped=true","dependencies":[{"path":"/home/ubuntu/essentials-ui-extension/pkg/harvester/formatters/HarvesterVolumeState.vue","mtime":1773206911370},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js","mtime":1773205228903},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js","mtime":1773205228903}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["/home/ubuntu/essentials-ui-extension/pkg/harvester/formatters/HarvesterVolumeState.vue"],"names":[],"mappings":";;qBA4DS,KAAK,EAAC,OAAO;qBAYT,KAAK,EAAC,iBAAiB;;;;;;;;wBAvBlC,oBA6BO;IA5BL,oBASM;OAPI,qBAAY;yCADpB,aAOE;;YAJC,MAAM,EAAE,mBAAU;YAClB,GAAG,EAAE,CAAC;YACN,GAAG,EAAE,GAAG;YACT,KAAK,EAAC,OAAO;;uCAJI,0BAAiB;;;;;IAOtC,oBAiBM,OAjBN,UAiBM;MAhBJ,aAA0B,0BAAZ,GAAG,EAAE,UAAG;;SAEZ,uBAAc;yBADxB,aAca;;YAZX,OAAO,EAAC,OAAO;YACf,MAAM,EAAC,IAAI;;YAMA,MAAM,WACf,CAEI;cAFJ,oBAEI,KAFJ,UAEI,mBADC,uBAAc;;8BANrB,CAEO;wCAFP,oBAEO,UAFD,KAAK,EAAC,gBAAgB;gBAC1B,oBAAoD,OAAjD,KAAK,EAAC,wCAAwC","sourcesContent":["<script>\nimport ProgressBarMulti from '@shell/components/ProgressBarMulti';\nimport { HCI as HCI_ANNOTATIONS } from '@pkg/harvester/config/labels-annotations';\nimport VolumeState from '@shell/components/formatter/BadgeStateFormatter';\n\nexport default {\n  components: { VolumeState, ProgressBarMulti },\n  props:      {\n    row: {\n      type:     Object,\n      required: true\n    },\n  },\n\n  computed: {\n    warningMessage() {\n      return this.row.relatedPV?.metadata?.annotations?.[HCI_ANNOTATIONS.VOLUME_ERROR];\n    },\n\n    rebuildStatus() {\n      return this.row.longhornEngine?.status?.rebuildStatus;\n    },\n\n    isRebuilding() {\n      return this.rebuildStatus && Object.keys(this.rebuildStatus).length > 0;\n    },\n\n    percentage() {\n      if (!this.isRebuilding) {\n        return;\n      }\n\n      const rebuildStatus = Object.values(this.rebuildStatus)?.[0];\n      const value = rebuildStatus?.progress;\n\n      return [{\n        value,\n        color: 'bg-warning'\n      }];\n    },\n\n    rebuildingMessage() {\n      return this.$store.getters['i18n/t']('harvester.volume.rebuildingMessage', { percentage: this.percentage[0].value });\n    }\n  },\n};\n</script>\n\n<template>\n  <span>\n    <div>\n      <ProgressBarMulti\n        v-if=\"isRebuilding\"\n        v-clean-tooltip=\"rebuildingMessage\"\n        :values=\"percentage\"\n        :min=\"0\"\n        :max=\"100\"\n        class=\"mb-10\"\n      />\n    </div>\n    <div class=\"state\">\n      <VolumeState :row=\"row\" />\n      <v-dropdown\n        v-if=\"!!warningMessage\"\n        trigger=\"hover\"\n        offset=\"16\"\n      >\n        <span class=\"tooltip-target\">\n          <i class=\"icon icon-warning icon-lg text-warning\" />\n        </span>\n\n        <template #popper>\n          <p class=\"warning-message\">\n            {{ warningMessage }}\n          </p>\n        </template>\n      </v-dropdown>\n    </div>\n  </span>\n</template>\n\n<style lang=\"scss\" scoped>\n.state {\n  display: flex;\n\n  .icon-warning {\n    margin-top: 2px;\n  }\n}\n.warning-message:first-letter {\n  text-transform: uppercase;\n}\n\n</style>\n"]}]}