{"remainingRequest":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js??ruleSet[1].rules[4]!/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js??ruleSet[0].use[0]!/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js??ruleSet[0].use[1]!/home/ubuntu/essentials-ui-extension/pkg/harvester/dialog/HarvesterQuotaDialog.vue?vue&type=template&id=dafb6452&scoped=true","dependencies":[{"path":"/home/ubuntu/essentials-ui-extension/pkg/harvester/dialog/HarvesterQuotaDialog.vue","mtime":1773206911357},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js","mtime":1773205228903},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js","mtime":1773205228903}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["/home/ubuntu/essentials-ui-extension/pkg/harvester/dialog/HarvesterQuotaDialog.vue"],"names":["t"],"mappings":";;qBAgFQ,KAAK,EAAC,mBAAmB;qBA2BtB,KAAK,EAAC,SAAS;qBACb,KAAK,EAAC,SAAS;;;;;;;;;wBAhC1B,aA2CO,mBA3CA,uBAAqB,EAAE,KAAK;IACtB,KAAK,WACd,CAGE;sBAHF,oBAGE,MAHF,UAGE;gCAFcA,MAAC;;;IAKR,IAAI,WACb,CAES;MAFT,aAES,qBAFD,KAAK,EAAC,MAAM;0BAClB,CAA8C;4CAA3CA,MAAC;;;;;MAEN,aASE;QARQ,KAAK,EAAE,uBAAiB;gEAAjB,uBAAiB;QAC/B,KAAK,EAAEA,MAAC;QACR,QAAQ,EAAE,KAAK;QACf,gBAAc,EAAE,CAAC;QACjB,SAAS,EAAE,IAAI;QACf,iBAAe,EAAE,IAAI;QACrB,MAAM,EAAE,cAAQ;QACjB,KAAK,EAAC,OAAO;;;yBAEf,oBAKE,6BAJmB,YAAM,GAAjB,GAAG,EAAE,CAAC;8BADhB,aAKE;UAHC,GAAG,EAAE,CAAC;UACP,KAAK,EAAC,OAAO;UACZ,KAAK,EAAE,GAAG;;;;IAIJ,OAAO,WAChB,CAUM;MAVN,oBAUM,OAVN,UAUM;QATJ,oBAQM,OARN,UAQM;UAPJ,oBAKS;YAJP,KAAK,EAAC,0BAA0B;YAC/B,OAAK,0CAAE,yCAAK;8BAEVA,MAAC;;UAEN,aAA6B,0BAAf,OAAK,EAAE,aAAI","sourcesContent":["<script>\nimport { mapGetters, mapState } from 'vuex';\nimport { Card } from '@components/Card';\nimport { Banner } from '@components/Banner';\nimport AsyncButton from '@shell/components/AsyncButton';\nimport UnitInput from '@shell/components/form/UnitInput';\nimport { exceptionToErrorsArray } from '@shell/utils/error';\nimport { GIBIBYTE } from '../utils/unit';\n\nexport default {\n  name: 'HarvesterVMQuotaDialog',\n\n  components: {\n    AsyncButton,\n    Card,\n    UnitInput,\n    Banner\n  },\n\n  props: {\n    resources: {\n      type:     Array,\n      required: true\n    }\n  },\n\n  created() {\n    this.totalSnapshotSize = this.modalData.snapshotSizeQuota;\n  },\n\n  data() {\n    return {\n      GIBIBYTE,\n      totalSnapshotSize: '',\n      errors:            []\n    };\n  },\n\n  computed: {\n    ...mapState('action-menu', ['modalData']),\n    ...mapGetters({ t: 'i18n/t' }),\n\n    actionResource() {\n      return this.resources[0];\n    },\n  },\n\n  methods: {\n    close() {\n      this.totalSnapshotSize = '';\n      this.$emit('close');\n    },\n\n    async save(buttonDone) {\n      try {\n        // call delete action if user input 0Gi or empty string\n        if (this.totalSnapshotSize === null || this.totalSnapshotSize === '0Gi' ) {\n          await this.actionResource.doAction('deleteResourceQuota');\n        } else {\n          await this.actionResource.doAction('updateResourceQuota', { totalSnapshotSizeQuota: this.totalSnapshotSize });\n        }\n        this.close();\n        buttonDone(true);\n      } catch (err) {\n        const error = err?.data || err;\n        const message = exceptionToErrorsArray(error);\n\n        this['errors'] = message;\n        buttonDone(false);\n      }\n    },\n  }\n};\n</script>\n\n<template>\n  <Card :show-highlight-border=\"false\">\n    <template #title>\n      <h4\n        v-clean-html=\"t('harvester.modal.quota.editQuota')\"\n        class=\"text-default-text\"\n      />\n    </template>\n\n    <template #body>\n      <Banner color=\"info\">\n        {{ t('harvester.modal.quota.bannerMessage') }}\n      </Banner>\n      <UnitInput\n        v-model:value=\"totalSnapshotSize\"\n        :label=\"t('harvester.snapshot.totalSnapshotSize')\"\n        :disabled=\"false\"\n        :input-exponent=\"3\"\n        :increment=\"1024\"\n        :output-modifier=\"true\"\n        :suffix=\"GIBIBYTE\"\n        class=\"mb-20\"\n      />\n      <Banner\n        v-for=\"(err, i) in errors\"\n        :key=\"i\"\n        color=\"error\"\n        :label=\"err\"\n      />\n    </template>\n\n    <template #actions>\n      <div class=\"actions\">\n        <div class=\"buttons\">\n          <button\n            class=\"btn role-secondary mr-10\"\n            @click=\"close\"\n          >\n            {{ t('generic.cancel') }}\n          </button>\n          <AsyncButton @click=\"save\" />\n        </div>\n      </div>\n    </template>\n  </Card>\n</template>\n\n<style lang=\"scss\" scoped>\n.actions {\n  width: 100%;\n}\n\n.buttons {\n  display: flex;\n  justify-content: flex-end;\n  width: 100%;\n}\n</style>\n"]}]}