{"remainingRequest":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js??ruleSet[1].rules[4]!/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js??ruleSet[0].use[0]!/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js??ruleSet[0].use[1]!/home/ubuntu/essentials-ui-extension/pkg/harvester/components/novnc/NovncConsoleItem.vue?vue&type=template&id=323a06e4&scoped=true","dependencies":[{"path":"/home/ubuntu/essentials-ui-extension/pkg/harvester/components/novnc/NovncConsoleItem.vue","mtime":1773206911347},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js","mtime":1773205228903},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js","mtime":1773205228903}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["/home/ubuntu/essentials-ui-extension/pkg/harvester/components/novnc/NovncConsoleItem.vue"],"names":[],"mappings":";;qBAoDM,KAAK,EAAC,oDAAoD;;;;;;;;wBAA9D,oBAkCK,MAlCL,UAkCK;uBAjCH,oBAgCK,6BA/BmB,YAAK,GAAnB,IAAI,EAAE,GAAG;4BADnB,oBAgCK,QA9BF,GAAG,EAAE,GAAG;WAGC,IAAI,CAAC,IAAI;2BADnB,aAqBa;;cAnBX,SAAS,EAAC,aAAa;cACvB,OAAO,EAAC,OAAO;cACd,SAAS,EAAE,KAAK;;cAQN,MAAM,WACf,CAME;gBANF,aAME;kBALC,KAAK,EAAE,IAAI,CAAC,IAAI;kBAChB,IAAI,EAAE,WAAI;kBACV,GAAG,EAAE,UAAG;kBACR,QAAM,EAAE,gBAAO;kBACf,UAAS,EAAE,iBAAQ;;;gCAZxB,CAIwB;gBAJxB,oBAIwB;kBAHrB,KAAK,2BAAU,sBAAa,CAAC,GAAG,EAAE,UAAG,KAChC,WAAW;kBAChB,OAAK,aAAE,gBAAO,GAAG,GAAG,OAAE,UAAG;oCACxB,IAAI,CAAC,KAAK;;;;;;2BAahB,oBAIwB;;cAFtB,KAAK,EAAC,WAAW;cAChB,OAAK,aAAE,iBAAQ,CAAC,GAAG,EAAE,UAAG;gCACvB,IAAI,CAAC,KAAK","sourcesContent":["<script>\nexport default {\n  name: 'NovncConsoleItem',\n\n  emits: ['send-keys', 'update'],\n\n  props: {\n    items: {\n      type:     Object,\n      required: true,\n      default:  () => {\n        return {};\n      }\n    },\n\n    path: {\n      type:     Array,\n      required: true,\n      default:  () => {\n        return [];\n      }\n    },\n\n    pos: {\n      type:     Number,\n      required: true,\n      default:  0,\n    }\n  },\n\n  methods: {\n    keysDown(key, pos) {\n      this.addKeys({ key, pos });\n      this.$emit('send-keys');\n    },\n\n    addKeys({ key, pos }) {\n      this.$emit('update', { key, pos });\n    },\n\n    sendKeys() {\n      this.$emit('send-keys');\n    },\n\n    getOpenStatus(key, pos) {\n      return this.path[pos] === key;\n    }\n  }\n};\n</script>\n\n<template>\n  <ul class=\"list-unstyled dropdown combination-keys__container\">\n    <li\n      v-for=\"(item, key) in items\"\n      :key=\"key\"\n    >\n      <v-dropdown\n        v-if=\"!!item.keys\"\n        placement=\"right-start\"\n        trigger=\"click\"\n        :container=\"false\"\n      >\n        <span\n          :class=\"{ open: getOpenStatus(key, pos) }\"\n          class=\"p-10 hand\"\n          @click=\"addKeys({ key, pos })\"\n        >{{ item.label }}</span>\n\n        <template #popper>\n          <novnc-console-item\n            :items=\"item.keys\"\n            :path=\"path\"\n            :pos=\"pos+1\"\n            @update=\"addKeys\"\n            @send-keys=\"sendKeys\"\n          />\n        </template>\n      </v-dropdown>\n\n      <span\n        v-else\n        class=\"p-10 hand\"\n        @click=\"keysDown(key, pos)\"\n      >{{ item.label }}</span>\n    </li>\n  </ul>\n</template>\n\n<style lang=\"scss\" scoped>\n  .combination-keys__container {\n    max-width: 60px;\n\n    DIV, SPAN {\n      display: block;\n      text-align: center;\n    }\n\n    SPAN {\n      border-radius: 3px;\n\n      &:hover, &.open {\n        color: var(--primary-hover-text);\n        background: var(--primary-hover-bg);\n      }\n    }\n  }\n</style>\n"]}]}