{"remainingRequest":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js??ruleSet[1].rules[4]!/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js??ruleSet[0].use[0]!/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js??ruleSet[0].use[1]!/home/ubuntu/essentials-ui-extension/node_modules/@rancher/shell/pages/c/_cluster/manager/hostedprovider/index.vue?vue&type=template&id=555207c4","dependencies":[{"path":"/home/ubuntu/essentials-ui-extension/node_modules/@rancher/shell/pages/c/_cluster/manager/hostedprovider/index.vue","mtime":1773205215283},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js","mtime":1773205228903},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js","mtime":1773205228903}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["/home/ubuntu/essentials-ui-extension/node_modules/@rancher/shell/pages/c/_cluster/manager/hostedprovider/index.vue"],"names":["t"],"mappings":";;qBAiMa,KAAK,EAAC,KAAK;qBACT,KAAK,EAAC,KAAK;qBACR,KAAK,EAAC,OAAO;;;EAUnB,KAAK,EAAC,mCAAmC;;;;;;;;;wBAlDnD,oBAyDM;IAxDJ,aAKE;MAJC,MAAM,EAAE,YAAM;MACd,QAAQ,EAAE,cAAQ;MAClB,cAAY,EAAEA,MAAC;MACf,cAAY,EAAE,KAAK;;;IAEtB,aAIE;MAHA,KAAK,EAAC,SAAS;MACd,KAAK,EAAEA,MAAC;MACR,QAAQ,EAAE,KAAK;;;uBAElB,oBAOE,6BANmB,YAAM,GAAjB,GAAG,EAAE,CAAC;4BADhB,aAOE;QALC,GAAG,EAAE,CAAC;QACP,KAAK,EAAC,OAAO;QACZ,KAAK,EAAE,GAAG;QACV,QAAQ,EAAE,IAAI;QACd,OAAK,aAAE,mBAAU,CAAC,CAAC;;;;IAEtB,aAoCgB;MAnCb,MAAM,EAAE,YAAM;MACd,QAAQ,EAAE,cAAQ;MAClB,IAAI,EAAE,UAAI;MACV,OAAO,EAAE,gBAAO;MAChB,aAAW,EAAE,IAAI;MACjB,eAAa,EAAE,IAAI;MACnB,aAAW,EAAE,sBAAsB;MACpC,WAAS,EAAC,IAAI;;MAEH,YAAU,WACnB,CAIgB,CALM,GAAG;QACzB,aAIgB;UAHb,MAAM,GAAG,GAAG,CAAC,MAAM;;4BAEpB,CAAuB;8CAApB,qBAAY,CAAC,GAAG;;;;;MAGZ,WAAS,WAClB,CAgBM,CAjBe,GAAG;QACxB,oBAgBM,OAhBN,UAgBM;UAfJ,oBAQM,OARN,UAQM;YAPJ,oBAAyC,QAAzC,UAAyC,mBAAlB,GAAG,CAAC,IAAI;;aAEvB,GAAG,CAAC,KAAK;+BADjB,aAKgB;;kBAHd,MAAM,EAAC,OAAO;;oCAEd,CAAiC;sDAA9BA,MAAC;;;;;;;WAIA,GAAG,CAAC,WAAW;6BADvB,oBAKM,OALN,UAKM,mBADD,GAAG,CAAC,WAAW","sourcesContent":["<script>\nimport { MANAGEMENT, HOSTED_PROVIDER } from '@shell/config/types';\nimport { SETTING } from '@shell/config/settings';\nimport { STATE, NAME } from '@shell/config/table-headers';\nimport ResourceTable from '@shell/components/ResourceTable';\nimport Masthead from '@shell/components/ResourceList/Masthead';\nimport Banner from '@components/Banner/Banner.vue';\nimport RcStatusBadge from '@components/Pill/RcStatusBadge/RcStatusBadge.vue';\nimport { exceptionToErrorsArray } from '@shell/utils/error';\nimport { isRancherPrime } from '@shell/config/version';\nimport { stateDisplay, STATES_ENUM } from '@shell/plugins/dashboard-store/resource-class';\n\nexport default {\n  name:       'HostedProviders',\n  components: {\n    ResourceTable, Masthead, RcStatusBadge, Banner\n  },\n  data() {\n    return {\n      errors:          [],\n      rows:            [],\n      allProviders:    null,\n      resource:        HOSTED_PROVIDER,\n      schema:          this.$store.getters['rancher/schemaFor'](HOSTED_PROVIDER),\n      prime:           isRancherPrime(),\n      settingResource: null\n    };\n  },\n  fetch() {\n    this.allProviders = this.getProviders();\n    this.getSettings();\n    this.generateRows();\n  },\n  watch: {\n    settings() {\n      this.generateRows();\n    },\n    allProviders() {\n      this.generateRows();\n    }\n  },\n  computed: {\n    headers() {\n      return [\n        STATE,\n        NAME,\n      ];\n    },\n    settings() {\n      const providerTypesJSON = this.settingResource?.value;\n      const providerTypes = providerTypesJSON ? JSON.parse(providerTypesJSON) : [];\n      const settingsDict = {};\n\n      providerTypes.forEach((p) => {\n        settingsDict[p.name] = p.active;\n      });\n\n      return settingsDict;\n    },\n\n  },\n  methods: {\n    getProviders() {\n      const context = {\n        dispatch:   this.$store.dispatch,\n        getters:    this.$store.getters,\n        axios:      this.$store.$axios,\n        $extension: this.$store.app.$extension,\n        t:          (...args) => this.t.apply(this, args),\n        isCreate:   this.isCreate,\n        isEdit:     this.isEdit,\n        isView:     this.isView,\n      };\n\n      return this.$extension.getProviders(context);\n    },\n    getSettings() {\n      this.settingResource = this.$store.getters['management/byId'](MANAGEMENT.SETTING, SETTING.KEV2_OPERATORS );\n    },\n    stateDisplay(row) {\n      if (!row.active) {\n        return stateDisplay(STATES_ENUM.INACTIVE);\n      }\n\n      return stateDisplay(STATES_ENUM.ACTIVE);\n    },\n    async setSetting(resources, active) {\n      try {\n        const providerTypes = this.settingResource.value ? JSON.parse(this.settingResource.value) : [];\n        const providerMap = new Map(providerTypes.map((prov) => [prov.name, prov]));\n\n        resources.forEach((resource) => {\n          const provider = providerMap.get(resource.id);\n\n          if (provider) {\n            provider.active = active;\n          } else {\n            providerMap.set(resource.id, { name: resource.id, active });\n          }\n        });\n\n        this.settingResource.value = JSON.stringify(Array.from(providerMap.values()));\n        await this.settingResource.save();\n        this.getSettings();\n      } catch (e) {\n        this.errors = exceptionToErrorsArray(e);\n      }\n    },\n    async generateRows() {\n      this.rows = this.allProviders.filter((p) => p.group === 'hosted').map((p) => {\n        const active = p.id in this.settings ? this.settings[p.id] : true;\n        const canNotPrime = p.prime && !this.prime;\n        const canNotChangeSettings = !this.settingResource?.canUpdate;\n        const enableAction = {\n          action:   'activate',\n          label:    this.t('action.activate'),\n          icon:     'icon icon-play',\n          bulkable: true,\n          enabled:  !active && !canNotPrime && !canNotChangeSettings,\n          invoke:   async(opts, resources) => {\n            await this.setSetting(resources, true);\n          }\n        };\n        const disableAction = {\n          action:   'deactivate',\n          label:    this.t('action.deactivate'),\n          icon:     'icon icon-pause',\n          bulkable: true,\n          enabled:  active && !canNotChangeSettings,\n          weight:   -1,\n          invoke:   async(opts, resources) => {\n            await this.setSetting(resources, false);\n          }\n        };\n        const availableActions = [enableAction, disableAction];\n\n        return {\n          id:          p.id,\n          name:        p.label,\n          nameDisplay: p.label,\n          description: p.description || '',\n          prime:       p.prime,\n          active,\n          availableActions\n        };\n      }) || [];\n    },\n    closeError(index) {\n      this.errors.splice(index, 1);\n    },\n  },\n};\n</script>\n\n<template>\n  <div>\n    <Masthead\n      :schema=\"schema\"\n      :resource=\"resource\"\n      :type-display=\"t('providers.hosted.title')\"\n      :is-creatable=\"false\"\n    />\n    <Banner\n      color=\"warning\"\n      :label=\"t('providers.hosted.warning')\"\n      :closable=\"false\"\n    />\n    <Banner\n      v-for=\"(err, i) in errors\"\n      :key=\"i\"\n      color=\"error\"\n      :label=\"err\"\n      :closable=\"true\"\n      @close=\"closeError(i)\"\n    />\n    <ResourceTable\n      :schema=\"schema\"\n      :resource=\"resource\"\n      :rows=\"rows\"\n      :headers=\"headers\"\n      :row-actions=\"true\"\n      :table-actions=\"true\"\n      :data-testid=\"'hosted-provider-list'\"\n      key-field=\"id\"\n    >\n      <template #cell:state=\"{row}\">\n        <RcStatusBadge\n          :status=\"!row.active ? 'error' : 'success'\"\n        >\n          {{ stateDisplay(row) }}\n        </RcStatusBadge>\n      </template>\n      <template #cell:name=\"{row}\">\n        <div class=\"col\">\n          <div class=\"row\">\n            <span class=\"mr-10\">{{ row.name }}</span>\n            <RcStatusBadge\n              v-if=\"row.prime\"\n              status=\"prime\"\n            >\n              {{ t('providers.hosted.prime') }}\n            </RcStatusBadge>\n          </div>\n          <div\n            v-if=\"row.description\"\n            class=\"description text-muted text-small\"\n          >\n            {{ row.description }}\n          </div>\n        </div>\n      </template>\n    </ResourceTable>\n  </div>\n</template>\n"]}]}