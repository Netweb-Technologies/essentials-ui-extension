{"remainingRequest":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js??ruleSet[1].rules[4]!/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js??ruleSet[0].use[0]!/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js??ruleSet[0].use[1]!/home/ubuntu/essentials-ui-extension/pkg/harvester/formatters/HarvesterCPUUsed.vue?vue&type=template&id=66a21b0a&scoped=true","dependencies":[{"path":"/home/ubuntu/essentials-ui-extension/pkg/harvester/formatters/HarvesterCPUUsed.vue","mtime":1773206911370},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js","mtime":1773205228903},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js","mtime":1773205228903}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["/home/ubuntu/essentials-ui-extension/pkg/harvester/formatters/HarvesterCPUUsed.vue"],"names":["t"],"mappings":";;qBA4Fc,KAAK,EAAC,cAAc;qBAElB,KAAK,EAAC,kBAAkB;;;EAOlC,KAAK,EAAC,OAAO;;qBAWH,KAAK,EAAC,cAAc;qBAElB,KAAK,EAAC,kBAAkB;;;;;wBAjCxC,oBAuCM;IAtCJ,aAgBmB;MAfhB,QAAQ,EAAE,iBAAQ;MAClB,IAAI,EAAE,iBAAQ;MACd,KAAK,EAAE,iBAAQ;MACf,eAAa,EAAE,mBAAY;;MAEjB,KAAK,WACd,CAEO,CAHU,oBAAoB,EAAE,mBAAmB;QAC1D,oBAEO,+BADFA,MAAC;;QAEN,oBAIO,QAJP,UAIO;4CAHFA,MAAC,+CAA+C,oBAAoB,KAAI,GAC3E;UAAA,oBACO,QADP,UACO,EADwB,IAAO,oBAAG,mBAAmB;;;;;;KAM1D,eAAQ;uBADhB,oBAoBM,OApBN,UAoBM;UAhBJ,aAemB;YAdhB,QAAQ,EAAE,iBAAQ;YAClB,IAAI,EAAE,aAAI;YACV,KAAK,EAAE,iBAAQ;;YAEL,KAAK,WACd,CAEO,CAHU,oBAAoB,EAAE,mBAAmB;cAC1D,oBAEO,+BADFA,MAAC;;cAEN,oBAIO,QAJP,UAIO;kDAHFA,MAAC,+CAA+C,oBAAoB,KAAI,GAC3E;gBAAA,oBACO,QADP,UACO,EADwB,IAAO,oBAAG,mBAAmB","sourcesContent":["<script>\nimport ConsumptionGauge from '@shell/components/ConsumptionGauge';\nimport { METRIC, NODE } from '@shell/config/types';\nimport { parseSi } from '@shell/utils/units';\n\nexport default {\n  name:       'HarvesterCpuUsed',\n  components: { ConsumptionGauge },\n\n  props: {\n    value: {\n      type:    String,\n      default: ''\n    },\n\n    row: {\n      type:     Object,\n      required: true\n    },\n\n    resourceName: {\n      type:    String,\n      default: ''\n    },\n\n    showUsed: {\n      type:    Boolean,\n      default: false,\n    },\n  },\n\n  data() {\n    return {};\n  },\n\n  computed: {\n    metrics() {\n      return this.$store.getters['harvester/byId'](METRIC.NODE, this.row.id);\n    },\n\n    cpuTotal() {\n      let out = 0;\n\n      if (this.metrics) {\n        out = this.metrics.cpuCapacity;\n      }\n\n      return out;\n    },\n\n    cpuUnits() {\n      return 'C';\n    },\n\n    node() {\n      const inStore = this.$store.getters['currentProduct'].inStore;\n      const node = this.$store.getters[`${ inStore }/byId`](NODE, this.row.id);\n\n      return node;\n    },\n\n    reserved() {\n      if (this.metrics) {\n        return this.node.cpuReserved;\n      } else {\n        return 0;\n      }\n    },\n\n    used() {\n      if (this.metrics) {\n        return parseSi(this.metrics?.usage?.cpu || '0m');\n      } else {\n        return 0;\n      }\n    },\n  }\n};\n</script>\n\n<template>\n  <div>\n    <ConsumptionGauge\n      :capacity=\"cpuTotal\"\n      :used=\"reserved\"\n      :units=\"cpuUnits\"\n      :resource-name=\"resourceName\"\n    >\n      <template #title=\"{amountTemplateValues, formattedPercentage}\">\n        <span>\n          {{ t('harvester.formatters.hardwareResourceGauge.reserved') }}\n        </span>\n        <span class=\"precent-data\">\n          {{ t('node.detail.glance.consumptionGauge.amount', amountTemplateValues) }}\n          <span class=\"ml-10 percentage\">/&nbsp;{{ formattedPercentage }}\n          </span>\n        </span>\n      </template>\n    </ConsumptionGauge>\n    <div\n      v-if=\"showUsed\"\n      class=\"mt-10\"\n    >\n      <ConsumptionGauge\n        :capacity=\"cpuTotal\"\n        :used=\"used\"\n        :units=\"cpuUnits\"\n      >\n        <template #title=\"{amountTemplateValues, formattedPercentage}\">\n          <span>\n            {{ t('harvester.formatters.hardwareResourceGauge.used') }}\n          </span>\n          <span class=\"precent-data\">\n            {{ t('node.detail.glance.consumptionGauge.amount', amountTemplateValues) }}\n            <span class=\"ml-10 percentage\">/&nbsp;{{ formattedPercentage }}\n            </span>\n          </span>\n        </template>\n      </ConsumptionGauge>\n    </div>\n  </div>\n</template>\n\n<style lang=\"scss\" scoped>\n.precent-data {\n  white-space: nowrap;\n}\n</style>\n"]}]}