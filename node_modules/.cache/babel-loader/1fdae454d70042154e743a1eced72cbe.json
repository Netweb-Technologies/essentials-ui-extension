CtB,QAAQ,EAAE,IAAI;kBACd,KAAK,EAAEA,MAAC;kBACR,WAAW,EAAEA,MAAC;;;;cAInB,oBAWM,OAXN,UAWM;gBAVJ,aASE;kBARQ,KAAK,EAAE,GAAG,CAAC,SAAS;iDAAb,GAAG,CAAC,SAAS,aAOb,eAAM;kBANpB,IAAI,EAAE,WAAI;kBACV,OAAO,EAAE,yBAAgB;kBAC1B,KAAK,EAAC,MAAM;kBACX,QAAQ,EAAE,IAAI;kBACd,KAAK,EAAEA,MAAC;kBACR,WAAW,EAAEA,MAAC;;;;cAInB,oBAYM,OAZN,UAYM;gBAXJ,aAUE;kBATQ,KAAK,EAAS,GAAG,CAAC,QAAQ;iDAAZ,GAAG,CAAC,QAAQ,aAQnB,eAAM;kCARrB,gBAAmC;kBACnC,IAAI,EAAC,QAAQ;kBACb,KAAK,EAAC,YAAY;kBACjB,GAAG,EAAE,KAAK;kBACV,GAAG,EAAE,CAAC;kBACN,IAAI,EAAE,WAAI;kBACX,QAAQ,EAAR,EAAQ;kBACR,WAAS,EAAC,qCAAqC;;;;;YAKrD,oBAYM,OAZN,UAYM;cAXJ,oBAUM,OAVN,UAUM;gBATJ,aAQE;kBAPQ,KAAK,EAAE,GAAG,CAAC,KAAK;iDAAT,GAAG,CAAC,KAAK,aAMT,eAAM;kBALrB,KAAK,EAAC,WAAW;kBAChB,IAAI,EAAE,WAAI;kBACX,QAAQ,EAAR,EAAQ;kBACP,WAAW,EAAEA,MAAC;kBACf,WAAS,EAAC,kCAAkC;;;;;;;;;;;IAOtD,oBAOS;MANP,IAAI,EAAC,QAAQ;MACb,KAAK,EAAC,uBAAuB;MAC5B,QAAQ,EAAE,eAAM;MAChB,OAAK,uCAAE,YAAG;;MAEX,aAAsC,gBAAnC,CAAC,EAAC,8BAA8B","sourcesContent":["<script>\nimport debounce from 'lodash/debounce';\nimport { _EDIT, _VIEW } from '@shell/config/query-params';\nimport { removeAt } from '@shell/utils/array';\nimport { Banner } from '@components/Banner';\nimport InfoBox from '@shell/components/InfoBox';\nimport LabeledSelect from '@shell/components/form/LabeledSelect';\nimport { LabeledInput } from '@components/Form/LabeledInput';\n\nexport default {\n  name: 'AccessControlList',\n\n  emits: ['update:value'],\n\n  components: {\n    Banner, InfoBox, LabeledSelect, LabeledInput\n  },\n\n  props: {\n    value: {\n      type:    Array,\n      default: null,\n    },\n    mode: {\n      type:    String,\n      default: _EDIT,\n    },\n  },\n\n  data() {\n    const rows = (this.value || []).map((row) => {\n      return {\n        action:      row.action || '',\n        direction:   row.direction || '',\n        priority:    row.priority || 0,\n        match:       row.match || '',\n      };\n    });\n\n    return { rows };\n  },\n\n  computed: {\n    isView() {\n      return this.mode === _VIEW;\n    },\n\n    actionOptions() {\n      return [\n        { label: 'Allow', value: 'allow' },\n        { label: 'Drop', value: 'drop' },\n        { label: 'Pass', value: 'pass' },\n        { label: 'Reject', value: 'reject' },\n        { label: 'Allow-related', value: 'allow-related' },\n        { label: 'Allow-stateless', value: 'allow-stateless' },\n      ];\n    },\n    directionOptions() {\n      return [\n        { label: 'To-lport', value: 'to-lport' },\n        { label: 'From-lport', value: 'from-lport' },\n      ];\n    }\n  },\n\n  created() {\n    this.queueUpdate = debounce(this.update, 100);\n  },\n\n  methods: {\n    add() {\n      this.rows.push({\n        action:      '',\n        direction:   '',\n        priority:  this.rows.length,\n        match:      '',\n      });\n      this.queueUpdate();\n    },\n\n    removeRule(idx) {\n      removeAt(this.rows, idx);\n      this.queueUpdate();\n    },\n\n    update() {\n      if (this.isView) {\n        return;\n      }\n\n      this.$emit('update:value', this.rows);\n    }\n  },\n};\n</script>\n\n<template>\n  <div>\n    <Banner\n      v-if=\"rows.length > 0\"\n      color=\"info\"\n    >\n      <t\n        k=\"harvester.subnet.acl.banner\"\n        :raw=\"true\"\n      />\n    </Banner>\n    <div\n      v-for=\"(row, idx) in rows\"\n      :key=\"idx\"\n    >\n      <InfoBox class=\"box\">\n        <button\n          type=\"button\"\n          class=\"role-link btn btn-sm removeBtn\"\n          :disabled=\"isView\"\n          @click=\"removeRule(idx)\"\n        >\n          <i class=\"icon icon-x\" />\n        </button>\n        <div class=\"row\">\n          <div class=\"col span-4\">\n            <LabeledSelect\n              v-model:value=\"row.action\"\n              :mode=\"mode\"\n              class=\"mt-5 ml-5\"\n              :options=\"actionOptions\"\n              :required=\"true\"\n              :label=\"t('harvester.subnet.acl.action.label')\"\n              :placeholder=\"t('harvester.subnet.acl.action.placeholder')\"\n              @update:value=\"update\"\n            />\n          </div>\n          <div class=\"col span-4\">\n            <LabeledSelect\n              v-model:value=\"row.direction\"\n              :mode=\"mode\"\n              :options=\"directionOptions\"\n              class=\"mt-5\"\n              :required=\"true\"\n              :label=\"t('harvester.subnet.acl.direction.label')\"\n              :placeholder=\"t('harvester.subnet.acl.direction.placeholder')\"\n              @update:value=\"update\"\n            />\n          </div>\n          <div class=\"col span-3\">\n            <LabeledInput\n              v-model:value.number=\"row.priority\"\n              type=\"number\"\n              class=\"mb-20 mt-5\"\n              :max=\"32767\"\n              :min=\"0\"\n              :mode=\"mode\"\n              required\n              label-key=\"harvester.subnet.acl.priority.label\"\n              @update:value=\"update\"\n            />\n          </div>\n        </div>\n        <div class=\"row\">\n          <div class=\"col span-11\">\n            <LabeledInput\n              v-model:value=\"row.match\"\n              class=\"mb-5 ml-5\"\n              :mode=\"mode\"\n              required\n              :placeholder=\"t('harvester.subnet.acl.match.placeholder')\"\n              label-key=\"harvester.subnet.acl.match.label\"\n              @update:value=\"update\"\n            />\n          </div>\n        </div>\n      </InfoBox>\n    </div>\n    <button\n      type=\"button\"\n      class=\"btn role-tertiary add\"\n      :disabled=\"isView\"\n      @click=\"add()\"\n    >\n      <t k=\"harvester.subnet.acl.addRule\" />\n    </button>\n  </div>\n</template>\n\n<style lang=\"scss\" scoped>\n  .box {\n    position: relative;\n  }\n  .removeBtn {\n    position: absolute;\n    top: 10px;\n    right: 10px;\n    padding: 0px;\n  }\n</style>\n"]}]}