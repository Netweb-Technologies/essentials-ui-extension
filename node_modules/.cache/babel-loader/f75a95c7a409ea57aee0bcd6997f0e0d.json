AAY,EAAC,gBAAgB;;;yBAInC,oBAEW;6BAFM,iBAEjB;;;KAEQ,oBAAW;uBADnB,aAoEa;;UAlEX,GAAG,EAAC,UAAU;UACd,SAAS,EAAC,cAAc;;UAEb,OAAO,WAChB,CAOgB;2CAPhB,aAOgB;cALd,MAAM,EAAC,MAAM;cACb,aAAW,EAAC,WAAW;cACtB,OAAK,2CAAN,QAAW;;gCAEX,CAAkD;kDAA/CA,MAAC,yBAAyB,yBAAgB;;;;yCAL5B,uBAAc;;;UAQxB,MAAM,WACf,CAkDM;YAlDN,oBAkDM,OAlDN,UAkDM;cA9CJ,oBAKS;gBAJP,KAAK,EAAC,yBAAyB;gBAC9B,OAAK,uCAAEC,UAAK,CAAC,QAAQ,CAAC,IAAI;;gBAE3B,oBAA6B,OAA1B,KAAK,EAAC,iBAAiB;;;eAGpB,6BAAoB,CAAC,MAAM;iCADnC,oBAmBM,OAnBN,UAmBM;oBAdJ,oBAAuC,6BAAhCD,MAAC;;uCACR,oBAYM,6BAXS,6BAAoB,GAA1B,EAAE;4CADX,oBAYM;wBAVH,GAAG,EAAE,EAAE;wBACR,KAAK,EAAC,YAAY;;wBAElB,oBAAqB,+BAAZ,EAAE;;wBACX,aAKE;0BAJC,IAAI,EAAE,EAAE;0BACT,UAAQ,EAAC,SAAS;0BAClB,KAAK,EAAC,UAAU;0BAChB,cAAY,EAAC,gBAAgB;;;;;;;eAK3B,6BAAoB,CAAC,MAAM;iCADnC,oBAmBM,OAnBN,UAmBM;oBAdJ,oBAAuC,6BAAhCA,MAAC;;uCACR,oBAYM,6BAXS,6BAAoB,GAA1B,EAAE;4CADX,oBAYM;wBAVH,GAAG,EAAE,EAAE;wBACR,KAAK,EAAC,YAAY;;wBAElB,oBAAqB,+BAAZ,EAAE;;wBACX,aAKE;0BAJC,IAAI,EAAE,EAAE;0BACT,UAAQ,EAAC,SAAS;0BAClB,KAAK,EAAC,UAAU;0BAChB,cAAY,EAAC,gBAAgB","sourcesContent":["<script>\nimport { isV4Format, isV6Format } from 'ip';\nimport CopyToClipboard from '@shell/components/CopyToClipboard';\nimport { mapGetters } from 'vuex';\nimport RcStatusBadge from '@components/Pill/RcStatusBadge/RcStatusBadge';\n\nexport default {\n  components: { CopyToClipboard, RcStatusBadge },\n  props:      {\n    row: {\n      type:     Object,\n      required: true\n    },\n  },\n  computed: {\n    ...mapGetters({ t: 'i18n/t' }),\n    filteredExternalIps() {\n      return this.row.externalIps?.filter((ip) => this.isIp(ip)) || [];\n    },\n    filteredInternalIps() {\n      return this.row.internalIps?.filter((ip) => this.isIp(ip)) || [];\n    },\n    internalSameAsExternal() {\n      return this.externalIp && this.internalIp && this.externalIp === this.internalIp;\n    },\n    showPopover() {\n      return this.filteredExternalIps.length > 1 || this.filteredInternalIps.length > 1;\n    },\n    externalIp() {\n      return this.filteredExternalIps[0] || null;\n    },\n    internalIp() {\n      return this.filteredInternalIps[0] || null;\n    },\n    remainingIpCount() {\n      let count = 0;\n\n      if (this.filteredExternalIps.length > 1) {\n        count += this.filteredExternalIps.length - 1;\n      }\n\n      if (!this.internalSameAsExternal && this.filteredInternalIps.length > 1) {\n        count += this.filteredInternalIps.length - 1;\n      }\n\n      return count;\n    },\n    tooltipContent() {\n      const count = this.remainingIpCount;\n\n      return this.t('internalExternalIP.clickToShowMoreIps', { count });\n    },\n    remainingExternalIps() {\n      return this.filteredExternalIps.slice(1);\n    },\n    remainingInternalIps() {\n      return this.filteredInternalIps.slice(1);\n    }\n  },\n  methods: {\n    isIp(ip) {\n      return ip && (isV4Format(ip) || isV6Format(ip));\n    }\n  }\n};\n</script>\n\n<template>\n  <div class=\"ip-container\">\n    <template v-if=\"externalIp\">\n      <span data-testid=\"external-ip\">\n        {{ externalIp }}\n        <CopyToClipboard\n          :aria-label=\"t('internalExternalIP.copyExternalIp')\"\n          label-as=\"tooltip\"\n          :text=\"externalIp\"\n          class=\"icon-btn\"\n          action-color=\"bg-transparent\"\n        />\n      </span>\n    </template>\n    <template v-else>\n      -\n    </template>\n    <span class=\"separator\">/</span>\n    <template v-if=\"internalSameAsExternal\">\n      {{ t('tableHeaders.internalIpSameAsExternal') }}\n    </template>\n    <template v-else-if=\"internalIp\">\n      <span data-testid=\"internal-ip\">\n        {{ internalIp }}\n        <CopyToClipboard\n          :aria-label=\"t('internalExternalIP.copyInternalIp')\"\n          label-as=\"tooltip\"\n          :text=\"internalIp\"\n          class=\"icon-btn\"\n          action-color=\"bg-transparent\"\n        />\n      </span>\n    </template>\n    <template v-else>\n      -\n    </template>\n    <v-dropdown\n      v-if=\"showPopover\"\n      ref=\"dropdown\"\n      placement=\"bottom-start\"\n    >\n      <template #default>\n        <RcStatusBadge\n          v-clean-tooltip=\"tooltipContent\"\n          status=\"info\"\n          data-testid=\"plus-more\"\n          @click.stop\n        >\n          {{ t('generic.plusMore', {n: remainingIpCount}) }}\n        </RcStatusBadge>\n      </template>\n      <template #popper>\n        <div\n          class=\"ip-addresses-popover\"\n          data-testid=\"ip-addresses-popover\"\n        >\n          <button\n            class=\"btn btn-sm close-button\"\n            @click=\"$refs.dropdown.hide()\"\n          >\n            <i class=\"icon icon-close\" />\n          </button>\n          <div\n            v-if=\"remainingExternalIps.length\"\n            class=\"ip-list\"\n            data-testid=\"external-ip-list\"\n          >\n            <h5>{{ t('generic.externalIps') }}</h5>\n            <div\n              v-for=\"ip in remainingExternalIps\"\n              :key=\"ip\"\n              class=\"ip-address\"\n            >\n              <span>{{ ip }}</span>\n              <CopyToClipboard\n                :text=\"ip\"\n                label-as=\"tooltip\"\n                class=\"icon-btn\"\n                action-color=\"bg-transparent\"\n              />\n            </div>\n          </div>\n          <div\n            v-if=\"remainingInternalIps.length\"\n            class=\"ip-list\"\n            data-testid=\"internal-ip-list\"\n          >\n            <h5>{{ t('generic.internalIps') }}</h5>\n            <div\n              v-for=\"ip in remainingInternalIps\"\n              :key=\"ip\"\n              class=\"ip-address\"\n            >\n              <span>{{ ip }}</span>\n              <CopyToClipboard\n                :text=\"ip\"\n                label-as=\"tooltip\"\n                class=\"icon-btn\"\n                action-color=\"bg-transparent\"\n              />\n            </div>\n          </div>\n        </div>\n      </template>\n    </v-dropdown>\n  </div>\n</template>\n\n<style lang='scss' scoped>\n.ip-container {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 4px;\n  margin: 8px 0;\n}\n\n.icon-btn {\n  padding: 2px;\n  min-height: 24px;\n}\n\n.rc-status-badge {\n  cursor: pointer;\n  padding: 0 4px;\n}\n\n.ip-addresses-popover {\n  display: flex;\n  flex-direction: column;\n  min-width: 120px;\n  padding: 8px;\n  gap: 16px;\n\n  .ip-list {\n    display: flex;\n    flex-direction: column;\n    gap: 4px;\n    margin-top: 8px;\n\n    h5 {\n      margin-bottom: 4px;\n      font-weight: 600;\n    }\n  }\n\n  .ip-address {\n    display: flex;\n    align-items: center;\n    gap: 4px;\n  }\n\n  .close-button {\n    position: absolute;\n    top: -6px;\n    right: -6px;\n    padding: 8px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    background: transparent;\n\n    &:hover .icon-close{\n      color: var(--primary);\n    }\n  }\n}\n</style>\n"]}]}