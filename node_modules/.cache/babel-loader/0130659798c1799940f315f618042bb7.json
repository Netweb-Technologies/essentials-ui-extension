v class=\"actions\">\n        <div class=\"buttons\">\n          <button\n            type=\"button\"\n            class=\"btn role-secondary mr-10\"\n            @click=\"ok\"\n          >\n            {{ t('generic.ok') }}\n          </button>\n        </div>\n      </div>\n    </template>\n  </Card>\n</template>\n\n<style lang=\"scss\" scoped>\n.actions {\n  width: 100%;\n}\n\n.buttons {\n  display: flex;\n  justify-content: flex-end;\n  width: 100%;\n}\n</style>\n"]}]}