{"remainingRequest":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js??ruleSet[1].rules[4]!/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js??ruleSet[0].use[0]!/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js??ruleSet[0].use[1]!/home/ubuntu/essentials-ui-extension/pkg/harvester/dialog/CloneVmDialog.vue?vue&type=template&id=51abdb7f&scoped=true","dependencies":[{"path":"/home/ubuntu/essentials-ui-extension/pkg/harvester/dialog/CloneVmDialog.vue","mtime":1773206911355},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js","mtime":1773205228903},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js","mtime":1773205228903}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["/home/ubuntu/essentials-ui-extension/pkg/harvester/dialog/CloneVmDialog.vue"],"names":["t","mode"],"mappings":";;qBAsIW,KAAK,EAAC,SAAS;;;;;;;;;;wBAtCxB,aAsDO,mBAtDA,uBAAqB,EAAE,KAAK;IACtB,KAAK,WACd,CAAwC;wCAArCA,MAAC;;IAGK,IAAI,WACb,CAIE;MAJF,aAIE;QAHQ,KAAK,EAAE,eAAS;gEAAT,eAAS;QACxB,KAAK,EAAC,OAAO;QACb,WAAS,EAAC,8BAA8B;;;sBAG1C,aAME;QAJQ,KAAK,EAAE,UAAI;gEAAJ,UAAI;QACnB,KAAK,EAAC,OAAO;QACZ,KAAK,EAAEA,MAAC;QACT,QAAQ,EAAR,EAAQ;;iBAJA,eAAS;;;OAOX,kCAAyB;yBADjC,aAME;;YAJQ,KAAK,EAAE,iBAAW;oEAAX,iBAAW;YAC1B,WAAS,EAAC,sCAAsC;YAC/C,OAAO,EAAE,wBAAkB;YAC3B,IAAI,EAAEC,SAAI;;;;yBAEb,oBAKE,6BAJmB,YAAM,GAAjB,GAAG,EAAE,CAAC;8BADhB,aAKE;UAHC,GAAG,EAAE,CAAC;UACP,KAAK,EAAC,OAAO;UACZ,KAAK,EAAE,GAAG;;;;IAKZ,OAAO,WAGR,CAcM;MAdN,oBAcM,OAdN,UAcM;QAbJ,oBAKS;UAJP,KAAK,EAAC,0BAA0B;UAC/B,OAAK,0CAAE,yCAAK;4BAEVD,MAAC;;QAGN,aAKE;UAJA,IAAI,EAAC,QAAQ;UACZ,cAAY,EAAE,eAAS,GAAGA,MAAC,4CAA4CA,MAAC;UACxE,QAAQ,EAAE,eAAS,KAAK,UAAI;UAC5B,OAAK,EAAE,eAAM","sourcesContent":["<script>\nimport { exceptionToErrorsArray } from '@shell/utils/error';\nimport { mapGetters } from 'vuex';\nimport { runStrategies as runStrategyOptions } from '../config/harvester-map';\nimport { Card } from '@components/Card';\nimport { Banner } from '@components/Banner';\nimport { Checkbox } from '@components/Form/Checkbox';\nimport AsyncButton from '@shell/components/AsyncButton';\nimport { LabeledInput } from '@components/Form/LabeledInput';\nimport LabeledSelect from '@shell/components/form/LabeledSelect';\n\nexport default {\n  name: 'CloneVMModal',\n\n  emits: ['close'],\n\n  components: {\n    AsyncButton, Banner, Checkbox, Card, LabeledInput, LabeledSelect\n  },\n\n  props: {\n    resources: {\n      type:     Array,\n      required: true\n    }\n  },\n\n  data() {\n    return {\n      name:        '',\n      cloneData:   true,\n      errors:      [],\n      runStrategy: runStrategyOptions[1],\n      runStrategyOptions\n    };\n  },\n\n  computed: {\n    ...mapGetters({ t: 'i18n/t' }),\n\n    actionResource() {\n      return this.resources[0];\n    },\n    vmCloneRunStrategyEnabled() {\n      return this.$store.getters['harvester-common/getFeatureEnabled']('vmCloneRunStrategy');\n    },\n  },\n\n  methods: {\n    close() {\n      this.name = '';\n      this.$emit('close');\n    },\n\n    async create(buttonCb) {\n      // shadow clone\n      if (!this.cloneData) {\n        this.resources[0].goToClone();\n        buttonCb(false);\n        this.close();\n\n        return;\n      }\n\n      // deep clone\n      try {\n        const payload = this.vmCloneRunStrategyEnabled ? { targetVm: this.name, runStrategy: this.runStrategy } : { targetVm: this.name };\n        const res = await this.actionResource.doAction('clone', payload, {}, false);\n\n        if (res._status === 200 || res._status === 204) {\n          this.$store.dispatch('growl/success', {\n            title:   this.t('harvester.notification.title.succeed'),\n            message: this.t('harvester.modal.cloneVM.message.success', { name: this.name })\n          }, { root: true });\n\n          this.close();\n          buttonCb(true);\n        } else {\n          const error = [res?.data] || exceptionToErrorsArray(res);\n\n          this['errors'] = error;\n          buttonCb(false);\n        }\n      } catch (err) {\n        const error = err?.data || err;\n        const message = exceptionToErrorsArray(error);\n\n        this['errors'] = message;\n        buttonCb(false);\n      }\n    }\n  },\n};\n</script>\n\n<template>\n  <Card :show-highlight-border=\"false\">\n    <template #title>\n      {{ t('harvester.modal.cloneVM.title') }}\n    </template>\n\n    <template #body>\n      <Checkbox\n        v-model:value=\"cloneData\"\n        class=\"mb-10\"\n        label-key=\"harvester.modal.cloneVM.type\"\n      />\n\n      <LabeledInput\n        v-show=\"cloneData\"\n        v-model:value=\"name\"\n        class=\"mb-20\"\n        :label=\"t('harvester.modal.cloneVM.name')\"\n        required\n      />\n      <LabeledSelect\n        v-if=\"vmCloneRunStrategyEnabled\"\n        v-model:value=\"runStrategy\"\n        label-key=\"harvester.virtualMachine.runStrategy\"\n        :options=\"runStrategyOptions\"\n        :mode=\"mode\"\n      />\n      <Banner\n        v-for=\"(err, i) in errors\"\n        :key=\"i\"\n        color=\"error\"\n        :label=\"err\"\n      />\n    </template>\n\n    <template\n      #actions\n      class=\"actions\"\n    >\n      <div class=\"buttons\">\n        <button\n          class=\"btn role-secondary mr-10\"\n          @click=\"close\"\n        >\n          {{ t('generic.cancel') }}\n        </button>\n\n        <AsyncButton\n          mode=\"create\"\n          :action-label=\"cloneData ? t('harvester.modal.cloneVM.action.create') : t('harvester.modal.cloneVM.action.clone')\"\n          :disabled=\"cloneData && !name\"\n          @click=\"create\"\n        />\n      </div>\n    </template>\n  </Card>\n</template>\n\n<style lang=\"scss\" scoped>\n.actions {\n  width: 100%;\n}\n\n.buttons {\n  display: flex;\n  justify-content: flex-end;\n  width: 100%;\n}\n</style>\n"]}]}