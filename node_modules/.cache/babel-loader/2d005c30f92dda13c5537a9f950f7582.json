{"remainingRequest":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js??ruleSet[1].rules[4]!/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js??ruleSet[0].use[0]!/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js??ruleSet[0].use[1]!/home/ubuntu/essentials-ui-extension/pkg/harvester/detail/kubevirt.io.virtualmachine/VirtualMachineTabs/VirtualMachineKeypairs.vue?vue&type=template&id=271c42f8&scoped=true","dependencies":[{"path":"/home/ubuntu/essentials-ui-extension/pkg/harvester/detail/kubevirt.io.virtualmachine/VirtualMachineTabs/VirtualMachineKeypairs.vue","mtime":1773206911355},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js","mtime":1773205228903},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js","mtime":1773205228903}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["/home/ubuntu/essentials-ui-extension/pkg/harvester/detail/kubevirt.io.virtualmachine/VirtualMachineTabs/VirtualMachineKeypairs.vue"],"names":[],"mappings":";;qBAmEO,KAAK,EAAC,kBAAkB;qBAKpB,KAAK,EAAC,YAAY;qBAGlB,KAAK,EAAC,qBAAqB;;;EAG5B,KAAK,EAAC,aAAa;;;;;;wBAX3B,oBA8BM,OA9BN,UA8BM;uBA7BJ,oBA4BM,6BA3BmB,aAAO,GAAtB,GAAG,EAAE,KAAK;4BADpB,oBA4BM,SA1BH,GAAG,EAAE,KAAK;QAEX,oBAEM,OAFN,UAEM,mBADD,GAAG,CAAC,EAAE;;QAEX,oBAoBM,OApBN,UAoBM;WAlBI,GAAG,CAAC,OAAO;6BADnB,oBAWM,OAXN,UAWM;kDAPD,GAAG,CAAC,SAAS,IAAG,GACnB;gBAAA,oBAKS;kBAJP,KAAK,EAAC,+BAA+B;kBACpC,OAAK,aAAE,mBAAU,CAAC,KAAK;;kBAExB,oBAA2B,OAAxB,KAAK,EAAC,aAAa;;;6BAG1B,oBAMS;;gBAJP,KAAK,EAAC,sBAAsB;gBAC3B,OAAK,aAAE,mBAAU,CAAC,KAAK;;iCACzB,qBACQ;gBAAA,oBAA+B,OAA5B,KAAK,EAAC,iBAAiB","sourcesContent":["<script>\nimport isString from 'lodash/isString';\nimport { allHash } from '@shell/utils/promise';\nimport { HCI } from '../../../types';\nimport impl from '../../../mixins/harvester-vm/impl';\n\nexport default {\n  mixins: [impl],\n\n  props: {\n    value: {\n      type:     Object,\n      required: true\n    }\n  },\n\n  async fetch() {\n    const hash = await allHash({ allSSHs: this.$store.dispatch('harvester/findAll', { type: HCI.SSH }) });\n\n    this.allSSHs = hash.allSSHs;\n  },\n\n  data() {\n    return {\n      allSSHs: [],\n      sshKeys: []\n    };\n  },\n\n  methods: {\n    toggleShow(idx) {\n      const ssh = this.sshKeys[idx];\n\n      this.sshKeys[idx] = {\n        ...ssh,\n        showKey: !ssh.showKey\n      };\n    },\n\n    getKeys() {\n      return this.mergeAllSSHs(this.value?.spec);\n    },\n\n    isShow(id = '') {\n      const ssh = this.sshKeys.find((O) => O?.data?.id === id) || {};\n\n      return ssh.showKey || false;\n    }\n  },\n\n  watch: {\n    allSSHs(neu) {\n      const out = this.getKeys().map((ssh) => {\n        return {\n          id:        ssh.id,\n          publicKey: isString(ssh.data) ? ssh.data : ssh.data?.spec?.publicKey,\n          showKey:   this.isShow(ssh.id)\n        };\n      });\n\n      this['sshKeys'] = out;\n    }\n  }\n};\n</script>\n\n<template>\n  <div class=\"overview-sshKeys\">\n    <div\n      v-for=\"(ssh, index) in sshKeys\"\n      :key=\"index\"\n    >\n      <div class=\"col span-4\">\n        {{ ssh.id }}\n      </div>\n      <div class=\"col span-7 offset-1\">\n        <div\n          v-if=\"ssh.showKey\"\n          class=\"key-display\"\n        >\n          {{ ssh.publicKey }}\n          <button\n            class=\"btn btn-sm role-link hide-bar\"\n            @click=\"toggleShow(index)\"\n          >\n            <i class=\"icon icon-x\"></i>\n          </button>\n        </div>\n        <button\n          v-else\n          class=\"btn btn-sm role-link\"\n          @click=\"toggleShow(index)\"\n        >\n          *******<i class=\"icons icon-show\"></i>\n        </button>\n      </div>\n    </div>\n  </div>\n</template>\n\n<style lang=\"scss\" scoped>\n  .overview-sshKeys {\n    text-align: left;\n    max-height: 700px;\n    overflow: auto;\n\n    &__item {\n      margin-bottom: 15px;\n\n      &:last-child {\n        margin-bottom: 0;\n      }\n    }\n\n    .key-display {\n      position: relative;\n      padding-right: 30px;\n      word-break: break-word;\n\n      .hide-bar {\n        position: absolute;\n        top: -10px;\n        right: 10px;\n      }\n    }\n  }\n</style>\n"]}]}