{"remainingRequest":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js??ruleSet[1].rules[4]!/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js??ruleSet[0].use[0]!/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js??ruleSet[0].use[1]!/home/ubuntu/essentials-ui-extension/pkg/harvester/edit/loadbalancer.harvesterhci.io.ippool/PriorityRow.vue?vue&type=template&id=7b0b74b3&scoped=true","dependencies":[{"path":"/home/ubuntu/essentials-ui-extension/pkg/harvester/edit/loadbalancer.harvesterhci.io.ippool/PriorityRow.vue","mtime":1773206911368},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js","mtime":1773205228903},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js","mtime":1773205228903}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["/home/ubuntu/essentials-ui-extension/pkg/harvester/edit/loadbalancer.harvesterhci.io.ippool/PriorityRow.vue"],"names":[],"mappings":";;;;EAiMM,KAAK,EAAC,cAAc;;;qBAYjB,KAAK,EAAC,gBAAgB;;;;EAazB,KAAK,EAAC,mBAAmB;;;;;EAczB,KAAK,EAAC,QAAQ;;;;;;;wBA/ClB,oBAyDM;IAxDJ,KAAK,mBAAC,UAAU;kCAC4B,8BAAqB;;;KAKzD,8BAAqB;uBAD7B,oBAaM,OAbN,UAaM;WATQ,eAAM;6BAAlB,oBAEO,qCADF,UAAG,CAAC,OAAO;6BAEhB,aAKE;;gBAHQ,KAAK,EAAE,UAAG,CAAC,OAAO;;wDAAX,UAAG,CAAC,OAAO;kBAEX,eAAM;;gBADpB,OAAO,EAAE,uBAAc;;;;;IAI5B,oBAUM,OAVN,UAUM;OATQ,eAAM;yBAAlB,oBAEO,qCADF,UAAG,CAAC,SAAS;yBAElB,aAKE;;YAHQ,KAAK,EAAE,UAAG,CAAC,SAAS;;oDAAb,UAAG,CAAC,SAAS;cAEb,eAAM;;YADpB,OAAO,EAAE,yBAAgB;;;;KAKtB,8BAAqB;uBAD7B,oBAaM,OAbN,UAaM;WATQ,eAAM;6BAAlB,oBAEO,qCADF,UAAG,CAAC,YAAY;6BAErB,aAKE;;gBAHQ,KAAK,EAAE,UAAG,CAAC,YAAY;;wDAAhB,UAAG,CAAC,YAAY;kBAEhB,eAAM;;gBADpB,OAAO,EAAE,4BAAmB;;;;;KAKzB,mBAAU;uBADlB,oBAWM,OAXN,UAWM;UAPJ,oBAMS;YALP,IAAI,EAAC,QAAQ;YACb,KAAK,EAAC,eAAe;YACpB,OAAK,uCAAE,eAAM,CAAC,UAAG;;YAElB,aAAwB,gBAArB,CAAC,EAAC,gBAAgB","sourcesContent":["<script>\nimport { _EDIT, _VIEW } from '@shell/config/query-params';\nimport Select from '@shell/components/form/Select';\nimport { MANAGEMENT, CAPI } from '@shell/config/types';\nimport { mapGetters } from 'vuex';\nimport { HCI } from '@pkg/harvester/types';\n\nexport default {\n  emits: ['update:value', 'remove'],\n\n  components: { Select },\n\n  props: {\n    row: {\n      type:    Object,\n      default: () => ({}),\n    },\n\n    mode: {\n      type:    String,\n      default: _EDIT,\n    },\n\n    rows: {\n      type:    Array,\n      default: () => [],\n    },\n\n    idx: {\n      type:     Number,\n      required: true,\n    },\n  },\n\n  data() {\n    return { value: '' };\n  },\n\n  computed: {\n    ...mapGetters(['allNamespaces', 'currentCluster', 'isRancherInHarvester', 'isStandaloneHarvester']),\n\n    showProjectAndCluster() {\n      return !this.isStandaloneHarvester;\n    },\n\n    isView() {\n      return this.mode === _VIEW;\n    },\n\n    showRemove() {\n      return !this.isView;\n    },\n\n    filteredNamespaces() {\n      const namespaces = this.allNamespaces || [];\n\n      return namespaces.filter((namespace) => {\n        if (this.row.project === '*') {\n          return true;\n        } else if (this.row.project) {\n          return namespace.project?.id === this.row.project;\n        } else {\n          return true;\n        }\n      });\n    },\n\n    namespaceOptions() {\n      const namespaces = this.filteredNamespaces;\n      const selected = this.rows.map((r) => r?.namespace);\n\n      if (this.isStandaloneHarvester) {\n        return [\n          { label: this.t('generic.all'), value: '*' },\n          ...namespaces.map((ns) => ({\n            label:    ns.metadata.name,\n            value:    ns.id,\n            disabled: selected.includes(ns.id) && ns.id !== this.row.namespace\n          }))\n        ];\n      }\n\n      return [{\n        label: this.t('generic.all'),\n        value: '*',\n      },\n      ...namespaces.map((ns) => ({ label: ns.metadata.name, value: ns.id }))\n      ];\n    },\n\n    guestClusterOptions() {\n      const clusters = this.$store.getters['management/all'](CAPI.RANCHER_CLUSTER);\n      const configs = this.$store.getters['management/all'](HCI.HARVESTER_CONFIG);\n      const selectedClusters = this.rows.map((row) => row?.guestCluster);\n      const filteredNamespaces = this.filteredNamespaces.map((n) => n.id);\n\n      const out = clusters.filter((c) => {\n        const machinePools = c.spec?.rkeConfig?.machinePools || [];\n        const machineConfigName = machinePools[0]?.machineConfigRef?.name;\n        const config = configs.find((c) => c.id === `fleet-default/${ machineConfigName }`);\n\n        if (config) {\n          const vmNamespace = config?.vmNamespace;\n\n          if (this.row.namespace === '*' && filteredNamespaces.includes(vmNamespace)) {\n            return true;\n          } else {\n            return vmNamespace === this.row.namespace && !selectedClusters.includes(c.id);\n          }\n        } else {\n          return false;\n        }\n      }).map((cluster) => {\n        return {\n          label: cluster.nameDisplay,\n          value: cluster.metadata.name,\n        };\n      });\n\n      return [{\n        label: this.t('generic.none'),\n        value: '',\n      }, {\n        label: this.t('generic.all'),\n        value: '*',\n      }, ...out];\n    },\n\n    projectOptions() {\n      const projects = this.$store.getters['management/all'](MANAGEMENT.PROJECT);\n\n      const out = projects.filter((p) => p.metadata.namespace === this.currentCluster.id).map((project) => {\n        return {\n          label: project.nameDisplay,\n          value: project.id,\n        };\n      });\n\n      return [{\n        label: this.t('generic.none'),\n        value: '',\n      }, {\n        label: this.t('generic.all'),\n        value: '*',\n      }, ...out];\n    },\n  },\n\n  methods: {\n    update() {\n      const { namespace, project, guestCluster } = this.row;\n\n      this.$emit('update:value', {\n        namespace,\n        project,\n        guestCluster,\n      });\n    },\n\n    remove() {\n      this.$emit('remove');\n    },\n  },\n\n  watch: {\n    'row.project'() {\n      if (this.row.namespace !== '*') {\n        this.row.namespace = '';\n      }\n\n      if (this.row.guestCluster !== '*' || this.row.guestCluster !== '') {\n        this.row.guestCluster = '';\n      }\n    },\n\n    'row.namespace'() {\n      if (this.row.guestCluster !== '*') {\n        this.row.guestCluster = '';\n      }\n    },\n  },\n};\n</script>\n\n<template>\n  <div\n    class=\"pool-row\"\n    :class=\"{\n      'show-project-and-cluster': showProjectAndCluster,\n    }\"\n  >\n    <div\n      v-if=\"showProjectAndCluster\"\n      class=\"pool-project\"\n    >\n      <span v-if=\"isView\">\n        {{ row.project }}\n      </span>\n      <Select\n        v-else\n        v-model:value=\"row.project\"\n        :options=\"projectOptions\"\n        @update:value=\"update\"\n      />\n    </div>\n    <div class=\"pool-namespace\">\n      <span v-if=\"isView\">\n        {{ row.namespace }}\n      </span>\n      <Select\n        v-else\n        v-model:value=\"row.namespace\"\n        :options=\"namespaceOptions\"\n        @update:value=\"update\"\n      />\n    </div>\n    <div\n      v-if=\"showProjectAndCluster\"\n      class=\"pool-guestCluster\"\n    >\n      <span v-if=\"isView\">\n        {{ row.guestCluster }}\n      </span>\n      <Select\n        v-else\n        v-model:value=\"row.guestCluster\"\n        :options=\"guestClusterOptions\"\n        @update:value=\"update\"\n      />\n    </div>\n    <div\n      v-if=\"showRemove\"\n      class=\"remove\"\n    >\n      <button\n        type=\"button\"\n        class=\"btn role-link\"\n        @click=\"remove(idx)\"\n      >\n        <t k=\"generic.remove\" />\n      </button>\n    </div>\n  </div>\n</template>\n\n<style lang=\"scss\" scoped>\n  .pool-row {\n    display: grid;\n    grid-column-gap: $column-gutter;\n    margin-bottom: 10px;\n    align-items: center;\n\n    grid-template-columns: 40% 40% 15%;\n\n    &.show-project-and-cluster {\n      grid-template-columns: 25% 25% 25% 15%;\n    }\n  }\n</style>\n"]}]}