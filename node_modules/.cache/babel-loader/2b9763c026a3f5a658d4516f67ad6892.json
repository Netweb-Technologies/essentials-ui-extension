{"remainingRequest":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js??ruleSet[1].rules[4]!/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js??ruleSet[0].use[0]!/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js??ruleSet[0].use[1]!/home/ubuntu/essentials-ui-extension/pkg/harvester/edit/harvesterhci.io.host/HarvesterHugepages.vue?vue&type=template&id=90d545c6","dependencies":[{"path":"/home/ubuntu/essentials-ui-extension/pkg/harvester/edit/harvesterhci.io.host/HarvesterHugepages.vue","mtime":1773206911359},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js","mtime":1773205228903},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js","mtime":1773205228903}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["/home/ubuntu/essentials-ui-extension/pkg/harvester/edit/harvesterhci.io.host/HarvesterHugepages.vue"],"names":["t"],"mappings":";;qBAmIW,KAAK,EAAC,WAAW;qBACf,KAAK,EAAC,YAAY;qBAOlB,KAAK,EAAC,YAAY;qBAOlB,KAAK,EAAC,YAAY;;;;;;wBA1B7B,oBAmCM;IAlCJ,oBAiCM;gCAhCJ,oBAAsB,QAAlB,KAAK,EAAC,SAAS;;MACnB,oBAMK;QALH,aAIE;UAHA,CAAC,EAAC,4CAA4C;UAC7C,GAAG,EAAE,IAAI;UACT,GAAG,EAAE,qCAA4B;;;;MAItC,oBAsBM,OAtBN,UAsBM;QArBJ,oBAMM,OANN,UAMM;UALJ,aAIE;YAHQ,KAAK,EAAE,UAAI,CAAC,WAAW,CAAC,OAAO;oEAAxB,UAAI,CAAC,WAAW,CAAC,OAAO;YACtC,KAAK,EAAEA,MAAC;YACR,OAAO,EAAE,6BAAuB;;;;QAGrC,oBAMM,OANN,UAMM;UALJ,aAIE;YAHQ,KAAK,EAAE,UAAI,CAAC,WAAW,CAAC,YAAY;oEAA7B,UAAI,CAAC,WAAW,CAAC,YAAY;YAC3C,KAAK,EAAEA,MAAC;YACR,OAAO,EAAE,kCAA4B;;;;QAG1C,oBAMM,OANN,UAMM;UALJ,aAIE;YAHQ,KAAK,EAAE,UAAI,CAAC,WAAW,CAAC,MAAM;oEAAvB,UAAI,CAAC,WAAW,CAAC,MAAM;YACrC,KAAK,EAAEA,MAAC;YACR,OAAO,EAAE,4BAAsB","sourcesContent":["<script>\nimport LabeledSelect from '@shell/components/form/LabeledSelect.vue';\nimport { HCI } from '../../types';\nimport { DOC } from '../../config/doc-links';\n\nexport const hugepagesTHPEnabledMode = [{\n  label: 'Always',\n  value: 'always',\n}, {\n  label: 'Madvise',\n  value: 'madvise',\n}, {\n  label: 'Never',\n  value: 'never',\n}];\n\nexport const hugepagesTHPShmemEnabledMode = [{\n  label: 'Always',\n  value: 'always',\n}, {\n  label: 'Within Size',\n  value: 'within_size',\n}, {\n  label: 'Advise',\n  value: 'advise',\n}, {\n  label: 'Never',\n  value: 'never',\n}, {\n  label: 'Deny',\n  value: 'deny',\n}, {\n  label: 'Force',\n  value: 'force',\n}];\n\nexport const hugepagesTHPDefragMode = [{\n  label: 'Always',\n  value: 'always',\n}, {\n  label: 'Defer',\n  value: 'defer',\n}, {\n  label: 'Defer+Madvise',\n  value: 'defer+madvise',\n}, {\n  label: 'Madvise',\n  value: 'madvise',\n}, {\n  label: 'Never',\n  value: 'never'\n}];\n\nexport default {\n  name:       'HarvesterHugepages',\n  components: { LabeledSelect },\n\n  props: {\n    node: {\n      type:     Object,\n      required: true,\n    },\n\n    registerBeforeHook: {\n      type:     Function,\n      required: true,\n    },\n  },\n\n  computed: {\n    docsTransparentHugepagesLink() {\n      return DOC.TRANSPARENT_HUGEPAGES;\n    },\n  },\n\n  methods: {\n    async saveHugepages() {\n      this.hugepages['spec'] = this.spec;\n\n      await this.hugepages.save().catch((reason) => {\n        if (reason?.type === 'error') {\n          this.$store.dispatch('growl/error', {\n            title:   this.t('harvester.notification.title.error'),\n            message: reason?.message,\n          }, { root: true });\n\n          return Promise.reject(new Error('saveHugepages error'));\n        }\n      });\n    },\n  },\n\n  async fetch() {\n    const inStore = this.$store.getters['currentProduct'].inStore;\n\n    const hash = await this.$store.dispatch(`${ inStore }/findAll`, { type: HCI.HUGEPAGES });\n\n    this.hugepages = hash.find((node) => {\n      return node.id === this.node.id;\n    });\n    this.spec = this.hugepages.spec;\n  },\n\n  data() {\n    return {\n      hugepages: {},\n      spec:      { transparent: {} },\n      hugepagesTHPEnabledMode,\n      hugepagesTHPShmemEnabledMode,\n      hugepagesTHPDefragMode,\n    };\n  },\n\n  created() {\n    this.registerBeforeHook(this.saveHugepages, 'saveHugepages');\n  },\n};\n</script>\n\n<template>\n  <div>\n    <div>\n      <hr class=\"divider\" />\n      <h3>\n        <t\n          k=\"harvester.host.hugepages.transparent.title\"\n          :raw=\"true\"\n          :url=\"docsTransparentHugepagesLink\"\n        />\n      </h3>\n\n      <div class=\"row mb-20\">\n        <div class=\"col span-4\">\n          <LabeledSelect\n            v-model:value=\"spec.transparent.enabled\"\n            :label=\"t('harvester.host.hugepages.transparent.enabled')\"\n            :options=\"hugepagesTHPEnabledMode\"\n          />\n        </div>\n        <div class=\"col span-4\">\n          <LabeledSelect\n            v-model:value=\"spec.transparent.shmemEnabled\"\n            :label=\"t('harvester.host.hugepages.transparent.shmemEnabled')\"\n            :options=\"hugepagesTHPShmemEnabledMode\"\n          />\n        </div>\n        <div class=\"col span-4\">\n          <LabeledSelect\n            v-model:value=\"spec.transparent.defrag\"\n            :label=\"t('harvester.host.hugepages.transparent.defrag')\"\n            :options=\"hugepagesTHPDefragMode\"\n          />\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n"]}]}