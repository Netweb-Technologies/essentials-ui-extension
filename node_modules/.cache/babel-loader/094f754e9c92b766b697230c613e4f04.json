{"remainingRequest":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js??ruleSet[1].rules[4]!/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js??ruleSet[0].use[0]!/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js??ruleSet[0].use[1]!/home/ubuntu/essentials-ui-extension/pkg/harvester/edit/kubevirt.io.virtualmachine/VirtualMachineVolume/index.vue?vue&type=template&id=1be81b16&scoped=true","dependencies":[{"path":"/home/ubuntu/essentials-ui-extension/pkg/harvester/edit/kubevirt.io.virtualmachine/VirtualMachineVolume/index.vue","mtime":1773208598736},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js","mtime":1773205228903},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js","mtime":1773205228903}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["/home/ubuntu/essentials-ui-extension/pkg/harvester/edit/kubevirt.io.virtualmachine/VirtualMachineVolume/index.vue"],"names":["t"],"mappings":";;qBAkTe,KAAK,EAAC,iBAAiB;;;EAItB,KAAK,EAAC,OAAO;;;;;;qBAgEd,KAAK,EAAC,WAAW;;;EAGlB,KAAK,EAAC,OAAO;;;;sBAmBV,KAAK,EAAC,YAAY;sBAKpB,KAAK,EAAC,OAAO;;;sBA6Ef,KAAK,EAAC,SAAS;;;;;;;;;;;wBA7L1B,oBA8MM;MA5MK,eAAM;uBADf,aAIE;;UAFA,KAAK,EAAC,MAAM;UACZ,WAAS,EAAC,yCAAyC;;;;IAErD,aA8HmB;MA7HhB,IAAI,EAAE,UAAI;MACV,QAAQ,EAAE,eAAM;MACjB,UAAQ,EAAC,IAAI;MACZ,KAAG,EAAE,eAAM;;wBAGV,CAA2B;2BAD7B,oBAuHM,6BAtHkB,UAAI,GAAlB,MAAM,EAAE,CAAC;gCADnB,oBAuHM;YArHH,GAAG,EAAE,MAAM,CAAC,EAAE;;YAEf,aAkHU;gCAjHR,CAiDM;gBAjDN,oBAiDM,OAjDN,UAiDM;kBAhDJ,oBA+BK;qBA7BK,MAAM,CAAC,EAAE,IAAI,sBAAa;uCADlC,oBAyBO,QAzBP,UAyBO;0BArBL,aAEc;4BAFA,EAAE,EAAE,MAAM,CAAC,EAAE;;8CACzB,CAA+C;gEAA5CA,MAAC,4CAA2C,GAAC,oBAAG,kBAAS,CAAC,MAAM,CAAC,MAAM;;;;;2BAIpE,MAAM,CAAC,GAAG;6CADlB,aAME;;gCAJA,KAAK,EAAC,aAAa;gCAClB,SAAS,EAAE,IAAI;gCACf,GAAG,EAAE,MAAM,CAAC,GAAG;gCACf,KAAK,EAAE,MAAM,CAAC,GAAG,CAAC,KAAK;;;;2BAGlB,YAAG,MAAM,MAAM,CAAC,GAAG,MAAM,MAAM,CAAC,GAAG,CAAC,oBAAoB;6DADhE,oBASI;;gCANF,KAAK,EAAC,wBAAwB;gCAC9B,GAAG,EAAC,8BAA8B;gCAClC,MAAM,EAAC,QAAQ;gCACd,IAAI,EAAE,MAAM,CAAC,GAAG,CAAC,oBAAoB,CAAC,GAAG;;gCAE1C,oBAAqC,OAAlC,KAAK,EAAC,yBAAyB;;2DANjBA,MAAC,CAAC,MAAM,CAAC,GAAG,CAAC,oBAAoB,CAAC,OAAO;;;;uCAU9D,oBAEO,qCADF,kBAAS,CAAC,MAAM,CAAC,MAAM,IAAI,MAAM,EAAE,aAAa;;;oBAI9C,eAAM;qCADf,oBAOS;;wBALP,IAAI,EAAC,QAAQ;wBACb,KAAK,EAAC,6BAA6B;wBAClC,OAAK,aAAE,qBAAY,CAAC,MAAM;;wBAE3B,oBAAyB,OAAtB,KAAK,EAAC,aAAa;;;;mBAGhB,MAAM,CAAC,YAAY,IAAI,eAAM;qCADrC,oBAOS;;wBALP,IAAI,EAAC,QAAQ;wBACb,KAAK,EAAC,6BAA6B;wBAClC,OAAK,aAAE,qBAAY,CAAC,MAAM;0CAExBA,MAAC;;;;gBAGR,oBAgBM;iCAfJ,aAcE,yBAbK,qBAAY,CAAC,MAAM,CAAC,MAAM;oBAC9B,KAAK,EAAE,UAAI,CAAC,CAAC;oBACb,IAAI,EAAE,UAAI;oBACV,SAAS,EAAE,gBAAS;oBACpB,WAAS,EAAE,iBAAQ;oBACnB,SAAO,EAAE,eAAM;oBACf,SAAO,EAAE,eAAM;oBACf,iBAAe,EAAE,sBAAa;oBAC9B,oBAAkB,EAAE,yBAAgB,CAAC,UAAI,CAAC,CAAC;oBAC3C,IAAI,EAAE,WAAI;oBACV,GAAG,EAAE,CAAC;oBACN,mBAAiB,EAAE,uBAAgB;oBACnC,QAAM,EAAE,eAAM;;;;gBAInB,oBAyBM,OAzBN,UAyBM;oBAvBK,eAAM;qCADf,oBAmBM,OAnBN,UAmBM;wBAfJ,oBAMS;0BALN,QAAQ,EAAE,CAAC;0BACZ,KAAK,EAAC,yBAAyB;0BAC9B,OAAK,4BAAU,mBAAU,CAAC,CAAC;;0BAE5B,oBAA4C,OAAzC,KAAK,EAAC,8BAA8B;;;wBAGzC,oBAMS;0BALN,QAAQ,EAAE,CAAC,KAAK,UAAI,CAAC,MAAM;0BAC5B,KAAK,EAAC,yBAAyB;0BAC9B,OAAK,4BAAU,mBAAU,CAAC,CAAC;;0BAE5B,oBAA8C,OAA3C,KAAK,EAAC,gCAAgC;;;;;kBAI7C,oBAEM,OAFN,WAEM,EAFkB,6BACX,oBAAG,CAAC;;;gBAInB,oBAiBM,OAjBN,WAiBM;mBAfI,MAAM,CAAC,YAAY,KAAK,iBAAQ;qCADxC,aAKE;;wBAHA,KAAK,EAAC,eAAe;wBACrB,KAAK,EAAC,SAAS;wBACd,KAAK,EAAE,aAAO,CAAC,MAAM,CAAC,YAAY;;;;mBAG7B,YAAK,CAAC,aAAa,IAAI,YAAK,CAAC,aAAa,CAAC,KAAK,IAAI,YAAK,CAAC,aAAa,CAAC,KAAK,CAAC,OAAO;qCAD7F,aAIE;;wBAFA,KAAK,EAAC,OAAO;wBACZ,KAAK,EAAE,aAAO,CAAC,YAAK,CAAC,aAAa,CAAC,KAAK,CAAC,OAAO;;;;oBAG1C,yCAAgC,IAAI,qBAAY,CAAC,MAAM,MAAM,eAAM;qCAD5E,aAIE;;wBAFA,KAAK,EAAC,SAAS;wBACd,KAAK,EAAEA,MAAC;;;;;;;;;;;;;;KAOX,sBAAa;uBADrB,aAIE;;UAFA,KAAK,EAAC,SAAS;UACd,KAAK,EAAEA,MAAC;;;;MAGC,eAAM;uBAAlB,oBAkCM;UAjCJ,oBAOS;YANP,IAAI,EAAC,QAAQ;YACb,KAAK,EAAC,mCAAmC;YACxC,QAAQ,EAAE,UAAI,CAAC,MAAM;YACrB,OAAK,uCAAE,kBAAS,CAAC,iBAAW,CAAC,GAAG;8BAE9BA,MAAC;;YAIG,6BAAsB;6BAD/B,oBAOS;;gBALP,IAAI,EAAC,QAAQ;gBACb,KAAK,EAAC,mCAAmC;gBACxC,OAAK,uCAAE,kBAAS,CAAC,iBAAW,CAAC,aAAa;kCAExCA,MAAC;;;UAGN,oBAMS;YALP,IAAI,EAAC,QAAQ;YACb,KAAK,EAAC,mCAAmC;YACxC,OAAK,uCAAE,kBAAS,CAAC,iBAAW,CAAC,KAAK;8BAEhCA,MAAC;;UAGN,oBAMS;YALP,IAAI,EAAC,QAAQ;YACb,KAAK,EAAC,6BAA6B;YAClC,OAAK,uCAAE,kBAAS,CAAC,iBAAW,CAAC,SAAS;8BAEpCA,MAAC;;;;KAKA,YAAM;uBADd,aA8BgB;;UA5Bd,IAAI,EAAC,WAAW;UACf,KAAK,EAAE,GAAG;;UAEA,KAAK,WACd,CAAwD;8CAArDA,MAAC;;UAGK,OAAO,WAChB,CAAuE;YAAvE,oBAAuE,+BAA9DA,MAAC;;UAGD,MAAM,WACf,CAcM;YAdN,oBAcM,OAdN,WAcM;cAbJ,oBAKS;gBAJP,KAAK,EAAC,0BAA0B;gBAC/B,OAAK,yDAAU,2CAAM;kCAEnBA,MAAC;;cAGN,oBAKS;gBAJP,KAAK,EAAC,sBAAsB;gBAC3B,OAAK,yDAAU,uDAAY;kCAEzBA,MAAC","sourcesContent":["<script>\nimport { VueDraggableNext } from 'vue-draggable-next';\nimport InfoBox from '@shell/components/InfoBox';\nimport { Banner } from '@components/Banner';\nimport BadgeStateFormatter from '@shell/components/formatter/BadgeStateFormatter';\nimport UnitInput from '@shell/components/form/UnitInput';\nimport { LabeledInput } from '@components/Form/LabeledInput';\nimport LabeledSelect from '@shell/components/form/LabeledSelect';\nimport ModalWithCard from '@shell/components/ModalWithCard';\nimport { PVC, STORAGE_CLASS } from '@shell/config/types';\nimport { clone } from '@shell/utils/object';\nimport { ucFirst, randomStr } from '@shell/utils/string';\nimport { removeObject } from '@shell/utils/array';\nimport { _VIEW, _EDIT, _CREATE } from '@shell/config/query-params';\nimport { PLUGIN_DEVELOPER, DEV } from '@shell/store/prefs';\nimport { SOURCE_TYPE } from '../../../config/harvester-map';\nimport { PRODUCT_NAME as HARVESTER_PRODUCT } from '../../../config/harvester';\nimport { HCI } from '../../../types';\nimport { VOLUME_MODE } from '@pkg/harvester/config/types';\nimport { OFF } from '../../../models/kubevirt.io.virtualmachine';\n\nexport default {\n  emits: ['update:value'],\n\n  components: {\n    Banner, BadgeStateFormatter, VueDraggableNext, InfoBox, LabeledInput, UnitInput, LabeledSelect, ModalWithCard\n  },\n\n  props: {\n    vm: {\n      type:    Object,\n      default: () => {\n        return {};\n      }\n    },\n\n    mode: {\n      type:    String,\n      default: _CREATE\n    },\n\n    value: {\n      type:    Array,\n      default: () => {\n        return [];\n      }\n    },\n\n    namespace: {\n      type:    String,\n      default: null\n    },\n\n    existingVolumeDisabled: {\n      type:    Boolean,\n      default: false\n    },\n\n    validateRequired: {\n      type:    Boolean,\n      default: false\n    },\n\n    customVolumeMode: {\n      type:    String,\n      default: VOLUME_MODE.Block\n    },\n\n    customAccessMode: {\n      type:    String,\n      default: 'ReadWriteMany'\n    },\n\n    resourceType: {\n      type:    String,\n      default: ''\n    }\n  },\n\n  async fetch() {\n    await this.$store.dispatch('harvester/findAll', { type: PVC });\n  },\n\n  data() {\n    return {\n      ucFirst,\n      SOURCE_TYPE,\n      rows:    clone(this.value),\n      nameIdx: 1,\n      vol:     null,\n      isOpen:  false\n    };\n  },\n\n  computed: {\n    dev() {\n      try {\n        return this.$store.getters['prefs/get'](PLUGIN_DEVELOPER);\n      } catch {\n        return this.$store.getters['prefs/get'](DEV);\n      }\n    },\n\n    isVirtualType() {\n      return this.resourceType === HCI.VM;\n    },\n\n    isView() {\n      return this.mode === _VIEW;\n    },\n\n    isEdit() {\n      return this.mode === _EDIT;\n    },\n\n    isCreate() {\n      return this.mode === _CREATE;\n    },\n\n    defaultStorageClass() {\n      const defaultStorage = this.$store.getters['harvester/all'](STORAGE_CLASS).find((sc) => sc.isDefault);\n\n      return defaultStorage;\n    },\n\n    showVolumeTip() {\n      const imageName = this.getImageDisplayName(this.rows[0]?.image);\n\n      if (this.rows.length === 1 && this.rows[0].type === 'cd-rom' && /.iso$/i.test(imageName)) {\n        return true;\n      }\n\n      return false;\n    },\n\n    pvcs() {\n      return this.$store.getters['harvester/all'](PVC) || [];\n    },\n\n    isLHV2VolExpansionFeatureEnabled() {\n      return this.$store.getters['harvester-common/getFeatureEnabled']('lhV2VolExpansion');\n    },\n  },\n\n  watch: {\n    value: {\n      handler(neu) {\n        const rows = clone(neu).map((V) => {\n          if (!this.isCreate && V.source !== SOURCE_TYPE.CONTAINER && !V.newCreateId) {\n            V.to = {\n              name:   `${ HARVESTER_PRODUCT }-c-cluster-resource-namespace-id`,\n              params: {\n                resource:  HCI.VOLUME,\n                namespace: this.namespace,\n                id:        V.realName\n              },\n              query: { mode: _EDIT }\n            };\n\n            V.pvc = this.pvcs.find((pvc) => pvc.metadata.name === V.realName);\n          }\n\n          return V;\n        });\n\n        this['rows'] = rows;\n      },\n      deep:      true,\n      immediate: true,\n    },\n  },\n\n  methods: {\n    addVolume(type) {\n      const name = this.generateName();\n      const neu = {\n        id:          randomStr(5),\n        name,\n        source:      type,\n        size:        '10Gi',\n        type:        'disk',\n        accessMode:  this.customAccessMode,\n        volumeMode:  this.customVolumeMode,\n        volumeName:  '',\n        bus:         'virtio',\n        newCreateId: randomStr(10), // judge whether it is a disk that has been created\n      };\n\n      if (type === SOURCE_TYPE.NEW) {\n        neu.storageClassName = this.defaultStorageClass?.metadata?.name || 'longhorn';\n      }\n\n      this.rows.push(neu);\n      this.update();\n    },\n\n    generateName() {\n      let name = '';\n      let hasName = true;\n\n      while (hasName) {\n        name = `disk-${ this.nameIdx }`;\n        hasName = this.rows.find((O) => O.name === name);\n        this.nameIdx++;\n      }\n\n      return name;\n    },\n\n    removeVolume(vol) {\n      this.vol = vol;\n      if (!vol.newCreateId && this.isEdit && this.isVirtualType) {\n        this.isOpen = true;\n      } else {\n        removeObject(this.rows, vol);\n        this.update();\n      }\n    },\n\n    unplugVolume(volume) {\n      this.vm.unplugVolume(volume.name);\n    },\n\n    componentFor(type) {\n      switch (type) {\n      case SOURCE_TYPE.NEW:\n        return require(`./type/volume.vue`).default;\n      case SOURCE_TYPE.IMAGE:\n        return require(`./type/vmImage.vue`).default;\n      case SOURCE_TYPE.ATTACH_VOLUME:\n        return require(`./type/existing.vue`).default;\n      case SOURCE_TYPE.CONTAINER:\n        return require(`./type/container.vue`).default;\n      }\n    },\n\n    headerFor(type, hasVolBackups = false) {\n      const mainHeader = {\n        [SOURCE_TYPE.NEW]:           this.$store.getters['i18n/t']('harvester.virtualMachine.volume.title.volume'),\n        [SOURCE_TYPE.IMAGE]:         this.$store.getters['i18n/t']('harvester.virtualMachine.volume.title.vmImage'),\n        [SOURCE_TYPE.ATTACH_VOLUME]: this.$store.getters['i18n/t']('harvester.virtualMachine.volume.title.existingVolume'),\n        [SOURCE_TYPE.CONTAINER]:     this.$store.getters['i18n/t']('harvester.virtualMachine.volume.title.container'),\n      }[type];\n\n      return hasVolBackups ? `${ mainHeader } and Backups` : mainHeader;\n    },\n\n    update() {\n      this.$emit('update:value', this.rows);\n    },\n\n    deleteVolume() {\n      removeObject(this.rows, this.vol);\n      this.update();\n      this.cancel();\n    },\n\n    cancel() {\n      this.isOpen = false;\n    },\n\n    changeSort(idx, type) {\n      // true: down, false: up\n      this.rows.splice(type ? idx : idx - 1, 1, ...this.rows.splice(type ? idx + 1 : idx, 1, this.rows[type ? idx : idx - 1]));\n      this.update();\n    },\n\n    getImageDisplayName(id) {\n      return this.$store.getters['harvester/all'](HCI.IMAGE).find((image) => image.id === id)?.spec?.displayName;\n    },\n\n    isLonghornV2(volume) {\n      return volume?.pvc?.isLonghornV2 || volume?.pvc?.storageClass?.isLonghornV2;\n    },\n\n    isResizeDisabled(volume) {\n      if (this.isLHV2VolExpansionFeatureEnabled) return false;\n      if (this.isCreate || volume.newCreateId) return false;\n\n      const isStopped = this.vm.stateDisplay === OFF;\n      const isLonghornV2 = this.isLonghornV2(volume);\n\n      return !isStopped || isLonghornV2;\n    },\n  },\n};\n</script>\n\n<template>\n  <div>\n    <Banner\n      v-if=\"!isView\"\n      color=\"info\"\n      label-key=\"harvester.virtualMachine.volume.dragTip\"\n    />\n    <VueDraggableNext\n      :list=\"rows\"\n      :disabled=\"isView\"\n      item-key=\"id\"\n      @end=\"update\"\n    >\n      <div\n        v-for=\"(volume, i) in rows\"\n        :key=\"volume.id\"\n      >\n        <InfoBox>\n          <div class=\"box-title mb-10\">\n            <h3>\n              <span\n                v-if=\"volume.to && isVirtualType\"\n                class=\"title\"\n              >\n                <router-link :to=\"volume.to\">\n                  {{ t('harvester.virtualMachine.volume.edit') }} {{ headerFor(volume.source) }}\n                </router-link>\n\n                <BadgeStateFormatter\n                  v-if=\"volume.pvc\"\n                  class=\"ml-10 state\"\n                  :arbitrary=\"true\"\n                  :row=\"volume.pvc\"\n                  :value=\"volume.pvc.state\"\n                />\n                <a\n                  v-if=\"dev && !!volume.pvc && !!volume.pvc.resourceExternalLink\"\n                  v-clean-tooltip=\"t(volume.pvc.resourceExternalLink.tipsKey || 'generic.resourceExternalLinkTips')\"\n                  class=\"ml-5 resource-external\"\n                  rel=\"nofollow noopener noreferrer\"\n                  target=\"_blank\"\n                  :href=\"volume.pvc.resourceExternalLink.url\"\n                >\n                  <i class=\"icon icon-external-link\" />\n                </a>\n              </span>\n\n              <span v-else>\n                {{ headerFor(volume.source, !!volume?.volumeBackups) }}\n              </span>\n            </h3>\n            <button\n              v-if=\"!isView\"\n              type=\"button\"\n              class=\"role-link btn btn-sm remove\"\n              @click=\"removeVolume(volume)\"\n            >\n              <i class=\"icon icon-x\" />\n            </button>\n            <button\n              v-if=\"volume.hotpluggable && isView\"\n              type=\"button\"\n              class=\"role-link btn btn-sm remove\"\n              @click=\"unplugVolume(volume)\"\n            >\n              {{ t('harvester.virtualMachine.hotUnplug.detachVolume.actionLabel') }}\n            </button>\n          </div>\n          <div>\n            <component\n              :is=\"componentFor(volume.source)\"\n              :value=\"rows[i]\"\n              :rows=\"rows\"\n              :namespace=\"namespace\"\n              :is-create=\"isCreate\"\n              :is-edit=\"isEdit\"\n              :is-view=\"isView\"\n              :is-virtual-type=\"isVirtualType\"\n              :is-resize-disabled=\"isResizeDisabled(rows[i])\"\n              :mode=\"mode\"\n              :idx=\"i\"\n              :validate-required=\"validateRequired\"\n              @update=\"update\"\n            />\n          </div>\n\n          <div class=\"bootOrder\">\n            <div\n              v-if=\"!isView\"\n              class=\"mr-15\"\n            >\n              <button\n                :disabled=\"i === 0\"\n                class=\"btn btn-sm role-primary\"\n                @click.prevent=\"changeSort(i, false)\"\n              >\n                <i class=\"icon icon-lg icon-chevron-up\"></i>\n              </button>\n\n              <button\n                :disabled=\"i === rows.length -1\"\n                class=\"btn btn-sm role-primary\"\n                @click.prevent=\"changeSort(i, true)\"\n              >\n                <i class=\"icon icon-lg icon-chevron-down\"></i>\n              </button>\n            </div>\n\n            <div class=\"text-muted\">\n              bootOrder: {{ i + 1 }}\n            </div>\n          </div>\n\n          <div class=\"mt-15\">\n            <Banner\n              v-if=\"volume.volumeStatus && !isCreate\"\n              class=\"volume-status\"\n              color=\"warning\"\n              :label=\"ucFirst(volume.volumeStatus)\"\n            />\n            <Banner\n              v-if=\"value.volumeBackups && value.volumeBackups.error && value.volumeBackups.error.message\"\n              color=\"error\"\n              :label=\"ucFirst(value.volumeBackups.error.message)\"\n            />\n            <Banner\n              v-if=\"!isLHV2VolExpansionFeatureEnabled && isLonghornV2(volume) && !isView\"\n              color=\"warning\"\n              :label=\"t('harvester.volume.longhorn.disableResize')\"\n            />\n          </div>\n        </InfoBox>\n      </div>\n    </VueDraggableNext>\n    <Banner\n      v-if=\"showVolumeTip\"\n      color=\"warning\"\n      :label=\"t('harvester.virtualMachine.volume.volumeTip')\"\n    />\n\n    <div v-if=\"!isView\">\n      <button\n        type=\"button\"\n        class=\"btn btn-sm bg-primary mr-15 mb-10\"\n        :disabled=\"rows.length === 0\"\n        @click=\"addVolume(SOURCE_TYPE.NEW)\"\n      >\n        {{ t('harvester.virtualMachine.volume.addVolume') }}\n      </button>\n\n      <button\n        v-if=\"!existingVolumeDisabled\"\n        type=\"button\"\n        class=\"btn btn-sm bg-primary mr-15 mb-10\"\n        @click=\"addVolume(SOURCE_TYPE.ATTACH_VOLUME)\"\n      >\n        {{ t('harvester.virtualMachine.volume.addExistingVolume') }}\n      </button>\n\n      <button\n        type=\"button\"\n        class=\"btn btn-sm bg-primary mr-15 mb-10\"\n        @click=\"addVolume(SOURCE_TYPE.IMAGE)\"\n      >\n        {{ t('harvester.virtualMachine.volume.addVmImage') }}\n      </button>\n\n      <button\n        type=\"button\"\n        class=\"btn btn-sm bg-primary mb-10\"\n        @click=\"addVolume(SOURCE_TYPE.CONTAINER)\"\n      >\n        {{ t('harvester.virtualMachine.volume.addContainer') }}\n      </button>\n    </div>\n\n    <ModalWithCard\n      v-if=\"isOpen\"\n      name=\"deleteTip\"\n      :width=\"400\"\n    >\n      <template #title>\n        {{ t('harvester.virtualMachine.volume.unmount.title') }}\n      </template>\n\n      <template #content>\n        <span>{{ t('harvester.virtualMachine.volume.unmount.message') }}</span>\n      </template>\n\n      <template #footer>\n        <div class=\"buttons\">\n          <button\n            class=\"btn role-secondary mr-20\"\n            @click.prevent=\"cancel\"\n          >\n            {{ t('generic.no') }}\n          </button>\n\n          <button\n            class=\"btn bg-primary mr-20\"\n            @click.prevent=\"deleteVolume\"\n          >\n            {{ t('generic.yes') }}\n          </button>\n        </div>\n      </template>\n    </ModalWithCard>\n  </div>\n</template>\n\n<style lang='scss' scoped>\n  .box-title {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n\n    h3 {\n      margin-bottom: 0;\n    }\n  }\n\n  .title {\n    display: flex;\n    align-items: center;\n\n    .state {\n      font-size: 16px;\n    }\n  }\n  .bootOrder {\n    display: flex;\n    align-items: center;\n  }\n\n  .buttons {\n    width: 100%;\n    display: flex;\n    justify-content: flex-end;\n  }\n\n  .volume-status:first-letter {\n    text-transform: uppercase;\n  }\n\n  .resource-external {\n    display: flex;\n    justify-content: center;\n    align-items: center;\n  }\n\n  .banner {\n    margin: 10px 0;\n  }\n</style>\n"]}]}