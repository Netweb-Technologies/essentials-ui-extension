{"remainingRequest":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js??ruleSet[1].rules[4]!/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js??ruleSet[0].use[0]!/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js??ruleSet[0].use[1]!/home/ubuntu/essentials-ui-extension/pkg/harvester/dialog/SnapshotDialog.vue?vue&type=template&id=d72b8ace&scoped=true","dependencies":[{"path":"/home/ubuntu/essentials-ui-extension/pkg/harvester/dialog/SnapshotDialog.vue","mtime":1773206911358},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js","mtime":1773205228903},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js","mtime":1773205228903}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["/home/ubuntu/essentials-ui-extension/pkg/harvester/dialog/SnapshotDialog.vue"],"names":["t"],"mappings":";;qBA0FW,KAAK,EAAC,SAAS;qBACb,KAAK,EAAC,SAAS;;;;;;;;wBArB1B,aAoCO,mBApCA,uBAAqB,EAAE,KAAK;IACtB,KAAK,WACd,CAAyC;wCAAtCA,MAAC;;IAGK,IAAI,WACb,CAIE;MAJF,aAIE;QAHQ,KAAK,EAAE,UAAI;gEAAJ,UAAI;QAClB,KAAK,EAAEA,MAAC;QACT,QAAQ,EAAR,EAAQ;;;yBAEV,oBAKE,6BAJmB,YAAM,GAAjB,GAAG,EAAE,CAAC;8BADhB,aAKE;UAHC,GAAG,EAAE,CAAC;UACP,KAAK,EAAC,OAAO;UACZ,KAAK,EAAE,GAAG;;;;IAIJ,OAAO,WAChB,CAcM;MAdN,oBAcM,OAdN,UAcM;QAbJ,oBAYM,OAZN,UAYM;UAXJ,oBAKS;YAJP,KAAK,EAAC,0BAA0B;YAC/B,OAAK,0CAAE,yCAAK;8BAEVA,MAAC;;UAEN,aAIE;YAHA,IAAI,EAAC,QAAQ;YACZ,QAAQ,EAAE,oBAAW;YACrB,OAAK,EAAE,aAAI","sourcesContent":["<script>\nimport { mapGetters } from 'vuex';\nimport { exceptionToErrorsArray } from '@shell/utils/error';\nimport { Card } from '@components/Card';\nimport { Banner } from '@components/Banner';\nimport AsyncButton from '@shell/components/AsyncButton';\nimport { LabeledInput } from '@components/Form/LabeledInput';\nexport default {\n  name: 'HarvesterSnapshotDialog',\n\n  emits: ['close'],\n\n  components: {\n    AsyncButton, Banner, Card, LabeledInput\n  },\n  props: {\n    resources: {\n      type:     Array,\n      required: true\n    }\n  },\n  data() {\n    return {\n      name:   '',\n      errors: []\n    };\n  },\n  computed: {\n    ...mapGetters({ t: 'i18n/t' }),\n    actionResource() {\n      return this.resources[0];\n    },\n    disableSave() {\n      return !this.name;\n    }\n  },\n  methods: {\n    close() {\n      this.name = '';\n      this.$emit('close');\n    },\n    async save(buttonCb) {\n      try {\n        const res = await this.actionResource.doAction('snapshot', { name: this.name });\n\n        if (res._status === 200 || res._status === 204) {\n          this.$store.dispatch('growl/success', {\n            title:   this.t('harvester.notification.title.succeed'),\n            message: this.t('harvester.modal.snapshot.message.success', { name: this.name })\n          }, { root: true });\n          this.close();\n          buttonCb(true);\n        } else {\n          const error = [res?.data] || exceptionToErrorsArray(res);\n\n          this['errors'] = error;\n          buttonCb(false);\n        }\n      } catch (err) {\n        const error = err?.data || err;\n        const message = exceptionToErrorsArray(error);\n\n        this['errors'] = message;\n        buttonCb(false);\n      }\n    }\n  },\n};\n</script>\n<template>\n  <Card :show-highlight-border=\"false\">\n    <template #title>\n      {{ t('harvester.modal.snapshot.title') }}\n    </template>\n\n    <template #body>\n      <LabeledInput\n        v-model:value=\"name\"\n        :label=\"t('harvester.modal.snapshot.name')\"\n        required\n      />\n      <Banner\n        v-for=\"(err, i) in errors\"\n        :key=\"i\"\n        color=\"error\"\n        :label=\"err\"\n      />\n    </template>\n\n    <template #actions>\n      <div class=\"actions\">\n        <div class=\"buttons\">\n          <button\n            class=\"btn role-secondary mr-10\"\n            @click=\"close\"\n          >\n            {{ t('generic.cancel') }}\n          </button>\n          <AsyncButton\n            mode=\"create\"\n            :disabled=\"disableSave\"\n            @click=\"save\"\n          />\n        </div>\n      </div>\n    </template>\n  </Card>\n</template>\n<style lang=\"scss\" scoped>\n.actions {\n  width: 100%;\n}\n.buttons {\n  display: flex;\n  justify-content: flex-end;\n  width: 100%;\n}\n</style>\n"]}]}