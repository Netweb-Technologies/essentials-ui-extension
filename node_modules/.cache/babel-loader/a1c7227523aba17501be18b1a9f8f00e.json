{"remainingRequest":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js??ruleSet[1].rules[4]!/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js??ruleSet[0].use[0]!/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js??ruleSet[0].use[1]!/home/ubuntu/essentials-ui-extension/pkg/harvester/list/harvesterhci.io.storage.vue?vue&type=template&id=02147302","dependencies":[{"path":"/home/ubuntu/essentials-ui-extension/pkg/harvester/list/harvesterhci.io.storage.vue","mtime":1773206911372},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js","mtime":1773205228903},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js","mtime":1773205228903}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["/home/ubuntu/essentials-ui-extension/pkg/harvester/list/harvesterhci.io.storage.vue"],"names":["$fetchState","t"],"mappings":";;;;EAiGgB,KAAK,EAAC,0BAA0B;EAChC,KAA2B,EAA3B,uBAA2B;;;;;EAQ3B,KAAK,EAAC,0BAA0B;EAChC,KAA2B,EAA3B,uBAA2B;;;;;;;;;wBA5BzC,oBAmCM;KAlCWA,gBAAW,CAAC,OAAO;uBAAlC,aAAsC;;;IACtC,aAgCgB;MA/Bb,IAAI,EAAE,aAAI;MACV,MAAM,EAAE,YAAM;MACd,OAAO,EAAE,gBAAO;;MAEN,WAAS,WAClB,CAwBK,EAzBiB,GAAG;QACzB,oBAwBK;UAvBH,oBAsBM;aApBI,GAAG,EAAE,cAAc;+BAD3B,aAWc;;kBATX,EAAE,EAAE,GAAG,CAAC,cAAc;;oCAEvB,CAAqB;sDAAlB,GAAG,CAAC,WAAW,IAAG,GACrB;qBACQ,GAAG,CAAC,sBAAsB,WAAW,GAAG,CAAC,sBAAsB,kBAAkB,GAAG,CAAC,sBAAsB;uDADnH,oBAKE,KALF,UAKE;qDAHiBC,MAAC;;;;;;+BAKtB,oBAQO;oDAPF,GAAG,CAAC,WAAW,IAAG,GACrB;mBACQ,GAAG,CAAC,sBAAsB,WAAW,GAAG,CAAC,sBAAsB,kBAAkB,GAAG,CAAC,sBAAsB;qDADnH,oBAKE,KALF,UAKE;mDAHiBA,MAAC","sourcesContent":["<script>\nimport Loading from '@shell/components/Loading';\nimport ResourceTable from '@shell/components/ResourceTable';\n\nimport { allHash } from '@shell/utils/promise';\nimport { SCHEMA, STORAGE_CLASS } from '@shell/config/types';\nimport {\n  STATE, AGE, NAME, STORAGE_CLASS_PROVISIONER, STORAGE_CLASS_DEFAULT\n} from '@shell/config/table-headers';\nimport { HCI } from '../types';\n\nconst schema = {\n  id:         HCI.STORAGE,\n  type:       SCHEMA,\n  attributes: {\n    kind:       HCI.STORAGE,\n    namespaced: false\n  },\n  metadata: { name: HCI.STORAGE },\n};\n\nexport default {\n  name: 'ListHarvesterStorages',\n\n  components: {\n    ResourceTable,\n    Loading,\n  },\n\n  async fetch() {\n    const inStore = this.$store.getters['currentProduct'].inStore;\n\n    await allHash({ storages: this.$store.dispatch(`${ inStore }/findAll`, { type: STORAGE_CLASS }) });\n\n    const storageSchema = this.$store.getters[`${ inStore }/schemaFor`](STORAGE_CLASS);\n\n    if ( storageSchema && !storageSchema?.collectionMethods.find((x) => ['blocked-post', 'post'].includes(x.toLowerCase())) ) {\n      this.$store.dispatch('type-map/configureType', { match: HCI.STORAGE, isCreatable: false });\n    }\n  },\n\n  data() {\n    return { schema };\n  },\n\n  computed: {\n    rows() {\n      const inStore = this.$store.getters['currentProduct'].inStore;\n\n      const storages = this.$store.getters[`${ inStore }/all`](STORAGE_CLASS);\n\n      return storages.filter((s) => !s.parameters?.backingImage);\n    },\n\n    headers() {\n      return [\n        STATE,\n        NAME,\n        STORAGE_CLASS_PROVISIONER,\n        STORAGE_CLASS_DEFAULT,\n        {\n          name:     'numberOfReplicas',\n          labelKey: 'harvester.storage.numberOfReplicas.label',\n          value:    'parameters.numberOfReplicas',\n          sort:     ['parameters.numberOfReplicas'],\n          align:    'center'\n        },\n        AGE,\n      ];\n    },\n  },\n\n  typeDisplay() {\n    return this.$store.getters['type-map/labelFor'](schema, 99);\n  },\n};\n</script>\n\n<template>\n  <div>\n    <Loading v-if=\"$fetchState.pending\" />\n    <ResourceTable\n      :rows=\"rows\"\n      :schema=\"schema\"\n      :headers=\"headers\"\n    >\n      <template #cell:name=\"{ row }\">\n        <td>\n          <div>\n            <router-link\n              v-if=\"row?.detailLocation\"\n              :to=\"row.detailLocation\"\n            >\n              {{ row.nameDisplay }}\n              <i\n                v-if=\"row.isInternalStorageClass && typeof row.isInternalStorageClass === 'function' ? row.isInternalStorageClass() : false\"\n                v-clean-tooltip=\"t('harvester.storage.internal.cannotDeleteOrDefaultTooltip')\"\n                class=\"icon icon-info text-info\"\n                style=\"margin-left: 0.4em;\"\n              />\n            </router-link>\n            <span v-else>\n              {{ row.nameDisplay }}\n              <i\n                v-if=\"row.isInternalStorageClass && typeof row.isInternalStorageClass === 'function' ? row.isInternalStorageClass() : false\"\n                v-clean-tooltip=\"t('harvester.storage.internal.cannotDeleteOrDefaultTooltip')\"\n                class=\"icon icon-info text-info\"\n                style=\"margin-left: 0.4em;\"\n              />\n            </span>\n          </div>\n        </td>\n      </template>\n    </ResourceTable>\n  </div>\n</template>\n"]}]}