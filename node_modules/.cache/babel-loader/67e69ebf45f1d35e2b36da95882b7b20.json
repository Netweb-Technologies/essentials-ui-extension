{"remainingRequest":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js??ruleSet[1].rules[4]!/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js??ruleSet[0].use[0]!/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js??ruleSet[0].use[1]!/home/ubuntu/essentials-ui-extension/node_modules/@rancher/shell/components/SideNav.vue?vue&type=template&id=54a98cce&scoped=true","dependencies":[{"path":"/home/ubuntu/essentials-ui-extension/node_modules/@rancher/shell/components/SideNav.vue","mtime":1779855128362},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js","mtime":1773205228903},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js","mtime":1773205228903}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["/home/ubuntu/essentials-ui-extension/node_modules/@rancher/shell/components/SideNav.vue"],"names":["t","isSingleProduct","hasMultipleLocales","isStandaloneHarvester","isVirtualCluster","isExplorer"],"mappings":";;;qBAkXS,KAAK,EAAC,KAAK;;;EAoBd,KAAK,EAAC,QAAQ;;qBAYZ,KAAK,EAAC,yBAAyB;;;EAajC,KAAK,EAAC,yBAAyB;;;;EAc3B,KAAK,EAAC,sBAAsB;;;;;;;;;wBAhEpC,oBAsEM;IArEJ,KAAK,EAAC,UAAU;IAChB,IAAI,EAAC,YAAY;IAChB,YAAU,EAAEA,MAAC;;IAEd,oBAgBM,OAhBN,UAgBM;yBAfJ,oBAcW,6BAbK,YAAM,GAAZ,CAAC;8BAGT,aASE;eAXI,CAAC,CAAC,IAAI;;UAGV,GAAG,EAAC,QAAQ;UACZ,WAAS,EAAC,EAAE;UACZ,KAAK,EAAC,SAAS;UACd,KAAK,EAAE,CAAC;UACR,cAAY,GAAG,CAAC,CAAC,MAAM;UACvB,aAAW,GAAG,CAAC,CAAC,MAAM;UACtB,UAAQ,uCAAE,sBAAa,CAAC,MAAM;UAC9B,QAAM,uCAAE,sBAAa,CAAC,MAAM;;;;;KAM3B,0BAAiB;uBADzB,oBAuBM,OAvBN,UAuBM;UAnBJ,aAOc;YANX,EAAE,EAAE,oBAAW;YAChB,KAAK,EAAC,YAAY;YAClB,IAAI,EAAC,MAAM;YACV,YAAU,EAAEA,MAAC;;8BAEd,CAA0C;gDAAvCA,MAAC;;;;;yCAEN,oBAKO,QALP,UAKO;8CADF,uBAAc;;iDAHU,uBAAc;;;WAMnCC,oBAAe,IAAIC,uBAAkB,KAAKC,0BAAqB;6BADvE,aAIE;;gBAFA,IAAI,EAAC,OAAO;gBACX,WAAS,EAAE,KAAK;;;;uBAIrB,oBAqBM,OArBN,UAqBM;WAhBI,2BAAkB;6BAD1B,aAOc;;gBALX,EAAE,EAAE,2BAAkB;gBACvB,IAAI,EAAC,MAAM;gBACV,YAAU,EAAEH,MAAC;;kCAEd,CAAoB;oDAAjB,uBAAc;;;;6BAEnB,oBAQW;iBANDI,qBAAgB,IAAIC,eAAU;mDADtC,oBAMO,QANP,UAMO;uCAFN,yBACY,oBAAG,yBAAgB,IAAG,aACnC;;2DAJ6B,yBAAgB","sourcesContent":["<script>\nimport debounce from 'lodash/debounce';\nimport isEqual from 'lodash/isEqual';\nimport { mapGetters, mapState } from 'vuex';\nimport {\n  mapPref,\n  FAVORITE_TYPES\n} from '@shell/store/prefs';\nimport { getVersionInfo } from '@shell/utils/version';\nimport {\n  addObjects, replaceWith, clear, addObject, sameContents\n} from '@shell/utils/array';\nimport { sortBy } from '@shell/utils/sort';\nimport { ucFirst } from '@shell/utils/string';\n\nimport { HCI, UI, SCHEMA } from '@shell/config/types';\nimport { HARVESTER_NAME as HARVESTER } from '@shell/config/features';\nimport { NAME as EXPLORER } from '@shell/config/product/explorer';\nimport { TYPE_MODES } from '@shell/store/type-map';\nimport { NAME as NAVLINKS } from '@shell/config/product/navlinks';\nimport Group from '@shell/components/nav/Group';\nimport LocaleSelector from '@shell/components/LocaleSelector';\n\nexport default {\n  name:       'SideNav',\n  components: { Group, LocaleSelector },\n  data() {\n    return {\n      groups:        [],\n      gettingGroups: false\n    };\n  },\n\n  created() {\n    this.queueUpdate = debounce(this.getGroups, 500);\n    this.getGroups();\n  },\n\n  mounted() {\n    this.$nextTick(() => this.syncNav());\n  },\n\n  watch: {\n    allSchemasIds(a, b) {\n      if ( !sameContents(a, b) ) {\n        this.queueUpdate();\n      }\n    },\n\n    allNavLinksIds(a, b) {\n      if ( !sameContents(a, b) ) {\n        this.queueUpdate();\n      }\n    },\n\n    favoriteTypes(a, b) {\n      if ( !isEqual(a, b) ) {\n        this.queueUpdate();\n      }\n    },\n\n    locale(a, b) {\n      if ( !isEqual(a, b) ) {\n        this.getGroups();\n      }\n    },\n\n    namespaceMode(a, b) {\n      if ( a !== b ) {\n        this.queueUpdate();\n      }\n    },\n\n    namespaces(a, b) {\n      if ( !isEqual(a, b) ) {\n        this.queueUpdate();\n      }\n    },\n\n    clusterReady(a, b) {\n      if ( !isEqual(a, b) ) {\n        this.getGroups();\n      }\n    },\n\n    rootProduct(a, b) {\n      if (a?.name !== b?.name) {\n        this.getGroups();\n      }\n    },\n\n    $route(a, b) {\n      this.$nextTick(() => this.syncNav());\n    },\n  },\n\n  computed: {\n    ...mapState(['managementReady', 'clusterReady']),\n    ...mapGetters(['isStandaloneHarvester', 'productId', 'clusterId', 'currentProduct', 'rootProduct', 'isSingleProduct', 'namespaceMode', 'isExplorer', 'isVirtualCluster']),\n    ...mapGetters({ locale: 'i18n/selectedLocaleLabel', hasMultipleLocales: 'i18n/hasMultipleLocales' }),\n    ...mapGetters('type-map', ['activeProducts']),\n\n    favoriteTypes: mapPref(FAVORITE_TYPES),\n\n    supportLink() {\n      const product = this.rootProduct;\n\n      if (product?.supportRoute) {\n        return { ...product.supportRoute, params: { ...product.supportRoute.params, cluster: this.clusterId } };\n      }\n\n      return { name: `c-cluster-${ product?.name }-support` };\n    },\n\n    displayVersion() {\n      if (this.isSingleProduct?.getVersionInfo) {\n        return this.isSingleProduct?.getVersionInfo(this.$store);\n      }\n      const { displayVersion } = getVersionInfo(this.$store);\n\n      return displayVersion;\n    },\n\n    singleProductAbout() {\n      return this.isSingleProduct?.aboutPage;\n    },\n\n    harvesterVersion() {\n      return this.$store.getters['cluster/byId'](HCI.SETTING, 'server-version')?.value || 'unknown';\n    },\n\n    showProductFooter() {\n      if (this.isVirtualProduct) {\n        return true;\n      } else {\n        return false;\n      }\n    },\n\n    isVirtualProduct() {\n      return this.rootProduct.name === HARVESTER;\n    },\n\n    allNavLinks() {\n      if ( !this.clusterId || !this.$store.getters['cluster/schemaFor'](UI.NAV_LINK) ) {\n        return [];\n      }\n\n      return this.$store.getters['cluster/all'](UI.NAV_LINK);\n    },\n\n    allSchemasIds() {\n      const managementReady = this.managementReady;\n      const product = this.currentProduct;\n\n      if ( !managementReady || !product ) {\n        return [];\n      }\n\n      return this.$store.getters[`${ product.inStore }/all`](SCHEMA).map((s) => s.id).sort();\n    },\n\n    namespaces() {\n      return this.$store.getters['activeNamespaceCache'];\n    },\n\n    allNavLinksIds() {\n      return this.allNavLinks.map((a) => a.id);\n    },\n  },\n\n  methods: {\n    getGroups() {\n      if ( this.gettingGroups ) {\n        return;\n      }\n      this.gettingGroups = true;\n\n      if ( !this.clusterReady ) {\n        clear(this.groups);\n        this.gettingGroups = false;\n\n        return;\n      }\n\n      const currentProduct = this.$store.getters['productId'];\n      const namespaceMode = 'both';\n      const out = [];\n      const loadProducts = this.isExplorer ? [EXPLORER] : [];\n\n      const productMap = this.activeProducts.reduce((acc, p) => {\n        return { ...acc, [p.name]: p };\n      }, {});\n\n      if ( this.isExplorer ) {\n        for ( const product of this.activeProducts ) {\n          if ( product.inStore === 'cluster' ) {\n            addObject(loadProducts, product.name);\n          }\n        }\n      }\n\n      addObject(loadProducts, currentProduct);\n\n      this.getProductsGroups(out, loadProducts, namespaceMode, productMap);\n      this.getExplorerGroups(out);\n\n      replaceWith(this.groups, ...sortBy(out, ['weight:desc', 'label']));\n\n      this.gettingGroups = false;\n    },\n\n    getProductsGroups(out, loadProducts, namespaceMode, productMap) {\n      const clusterId = this.$store.getters['clusterId'];\n      const currentType = this.$route.params.resource || '';\n\n      for ( const productId of loadProducts ) {\n        const modes = [TYPE_MODES.BASIC];\n\n        if ( productId === NAVLINKS ) {\n          continue;\n        }\n\n        if ( productId === EXPLORER ) {\n          modes.push(TYPE_MODES.FAVORITE);\n          modes.push(TYPE_MODES.USED);\n        }\n\n        const typesByMode = this.$store.getters['type-map/allTypes'](productId, modes);\n\n        for ( const mode of modes ) {\n          const types = typesByMode[mode] || {};\n          const more = this.$store.getters['type-map/getTree'](productId, mode, types, clusterId, namespaceMode, currentType);\n\n          if ( productId === EXPLORER || !this.isExplorer ) {\n            addObjects(out, more);\n          } else {\n            const root = more.find((x) => x.name === 'root');\n            const other = more.filter((x) => x.name !== 'root');\n\n            const group = {\n              name:     productId,\n              label:    this.$store.getters['i18n/withFallback'](`product.${ productId }`, null, ucFirst(productId)),\n              children: [...(root?.children || []), ...other],\n              weight:   productMap[productId]?.weight || 0,\n            };\n\n            addObject(out, group);\n          }\n        }\n      }\n    },\n\n    getExplorerGroups(out) {\n      if ( this.isExplorer ) {\n        const allNavLinks = this.allNavLinks;\n        const toAdd = [];\n        const haveGroup = {};\n\n        for ( const obj of allNavLinks ) {\n          if ( !obj.link ) {\n            continue;\n          }\n\n          const groupLabel = obj.spec.group;\n          const groupSlug = obj.normalizedGroup;\n\n          const entry = {\n            name:        `link-${ obj._key }`,\n            link:        obj.link,\n            target:      obj.actualTarget,\n            label:       obj.labelDisplay,\n            sideLabel:   obj.spec.sideLabel,\n            iconSrc:     obj.spec.iconSrc,\n            description: obj.spec.description,\n          };\n\n          if ( groupSlug ) {\n            if ( haveGroup[groupSlug] ) {\n              continue;\n            }\n\n            haveGroup[groupSlug] = true;\n\n            toAdd.push({\n              name:     `navlink-group-${ groupSlug }`,\n              label:    groupLabel,\n              isRoot:   true,\n              children: [\n                {\n                  name:  `navlink-child-${ groupSlug }`,\n                  label: groupLabel,\n                  route: {\n                    name:   'c-cluster-navlinks-group',\n                    params: {\n                      cluster: this.clusterId,\n                      group:   groupSlug,\n                    }\n                  },\n                }\n              ],\n              weight: -100,\n            });\n          } else {\n            toAdd.push({\n              name:     `navlink-${ entry.name }`,\n              label:    entry.label,\n              isRoot:   true,\n              children: [entry],\n              weight:   -100,\n            });\n          }\n        }\n\n        addObjects(out, toAdd);\n      }\n    },\n\n    groupSelected(selected) {\n      this.$refs.groups.forEach((grp) => {\n        if (grp.canCollapse) {\n          grp.isExpanded = (grp.group.name === selected.name);\n        }\n      });\n    },\n\n    collapseAll() {\n      this.$refs.groups.forEach((grp) => {\n        grp.isExpanded = false;\n      });\n    },\n\n    syncNav() {\n      const refs = this.$refs.groups;\n\n      if (refs) {\n        let canExpand = true;\n        const expanded = refs.filter((grp) => grp.isExpanded)[0];\n\n        if (expanded && expanded.hasActiveRoute()) {\n          this.$nextTick(() => expanded.syncNav());\n\n          return;\n        }\n        refs.forEach((grp) => {\n          if (!grp.group.isRoot) {\n            grp.isExpanded = false;\n            if (canExpand) {\n              const isActive = grp.hasActiveRoute();\n\n              if (isActive) {\n                grp.isExpanded = true;\n                canExpand = false;\n                this.$nextTick(() => grp.syncNav());\n              }\n            }\n          }\n        });\n      }\n    },\n  },\n};\n</script>\n\n<template>\n  <nav\n    class=\"side-nav\"\n    role=\"navigation\"\n    :aria-label=\"t('nav.ariaLabel.sideNav')\"\n  >\n    <div class=\"nav\">\n      <template\n        v-for=\"(g) in groups\"\n        :key=\"g.name\"\n      >\n        <Group\n          ref=\"groups\"\n          id-prefix=\"\"\n          class=\"package\"\n          :group=\"g\"\n          :can-collapse=\"!g.isRoot\"\n          :show-header=\"!g.isRoot\"\n          @selected=\"groupSelected($event)\"\n          @expand=\"groupSelected($event)\"\n        />\n      </template>\n    </div>\n\n    <div\n      v-if=\"showProductFooter\"\n      class=\"footer\"\n    >\n      <router-link\n        :to=\"supportLink\"\n        class=\"pull-right\"\n        role=\"link\"\n        :aria-label=\"t('nav.support', {hasSupport: true})\"\n      >\n        {{ t('nav.support', {hasSupport: true}) }}\n      </router-link>\n      <span\n        v-clean-tooltip=\"{content: displayVersion, placement: 'top'}\"\n        class=\"clip version text-muted\"\n      >\n        {{ displayVersion }}\n      </span>\n      <LocaleSelector\n        v-if=\"isSingleProduct && hasMultipleLocales && !isStandaloneHarvester\"\n        mode=\"login\"\n        :show-icon=\"false\"\n      />\n    </div>\n\n    <div\n      v-else\n      class=\"version text-muted flex\"\n    >\n      <router-link\n        v-if=\"singleProductAbout\"\n        :to=\"singleProductAbout\"\n        role=\"link\"\n        :aria-label=\"t('nav.ariaLabel.productAboutPage')\"\n      >\n        {{ displayVersion }}\n      </router-link>\n      <template v-else>\n        <span\n          v-if=\"isVirtualCluster && isExplorer\"\n          v-clean-tooltip=\"{content: harvesterVersion, placement: 'top'}\"\n          class=\"clip text-muted ml-5\"\n        >\n          (Harvester-{{ harvesterVersion }})\n        </span>\n      </template>\n    </div>\n  </nav>\n</template>\n\n<style lang=\"scss\" scoped>\n// ─── DESIGN TOKENS ────────────────────────────────────────────────────────────\n// Single source of truth for all sizing. Tune here, everything updates.\n:root {\n  --sn-font-size:      14px;   // unified font size for ALL nav rows (headers + items)\n  --sn-font-weight:    500;    // normal rows\n  --sn-font-weight-hd: 500;    // group headers — SAME weight as items (fixes font difference)\n  --sn-item-height:    32px;   // exact row height (matches original design)\n  --sn-item-px:        12px;   // horizontal padding inside each row\n  --sn-item-gap:       12px;    // vertical gap between rows (matches spec)\n  --sn-child-indent:   8px;    // extra left indent for items inside a group body\n  --sn-radius:         8px;    // border-radius for all rows\n  --sn-icon-size:      16px;   // icon box size\n  --sn-icon-gap:       8px;    // gap between icon and label text\n}\n\n// ─── SHELL ────────────────────────────────────────────────────────────────────\n.side-nav {\n  display: flex;\n  flex-direction: column;\n  position: relative;\n  overflow: hidden;\n  border-right: 1px solid var(--border);\n  padding-bottom: 4px;\n\n  > * {\n    position: relative;\n    z-index: 1;\n  }\n\n  .nav {\n    flex: 1;\n    overflow-y: auto;\n    padding: 10px 8px;\n  }\n}\n\n// ─── GROUP WRAPPER ────────────────────────────────────────────────────────────\n// Space between top-level accordion groups = item gap (keeps rhythm consistent)\n.side-nav :deep(.accordion) {\n  margin-bottom: var(--sn-item-gap);\n}\n\n// ─── GROUP HEADER ─────────────────────────────────────────────────────────────\n// \"Networks\", \"Backup and Snapshots\", \"Monitoring & Logging\", \"Advanced\"\n//\n// FIX 1 — font must be identical to leaf items:\n//   font-size: var(--sn-font-size)  → 14px, same as .type-link\n//   font-weight: var(--sn-font-weight-hd) → 500, same as .type-link\n//   Previously the header had font-size: 13px + font-weight: 600 while items\n//   had font-size: 14px + font-weight: 500 — that mismatch caused the visible\n//   difference. Now both share the same token values.\n//\n// FIX 2 — height locked to 32px via min-height so headers and items are the\n//   same box size.\n//\n// FIX 3 — text must NOT truncate (white-space: normal, no overflow: hidden,\n//   no text-overflow: ellipsis on the h6). Long labels like\n//   \"Backup and Snapshots\" must wrap or simply fit.\n.side-nav :deep(.accordion .header) {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n\n  min-height: var(--sn-item-height);  // 32px — same box as items\n  padding: 0 var(--sn-item-px);\n  border-radius: var(--sn-radius);\n\n  // ↓ Unified typography — matches .type-link exactly\n  font-size:   var(--sn-font-size);\n  font-weight: var(--sn-font-weight-hd);\n  line-height: 1.3;\n  text-transform: none;\n  letter-spacing: normal;\n\n  color: var(--body-text);\n  opacity: 0.8;                  // subtle mute so headers feel like organisers\n  background: transparent;\n  cursor: pointer;\n\n  transition: background 0.15s ease, opacity 0.15s ease;\n\n  &:hover {\n    background: var(--nav-hover);\n    opacity: 1;\n    text-decoration: none;\n  }\n}\n\n// Rancher injects an <h6> inside the header — strip all its own sizing so our\n// parent rules take full effect. Also allow text to wrap (no truncation).\n.side-nav :deep(.accordion .header h6) {\n  margin: 0;\n  font-size: inherit;\n  font-weight: inherit;\n  line-height: inherit;\n  text-transform: none;\n\n  white-space: normal;\n  overflow: visible;\n  text-overflow: unset;\n  word-break: normal;\n}\n\n// Chevron icon in header — keep it visually light\n.side-nav :deep(.toggle-accordion) {\n  opacity: 0.5;\n  flex-shrink: 0;\n  margin-left: 4px;\n}\n\n// ─── GROUP BODY ───────────────────────────────────────────────────────────────\n// NEVER set a background here — it would fuse all children into one block.\n// Left indent visually nests children under their header.\n// Top/bottom padding keeps breathing room equal to one item-gap.\n.side-nav :deep(.accordion .body) {\n  background: transparent;\n  padding: var(--sn-item-gap) 0 var(--sn-item-gap) var(--sn-child-indent);\n}\n\n// ─── NAV ITEMS (leaf links) ───────────────────────────────────────────────────\n// Every clickable route target — both root-level and inside a group.\n//\n// FIX 1 — height: 32px locked (same as header)\n// FIX 2 — gap between rows: margin-bottom: 8px (var(--sn-item-gap))\n// FIX 3 — label must NOT truncate: white-space: normal on .label\n// FIX 4 — icon slot: a 16px icon box before the label\n.side-nav :deep(.type-link) {\n  display: flex;\n  align-items: center;\n  // justify-content: space-between keeps the count badge (⊞ 1) on the right\n  justify-content: space-between;\n\n  min-height: var(--sn-item-height);  // 32px\n  padding: 0 var(--sn-item-px);\n  border-radius: var(--sn-radius);\n\n  font-size:   var(--sn-font-size);   // 14px — same as header\n  font-weight: var(--sn-font-weight); // 500  — same as header\n  line-height: 1.3;\n  color: var(--body-text);\n\n  margin-bottom: var(--sn-item-gap);  // 8px vertical gap between items\n  transition: background 0.15s ease, color 0.15s ease;\n  cursor: pointer;\n\n  &:last-child {\n    margin-bottom: 0;\n  }\n\n  &:hover {\n    background: var(--nav-hover);\n    text-decoration: none;\n  }\n}\n\n// Active route pill\n.side-nav :deep(.router-link-exact-active.type-link),\n.side-nav :deep(.type-link.router-link-active) {\n  background: var(--nav-active);\n  font-weight: 600;\n  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);\n}\n\n// ─── LABEL TEXT ───────────────────────────────────────────────────────────────\n// FIX: \"Cluster Network Configuration\" was being cut to \"Cluster Network Configu...\"\n// Root cause was white-space: nowrap + overflow: hidden + text-overflow: ellipsis\n// on .label. We remove ALL three constraints so the full text is always visible.\n// The sidebar itself is wide enough; we just need to stop clipping it.\n.side-nav :deep(.type-link .label) {\n  flex: 1;\n  min-width: 0;\n  white-space: normal;\n  overflow: visible;\n  text-overflow: unset;\n  word-break: normal;\n  margin-top: 4px;\n  margin-bottom: 4px;\n\n}\n\n// ─── ICONS ────────────────────────────────────────────────────────────────────\n// Rancher/Harvester nav items already include an <i class=\"icon ...\"> element\n// inside .type-link. We size and position it consistently.\n// For group headers the icon lives inside .header — same treatment.\n//\n// If a specific item has no icon from the framework, you can add one via\n// CSS content on a ::before pseudo, keyed by data-type attribute, but that\n// requires knowing the resource name. The rules below handle the existing icons.\n\n// Icon inside leaf items\n.side-nav :deep(.type-link > i),\n.side-nav :deep(.type-link > .icon) {\n  flex-shrink: 0;\n  width:  var(--sn-icon-size);   // 16px\n  height: var(--sn-icon-size);\n  font-size: var(--sn-icon-size);\n  line-height: var(--sn-icon-size);\n  text-align: center;\n  margin-right: var(--sn-icon-gap);  // 8px between icon and label\n  opacity: 0.65;\n}\n\n// Active item — full opacity icon\n.side-nav :deep(.router-link-exact-active.type-link > i),\n.side-nav :deep(.router-link-exact-active.type-link > .icon) {\n  opacity: 1;\n}\n\n// Icon inside group headers (chevron aside, there may be a type icon)\n.side-nav :deep(.accordion .header > i),\n.side-nav :deep(.accordion .header > .icon) {\n  flex-shrink: 0;\n  width:  var(--sn-icon-size);\n  height: var(--sn-icon-size);\n  font-size: var(--sn-icon-size);\n  line-height: var(--sn-icon-size);\n  text-align: center;\n  margin-right: var(--sn-icon-gap);\n  opacity: 0.6;\n}\n\n// Count badge (⊞ 2) — right-aligned, keep it small\n.side-nav :deep(.type-link .count),\n.side-nav :deep(.type-link .side-label) {\n  flex-shrink: 0;\n  font-size: 11px;\n  opacity: 0.55;\n  margin-left: 6px;\n}\n\n// ─── TOOLS BAR ────────────────────────────────────────────────────────────────\n.side-nav .tools {\n  display: flex;\n  margin: 10px;\n  text-align: center;\n\n  A {\n    align-items: center;\n    border: 1px solid var(--border);\n    border-radius: var(--sn-radius);\n    color: var(--body-text);\n    display: flex;\n    justify-content: center;\n    outline: 0;\n    flex: 1;\n    padding: 10px;\n    transition: background 0.15s ease;\n\n    &:hover {\n      background: var(--nav-hover);\n      text-decoration: none;\n    }\n\n    > I {\n      margin-right: 4px;\n    }\n  }\n\n  &.router-link-active:not(:hover) A {\n    background-color: var(--nav-active);\n  }\n}\n\n// ─── FOOTER ───────────────────────────────────────────────────────────────────\n.side-nav .footer {\n  margin: 16px 12px;\n  display: flex;\n  flex-direction: row;\n  font-size: 12px;\n  color: var(--body-text);\n  opacity: 0.7;\n\n  > * {\n    flex: 1;\n    text-align: center;\n\n    &:first-child { text-align: left; }\n    &:last-child  { text-align: right; }\n  }\n\n  .version {\n    margin: 0;\n    cursor: default;\n  }\n\n  .locale-chooser {\n    cursor: pointer;\n  }\n}\n\n.side-nav .version {\n  cursor: default;\n  margin: 0 10px 10px 10px;\n}\n\n.flex {\n  display: flex;\n}\n</style>"]}]}