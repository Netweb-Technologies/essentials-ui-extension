/* TEXT */)),\n            _cache[2] || (_cache[2] = _createTextVNode()),\n            _createElementVNode(\"span\", _hoisted_3, _toDisplayString($props.resourceName), 1 /* TEXT */),\n            _cache[3] || (_cache[3] = _createTextVNode()),\n            ($props.badge)\n              ? _withDirectives((_openBlock(), _createBlock($setup[\"BadgeState\"], {\n                  key: 2,\n                  class: \"badge-state\",\n                  color: $props.badge.color,\n                  label: $props.badge.label\n                }, null, 8 /* PROPS */, [\"color\", \"label\"])), [\n                  [_directive_ui_context, { store: $setup.store, icon: 'icon-folder', hookable: true, value: $props.resource, tag: '__details-state', description: 'Details' }]\n                ])\n              : _createCommentVNode(\"v-if\", true)\n          ]),\n          _: 1 /* STABLE */,\n          __: [1,2,3]\n        }),\n        _cache[7] || (_cache[7] = _createTextVNode()),\n        _createElementVNode(\"div\", _hoisted_4, [\n          _renderSlot(_ctx.$slots, \"additional-actions\", {}, undefined, true),\n          _cache[5] || (_cache[5] = _createTextVNode()),\n          ($props.onShowConfiguration)\n            ? (_openBlock(), _createBlock($setup[\"RcButton\"], {\n                key: 0,\n                \"data-testid\": $setup.showConfigurationDataTestId,\n                class: \"show-configuration\",\n                primary: true,\n                \"aria-label\": $setup.i18n.t('component.resource.detail.titleBar.ariaLabel.showConfiguration', { resource: $props.resourceName }),\n                onClick: _cache[0] || (_cache[0] = () => $setup.emit('show-configuration', $setup.showConfigurationReturnFocusSelector))\n              }, {\n                default: _withCtx(() => [\n                  _cache[4] || (_cache[4] = _createElementVNode(\"i\", {\n                    class: \"icon icon-document\",\n                    \"aria-hidden\": \"true\"\n                  }, null, -1 /* CACHED */)),\n                  _createTextVNode(\" \" + _toDisplayString($setup.i18n.t('component.resource.detail.titleBar.showConfiguration')), 1 /* TEXT */)\n                ]),\n                _: 1 /* STABLE */,\n                __: [4]\n              }, 8 /* PROPS */, [\"aria-label\"]))\n            : _createCommentVNode(\"v-if\", true),\n          _cache[6] || (_cache[6] = _createTextVNode()),\n          ($props.actionMenuResource)\n            ? (_openBlock(), _createBlock($setup[\"ActionMenu\"], {\n                key: 1,\n                \"button-role\": \"multiAction\",\n                resource: $props.actionMenuResource,\n                \"data-testid\": \"masthead-action-menu\",\n                \"button-aria-label\": $setup.i18n.t('component.resource.detail.titleBar.ariaLabel.actionMenu', { resource: $props.resourceName })\n              }, null, 8 /* PROPS */, [\"resource\", \"button-aria-label\"]))\n            : _createCommentVNode(\"v-if\", true)\n        ])\n      ]),\n      _: 3 /* FORWARDED */,\n      __: [7]\n    }),\n    _cache[8] || (_cache[8] = _createTextVNode()),\n    ($props.description)\n      ? (_openBlock(), _createElementBlock(\"div\", _hoisted_5, _toDisplayString($props.description), 1 /* TEXT */))\n      : _createCommentVNode(\"v-if\", true),\n    _cache[9] || (_cache[9] = _createTextVNode()),\n    _createVNode($setup[\"ExtensionPanel\"], {\n      resource: $props.resource,\n      type: $setup.ExtensionPoint.PANEL,\n      location: $setup.PanelLocation.DETAILS_MASTHEAD\n    }, null, 8 /* PROPS */, [\"resource\", \"type\", \"location\"])\n  ]))\n}","<script lang=\"ts\">\nimport BadgeState from '@components/BadgeState/BadgeState.vue';\nimport { RouteLocationRaw, useRouter } from 'vue-router';\nimport Title from '@shell/components/Resource/Detail/TitleBar/Title.vue';\nimport Top from '@shell/components/Resource/Detail/TitleBar/Top.vue';\nimport ActionMenu from '@shell/components/ActionMenuShell.vue';\nimport { useStore } from 'vuex';\nimport { useI18n } from '@shell/composables/useI18n';\nimport RcButton from '@components/RcButton/RcButton.vue';\nimport TabTitle from '@shell/components/TabTitle';\nimport { computed, ref, watch } from 'vue';\nimport { _CONFIG, AS } from '@shell/config/query-params';\nimport { ExtensionPoint, PanelLocation } from '@shell/core/types';\nimport ExtensionPanel from '@shell/components/ExtensionPanel.vue';\n\nexport interface Badge {\n  color: 'bg-success' | 'bg-error' | 'bg-warning' | 'bg-info';\n  label: string;\n}\n\nexport interface TitleBarProps {\n  resource: any;\n  resourceTypeLabel: string;\n  resourceName: string;\n\n  resourceTo?: RouteLocationRaw;\n  description?: string;\n  badge?: Badge;\n\n  // This should be replaced with a list of menu items we want to render.\n  // I don't have the time right now to swap this out though.\n  actionMenuResource?: any;\n  onShowConfiguration?: (returnFocusSelector: string) => void;\n}\n</script>\n\n<script setup lang=\"ts\">\nconst {\n  resource, resourceTypeLabel, resourceTo, resourceName, description, badge, onShowConfiguration,\n} = defineProps<TitleBarProps>();\n\nconst store = useStore();\nconst i18n = useI18n(store);\nconst router = useRouter();\n\nconst emit = defineEmits(['show-configuration']);\nconst showConfigurationDataTestId = 'show-configuration-cta';\nconst showConfigurationReturnFocusSelector = computed(() => `[data-testid=\"${ showConfigurationDataTestId }\"]`);\n\nconst currentView = ref(router?.currentRoute?.value?.query?.as || _CONFIG);\n\nwatch(\n  () => currentView.value,\n  () => {\n    router.push({ query: { [AS]: currentView.value } });\n  }\n);\n</script>\n\n<template>\n  <div class=\"title-bar\">\n    <Top>\n      <Title class=\"title\">\n        <TabTitle :show-child=\"false\">\n          {{ resourceTypeLabel }}\n        </TabTitle>\n        <router-link\n          v-if=\"resourceTo\"\n          :to=\"resourceTo\"\n          class=\"resource-link\"\n        >\n          {{ resourceTypeLabel }}:\n        </router-link>\n        <span\n          v-else\n          class=\"resource-text\"\n        >\n          {{ resourceTypeLabel }}:\n        </span>\n        <span class=\"resource-name masthead-resource-title\">\n          {{ resourceName }}\n        </span>\n        <BadgeState\n          v-if=\"badge\"\n          v-ui-context=\"{ store: store, icon: 'icon-folder', hookable: true, value: resource, tag: '__details-state', description: 'Details' }\"\n          class=\"badge-state\"\n          :color=\"badge.color\"\n          :label=\"badge.label\"\n        />\n      </Title>\n      <div class=\"actions\">\n        <slot name=\"additional-actions\" />\n        <RcButton\n          v-if=\"onShowConfiguration\"\n          :data-testid=\"showConfigurationDataTestId\"\n          class=\"show-configuration\"\n          :primary=\"true\"\n          :aria-label=\"i18n.t('component.resource.detail.titleBar.ariaLabel.showConfiguration', { resource: resourceName })\"\n          @click=\"() => emit('show-configuration', showConfigurationReturnFocusSelector)\"\n        >\n          <i\n            class=\"icon icon-document\"\n            aria-hidden=\"true\"\n          />\n          {{ i18n.t('component.resource.detail.titleBar.showConfiguration') }}\n        </RcButton>\n        <ActionMenu\n          v-if=\"actionMenuResource\"\n          button-role=\"multiAction\"\n          :resource=\"actionMenuResource\"\n          data-testid=\"masthead-action-menu\"\n          :button-aria-label=\"i18n.t('component.resource.detail.titleBar.ariaLabel.actionMenu', { resource: resourceName })\"\n        />\n      </div>\n    </Top>\n    <div\n      v-if=\"description\"\n      class=\"bottom description text-deemphasized\"\n    >\n      {{ description }}\n    </div>\n    <ExtensionPanel\n      :resource=\"resource\"\n      :type=\"ExtensionPoint.PANEL\"\n      :location=\"PanelLocation.DETAILS_MASTHEAD\"\n    />\n  </div>\n</template>\n\n<style lang=\"scss\" scoped>\n.title-bar {\n  min-width: 740px;\n\n  .badge-state {\n    font-size: 16px;\n    margin-left: 12px;\n    position: relative;\n  }\n\n  .icon-document {\n    width: 15px;\n    font-size: 16px;\n    margin-right: 10px;\n  }\n\n  .show-configuration {\n    margin-left: 16px;\n  }\n\n  &:deep() button[data-testid=\"masthead-action-menu\"] {\n    border-radius: 4px;\n    width: 35px;\n    height: 40px;\n    margin-left: 16px;\n\n    display: inline-flex;\n    flex-direction: row;\n    justify-content: center;\n    align-items: center;\n  }\n\n  .description {\n    max-width: 60%;\n  }\n\n  // This prevents the title from overlapping with the actions\n  .title {\n    max-width: calc(100% - 260px);\n  }\n\n  // We want the resource name to be what collaspes wh\n  .resource-name {\n    display: inline-block;\n    flex: 1;\n    white-space: nowrap;\n    overflow-x: hidden;\n    overflow-y: clip;\n    text-overflow: ellipsis;\n    margin-left: 4px;\n  }\n}\n</style>\n"]}]}