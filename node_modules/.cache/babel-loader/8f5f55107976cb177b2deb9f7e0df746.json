{"remainingRequest":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js??ruleSet[1].rules[4]!/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js??ruleSet[0].use[0]!/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js??ruleSet[0].use[1]!/home/ubuntu/essentials-ui-extension/pkg/harvester/formatters/HarvesterIpAddress.vue?vue&type=template&id=4d8c3b7a","dependencies":[{"path":"/home/ubuntu/essentials-ui-extension/pkg/harvester/formatters/HarvesterIpAddress.vue","mtime":1773206911370},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js","mtime":1773205228903},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js","mtime":1773205228903}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["/home/ubuntu/essentials-ui-extension/pkg/harvester/formatters/HarvesterIpAddress.vue"],"names":["t"],"mappings":";;;;;;;;UAgHa,eAAM;qBAAjB,oBAWM;2BAVJ,oBASO,6BAR4B,YAAG,KAA3B,EAAE,EAAE,IAAI,EAAE,QAAQ;gCAD7B,oBASO;YAPJ,GAAG,KAAK,EAAE,IAAI,IAAI;;4BAEnB,aAIE;cAFC,IAAI,EAAE,EAAE;cACR,KAAK,EAAE,QAAQ;;yCAFC,QAAQ,GAAGA,MAAC,8DAA8D,IAAI","sourcesContent":["<script>\nimport { get } from '@shell/utils/object';\nimport { isIpv4 } from '@shell/utils/string';\nimport { HCI as HCI_ANNOTATIONS } from '@pkg/harvester/config/labels-annotations';\nimport CopyToClipboardText from '@shell/components/CopyToClipboardText';\nimport { HCI } from '../types';\nimport { MANAGEMENT_NETWORK } from '../mixins/harvester-vm';\nimport { OFF } from '../models/kubevirt.io.virtualmachine';\n\nexport default {\n  components: { CopyToClipboardText },\n  props:      {\n    value: {\n      type:    String,\n      default: ''\n    },\n    row: {\n      type:     Object,\n      required: true\n    },\n    col: {\n      type:    Object,\n      default: () => {}\n    }\n  },\n\n  data() {\n    return { inStore: 'harvester' };\n  },\n\n  created() {\n    const inStore = this.$store.getters['currentProduct'].inStore;\n\n    this.inStore = inStore;\n  },\n\n  computed: {\n    ips() {\n      if (this.vmiIp.length) {\n        return [...this.vmiIp, ...this.networkAnnotationIP]\n          .filter(Boolean)\n          .sort((a, b) => a.ip < b.ip ? -1 : 1);\n      }\n\n      return this.customAnnotationIP;\n    },\n\n    customAnnotationIP() {\n      const annotationIp = get(this.row, `metadata.annotations.\"${ HCI_ANNOTATIONS.CUSTOM_IP }\"`);\n\n      if (annotationIp && isIpv4(annotationIp)) {\n        return [{\n          name: 'custom-ip', ip: annotationIp, isCustom: true\n        }];\n      }\n\n      return [];\n    },\n\n    networkAnnotationIP() {\n      if (this.row.actualState !== 'Running') { // TODO: Running\n        return [];\n      }\n\n      const annotationIp = get(this.row, `metadata.annotations.\"${ HCI_ANNOTATIONS.NETWORK_IPS }\"`) || '[]';\n\n      // Obtain IP from VM annotation, remove the CIDR suffix number if CIDR Exist\n      try {\n        const out = JSON.parse(annotationIp);\n\n        return out.map( (ip) => ({\n          ip:   ip.replace(/\\/[\\d\\D]*/, ''),\n          name: ''\n        }));\n      } catch (e) {\n        return [];\n      }\n    },\n\n    vmiIp() {\n      const vmiResources = this.$store.getters[`${ this.inStore }/all`](HCI.VMI);\n      const resource = vmiResources.find((VMI) => VMI.id === this.value) || null;\n      const networksName = this.row.networksName || [];\n      const vmiNetworks = resource?.spec?.networks || [];\n\n      return (resource?.status?.interfaces || []).filter((intf) => {\n        return isIpv4(intf.ipAddress) && networksName.includes(intf.name);\n      }).map((intf) => {\n        let name;\n        const network = vmiNetworks.find((network) => network.name === intf.name);\n\n        if (network && network.multus) {\n          name = network.multus.networkName;\n        } else if (network && network.pod) {\n          name = MANAGEMENT_NETWORK;\n        }\n\n        return {\n          ip: intf.ipAddress,\n          name\n        };\n      });\n    },\n\n    showIP() {\n      return this.row.stateDisplay !== OFF;\n    },\n  },\n};\n</script>\n\n<template>\n  <div v-if=\"showIP\">\n    <span\n      v-for=\"{ ip, name, isCustom } in ips\"\n      :key=\"`${ip}-${name}`\"\n    >\n      <CopyToClipboardText\n        v-clean-tooltip=\"isCustom ? t('harvester.formatters.harvesterIpAddress.customIpTooltip') : name\"\n        :text=\"ip\"\n        :plain=\"isCustom\"\n      />\n    </span>\n  </div>\n</template>\n"]}]}