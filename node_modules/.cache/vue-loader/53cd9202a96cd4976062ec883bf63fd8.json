 name: 'HarvesterHotUnplugModal',\n\n  emits: ['close'],\n\n  components: { Card },\n\n  props: {\n    resources: {\n      type:     Array,\n      required: true\n    },\n  },\n\n  computed: {\n    ...mapState('action-menu', ['modalData']),\n    ...mapGetters({ t: 'i18n/t' }),\n\n    actionResource() {\n      return this.resources[0];\n    },\n  },\n\n  methods: {\n    ok() {\n      this.modalData?.callback('ok');\n      this.$emit('close');\n    },\n  }\n};\n</script>\n\n<template>\n  <Card\n    ref=\"modal\"\n    name=\"modal\"\n    :show-highlight-border=\"false\"\n  >\n    <template #title>\n      <h4 class=\"text-default-text\">\n        {{ t('generic.tip') }}\n      </h4>\n    </template>\n\n    <template #body>\n      <p v-clean-html=\"t(modalData.contentKey)\"></p>\n    </template>\n\n    <template #actions>\n      <div class=\"actions\">\n        <div class=\"buttons\">\n          <button\n            type=\"button\"\n            class=\"btn role-secondary mr-10\"\n            @click=\"ok\"\n          >\n            {{ t('generic.ok') }}\n          </button>\n        </div>\n      </div>\n    </template>\n  </Card>\n</template>\n\n<style lang=\"scss\" scoped>\n.actions {\n  width: 100%;\n}\n\n.buttons {\n  display: flex;\n  justify-content: flex-end;\n  width: 100%;\n}\n</style>\n"]}]}