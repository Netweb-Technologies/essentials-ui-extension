{"remainingRequest":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js??ruleSet[0].use[1]!/home/ubuntu/essentials-ui-extension/pkg/harvester/dialog/VolumeCloneDialog.vue?vue&type=style&index=0&id=1fe1c0ae&lang=scss&scoped=true","dependencies":[{"path":"/home/ubuntu/essentials-ui-extension/pkg/harvester/dialog/VolumeCloneDialog.vue","mtime":1773206911358},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/css-loader/dist/cjs.js","mtime":1773205218439},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/stylePostLoader.js","mtime":1773205228903},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/postcss-loader/dist/cjs.js","mtime":1773205228871},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/sass-loader/dist/cjs.js","mtime":1773205221561},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js","mtime":1773205228903}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:Ci5hY3Rpb25zIHsKICB3aWR0aDogMTAwJTsKfQouYnV0dG9ucyB7CiAgZGlzcGxheTogZmxleDsKICBqdXN0aWZ5LWNvbnRlbnQ6IGZsZXgtZW5kOwogIHdpZHRoOiAxMDAlOwp9Cg=="},{"version":3,"sources":["/home/ubuntu/essentials-ui-extension/pkg/harvester/dialog/VolumeCloneDialog.vue"],"names":[],"mappings":";AAgIA,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,EAAE;EACP,CAAC,CAAC,CAAC,CAAC,CAAC,EAAE,CAAC,CAAC,CAAC,CAAC;AACb;AACA,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,EAAE;EACP,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,EAAE,CAAC,CAAC,CAAC,CAAC;EACb,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,EAAE,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC;EACzB,CAAC,CAAC,CAAC,CAAC,CAAC,EAAE,CAAC,CAAC,CAAC,CAAC;AACb","file":"/home/ubuntu/essentials-ui-extension/pkg/harvester/dialog/VolumeCloneDialog.vue","sourceRoot":"","sourcesContent":["<script>\nimport { mapGetters } from 'vuex';\nimport { exceptionToErrorsArray } from '@shell/utils/error';\nimport { Card } from '@components/Card';\nimport { Banner } from '@components/Banner';\nimport AsyncButton from '@shell/components/AsyncButton';\nimport { LabeledInput } from '@components/Form/LabeledInput';\nimport { Checkbox } from '@components/Form/Checkbox';\n\nexport default {\n  name: 'HarvesterPvcCloneDialog',\n\n  emits: ['close'],\n\n  components: {\n    AsyncButton, Banner, Card, LabeledInput, Checkbox\n  },\n  props: {\n    resources: {\n      type:     Array,\n      required: true\n    }\n  },\n  data() {\n    return {\n      name:      '',\n      cloneData: true,\n      errors:    []\n    };\n  },\n  computed: {\n    ...mapGetters({ t: 'i18n/t' }),\n    actionResource() {\n      return this.resources[0];\n    },\n    disableSave() {\n      return this.cloneData && !this.name;\n    }\n  },\n  methods: {\n    close() {\n      this.name = '';\n      this.$emit('close');\n    },\n    async save(buttonCb) {\n      if (!this.cloneData) {\n        this.resources[0].goToClone();\n        buttonCb(false);\n        this.close();\n\n        return;\n      }\n\n      try {\n        const res = await this.actionResource.doAction('clone', { name: this.name });\n\n        if (res._status === 200 || res._status === 204) {\n          this.$store.dispatch('growl/success', {\n            title:   this.t('harvester.notification.title.succeed'),\n            message: this.t('harvester.modal.volumeClone.message.success', { name: this.name })\n          }, { root: true });\n          this.close();\n          buttonCb(true);\n        } else {\n          const error = [res?.data] || exceptionToErrorsArray(res);\n\n          this['errors'] = error;\n          buttonCb(false);\n        }\n      } catch (err) {\n        const error = err?.data || err;\n        const message = exceptionToErrorsArray(error);\n\n        this['errors'] = message;\n        buttonCb(false);\n      }\n    }\n  },\n};\n</script>\n<template>\n  <Card :show-highlight-border=\"false\">\n    <template #title>\n      {{ t('harvester.modal.volumeClone.title') }}\n    </template>\n\n    <template #body>\n      <Checkbox\n        v-model:value=\"cloneData\"\n        class=\"mb-10\"\n        label-key=\"harvester.modal.cloneVM.type\"\n      />\n\n      <LabeledInput\n        v-show=\"cloneData\"\n        v-model:value=\"name\"\n        class=\"mb-20\"\n        :label=\"t('harvester.modal.volumeClone.name')\"\n        required\n      />\n      <Banner\n        v-for=\"(err, i) in errors\"\n        :key=\"i\"\n        color=\"error\"\n        :label=\"err\"\n      />\n    </template>\n\n    <template #actions>\n      <div class=\"actions\">\n        <div class=\"buttons\">\n          <button\n            class=\"btn role-secondary mr-10\"\n            @click=\"close\"\n          >\n            {{ t('generic.cancel') }}\n          </button>\n          <AsyncButton\n            mode=\"create\"\n            :disabled=\"disableSave\"\n            @click=\"save\"\n          />\n        </div>\n      </div>\n    </template>\n  </Card>\n</template>\n<style lang=\"scss\" scoped>\n.actions {\n  width: 100%;\n}\n.buttons {\n  display: flex;\n  justify-content: flex-end;\n  width: 100%;\n}\n</style>\n"]}]}