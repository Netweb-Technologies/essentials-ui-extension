   'lastTimestamp:desc',\n        formatter:     'LiveDate',\n        formatterOpts: { addSuffix: true },\n        width:         125,\n        defaultSort:   true,\n      },\n    ];\n\n    return { eventHeaders };\n  },\n\n};\n</script>\n\n<template>\n  <SortableTable\n    :rows=\"events\"\n    :headers=\"eventHeaders\"\n    key-field=\"id\"\n    :search=\"false\"\n    :table-actions=\"false\"\n    :row-actions=\"false\"\n    :paging=\"true\"\n    :rows-per-page=\"10\"\n    default-sort-by=\"date\"\n  >\n    <template #cell:resource=\"{row, value}\">\n      <div class=\"text-info\">\n        {{ value }}\n      </div>\n      <div v-if=\"row.message\">\n        {{ row.displayMessage }}\n      </div>\n    </template>\n  </SortableTable>\n</template>\n"]}]}