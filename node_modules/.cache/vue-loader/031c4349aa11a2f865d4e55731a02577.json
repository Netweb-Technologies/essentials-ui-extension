{"remainingRequest":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js??ruleSet[0].use[1]!/home/ubuntu/essentials-ui-extension/pkg/harvester/formatters/HarvesterBackupTargetValidation.vue?vue&type=template&id=8c20c274","dependencies":[{"path":"/home/ubuntu/essentials-ui-extension/pkg/harvester/formatters/HarvesterBackupTargetValidation.vue","mtime":1773206911370},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/templateLoader.js","mtime":1773205228903},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js","mtime":1773205228903}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:CiAgPGRpdj4KICAgIHt7IHZhbHVlIH19CiAgICA8cAogICAgICB2LWlmPSJzaG91bGRTaG93RXJyb3IiCiAgICAgIGNsYXNzPSJ0ZXh0LWVycm9yIgogICAgPgogICAgICB7eyB0KCdoYXJ2ZXN0ZXIuYmFja3VwLm1hdGNoVGFyZ2V0JykgfX0KICAgIDwvcD4KICA8L2Rpdj4K"},{"version":3,"sources":["/home/ubuntu/essentials-ui-extension/pkg/harvester/formatters/HarvesterBackupTargetValidation.vue"],"names":[],"mappings":";EAkEE,CAAC,CAAC,CAAC,CAAC;IACF,CAAC,EAAE,CAAC,CAAC,CAAC,CAAC,EAAE,CAAC;IACV,CAAC;MACC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC;MACrB,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC;IACnB;MACE,CAAC,EAAE,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,EAAE,CAAC;IACxC,CAAC,CAAC,CAAC;EACL,CAAC,CAAC,CAAC,CAAC,CAAC","file":"/home/ubuntu/essentials-ui-extension/pkg/harvester/formatters/HarvesterBackupTargetValidation.vue","sourceRoot":"","sourcesContent":["<script>\nimport { NORMAN } from '@shell/config/types';\nimport { HCI } from '../types';\n\nexport default {\n  props: {\n    value: {\n      type:    String,\n      default: ''\n    }\n  },\n\n  async fetch() {\n    const harvesterSettings = await this.$store.dispatch('harvester/findAll', { type: HCI.SETTING });\n\n    this.harvesterSettings = harvesterSettings;\n\n    const clusterRoleTemplateBindingSchema = this.$store.getters['rancher/schemaFor'](NORMAN.CLUSTER_ROLE_TEMPLATE_BINDING);\n\n    if (clusterRoleTemplateBindingSchema) {\n      const normanBindings = await this.$store.dispatch('rancher/findAll', { type: NORMAN.CLUSTER_ROLE_TEMPLATE_BINDING }, { root: true });\n\n      this.clusterRoleTemplateBinding = normanBindings;\n    }\n  },\n\n  data() {\n    const user = this.$store.getters['auth/v3User'];\n\n    return {\n      harvesterSettings:          [],\n      clusterRoleTemplateBinding: [],\n      user,\n    };\n  },\n\n  computed: {\n    isMatch() {\n      const harvesterSettings = this.$store.getters['harvester/all'](HCI.SETTING) || [];\n      const resource = harvesterSettings.find( (V) => V.id === 'backup-target');\n\n      let isMatch = false;\n\n      try {\n        isMatch = this.value === resource?.parseValue?.endpoint;\n      } catch (e) {}\n\n      return isMatch;\n    },\n\n    isClusterOwner() {\n      const template = this.clusterRoleTemplateBinding.find((template) => {\n        return template.userId === this.user?.id;\n      });\n\n      return template?.roleTemplateId === 'cluster-owner';\n    },\n\n    shouldShowError() {\n      return this.isClusterOwner && !this.isMatch && this.value;\n    }\n  }\n};\n</script>\n\n<template>\n  <div>\n    {{ value }}\n    <p\n      v-if=\"shouldShowError\"\n      class=\"text-error\"\n    >\n      {{ t('harvester.backup.matchTarget') }}\n    </p>\n  </div>\n</template>\n"]}]}