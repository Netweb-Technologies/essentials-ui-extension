"mt-10\">\n    <div class=\"mb-5\">\n      {{ t('promptRemove.attemptingToRemove', { type: resourceType }) }} <span\n        v-clean-html=\"resourceNames(names, null, t)\"\n      />\n    </div>\n    <Banner\n      v-for=\"(error, i) in errors\"\n      :key=\"i\"\n      class=\"\"\n      color=\"error\"\n      :label=\"error\"\n    />\n  </div>\n</template>\n"]}]}