n        <LabelValue\n          :name=\"t('harvester.fields.promiscuous')\"\n          :value=\"value.promiscuous\"\n        >\n          <template #value>\n            {{ value.promiscuous === 'true' ? t('generic.yes') : t('generic.no') }}\n          </template>\n        </LabelValue>\n      </div>\n    </div>\n  </div>\n</template>\n"]}]}