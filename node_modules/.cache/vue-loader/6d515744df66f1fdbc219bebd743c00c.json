ble\"\n        v-model:value.number=\"parseDefaultValue.period\"\n        class=\"mb-20\"\n        :mode=\"mode\"\n        label-key=\"harvester.setting.vmForceDeletionPolicy.period\"\n      />\n    </div>\n  </div>\n</template>\n\n<style lang=\"scss\" scoped>\n  :deep() .radio-group {\n    display: flex;\n    .radio-container {\n      margin-right: 30px;\n    }\n  }\n</style>\n"]}]}