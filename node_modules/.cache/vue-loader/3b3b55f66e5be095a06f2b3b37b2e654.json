C,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC;UAC5B,CAAC;UACD,CAAC,CAAC,CAAC,CAAC,EAAE,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,EAAE,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,EAAE,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC;QACvC,CAAC,CAAC,CAAC,CAAC,CAAC;MACP,CAAC,CAAC,CAAC,CAAC,CAAC;IACP,CAAC,CAAC,CAAC,CAAC,CAAC;IACL,CAAC,CAAC,CAAC;MACD,CAAC,CAAC,CAAC,CAAC,CAAC;MACL,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC;IACrB;MACE,CAAC,EAAE,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,EAAE,CAAC;IAC7C,CAAC,CAAC,CAAC,CAAC,CAAC;EACP,CAAC,CAAC,CAAC,CAAC,CAAC","file":"/home/ubuntu/essentials-ui-extension/node_modules/@rancher/shell/components/AutoscalerCard.vue","sourceRoot":"","sourcesContent":["<script setup lang=\"ts\">\nimport { computed, ComputedRef } from 'vue';\nimport { useFetch } from '@shell/components/Resource/Detail/FetchLoader/composables';\nimport { useInterval } from '@shell/composables/useInterval';\nimport { useI18n } from '@shell/composables/useI18n';\nimport { useStore } from 'vuex';\n\nexport interface Props {\n  value: any;\n}\n\nexport interface Detail {\n  label: string;\n  value?: string | { component: any; props: any };\n}\n\nconst props = defineProps<Props>();\n\nconst store = useStore();\nconst i18n = useI18n(store);\n\nconst fetch = useFetch(async() => {\n  return await props.value.loadAutoscalerDetails();\n});\n\n// The backend only updates the configmap every 10 seconds and we don't cache the configmap in the stores\nuseInterval(() => fetch.value.refresh(), 10000);\n\nconst details: ComputedRef<Detail[]> = computed(() => fetch.value.data);\n</script>\n\n<template>\n  <div class=\"autoscaler-card\">\n    <div\n      v-if=\"fetch.loading && !fetch.refreshing\"\n      class=\"loading\"\n    >\n      <i\n        class=\"icon icon-lg icon-spinner icon-spin\"\n        :alt=\"i18n.t('autoscaler.card.loadingAlt')\"\n      />\n    </div>\n\n    <div\n      v-else-if=\"fetch.data\"\n      class=\"details\"\n    >\n      <div\n        v-for=\"(detail) in details\"\n        :key=\"detail.label\"\n        class=\"detail\"\n      >\n        <label\n          v-if=\"detail.value\"\n          class=\"label text-deemphasized\"\n        >\n          {{ detail.label }}\n        </label>\n        <h5 v-else-if=\"detail.label\">\n          {{ detail.label }}\n        </h5>\n        <div\n          v-if=\"detail.value\"\n          class=\"value\"\n        >\n          <component\n            :is=\"detail.value.component\"\n            v-if=\"typeof detail.value === 'object'\"\n            v-bind=\"detail.value.props\"\n          />\n          <span v-else>{{ detail.value }}</span>\n        </div>\n      </div>\n    </div>\n    <div\n      v-else\n      class=\"text-warning\"\n    >\n      {{ i18n.t('autoscaler.card.loadingError') }}\n    </div>\n  </div>\n</template>\n\n<style lang=\"scss\" scoped>\n.autoscaler-card {\nwidth: 240px;\n\n.loading {\n    display: flex;\n    justify-content: center;\n}\n.detail {\n    display: flex;\n    white-space: nowrap;\n    width: 244px;\n\n    &:not(:last-of-type) {\n    margin-bottom: 8px;\n    }\n\n    label, .value {\n    width: 50%;\n    }\n}\n\nh5 {\n    margin-bottom: 0;\n    margin-top: 12px;\n    font-size: 14px;\n    font-weight: 600;\n}\n}\n</style>\n"]}]}