n  }\n};\n</script>\n<template>\n  <router-link\n    v-if=\"to\"\n    :to=\"to\"\n  >\n    {{ value }}\n  </router-link>\n  <span v-else>\n    {{ value }}\n  </span>\n</template>\n"]}]}