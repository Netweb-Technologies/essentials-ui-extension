{"remainingRequest":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js??ruleSet[0].use[1]!/home/ubuntu/essentials-ui-extension/pkg/harvester/edit/harvesterhci.io.addon/rancher-vcluster.vue?vue&type=style&index=0&id=472a416c&lang=scss&scoped=true","dependencies":[{"path":"/home/ubuntu/essentials-ui-extension/pkg/harvester/edit/harvesterhci.io.addon/rancher-vcluster.vue","mtime":1773206911359},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/css-loader/dist/cjs.js","mtime":1773205218439},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/stylePostLoader.js","mtime":1773205228903},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/postcss-loader/dist/cjs.js","mtime":1773205228871},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/sass-loader/dist/cjs.js","mtime":1773205221561},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js","mtime":1773205228903}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:CiAgOmRlZXAoKSAucmFkaW8tZ3JvdXAgewogICAgZGlzcGxheTogZmxleDsKICAgIC5yYWRpby1jb250YWluZXIgewogICAgICBtYXJnaW4tcmlnaHQ6IDMwcHg7CiAgICB9CiAgfQo="},{"version":3,"sources":["/home/ubuntu/essentials-ui-extension/pkg/harvester/edit/harvesterhci.io.addon/rancher-vcluster.vue"],"names":[],"mappings":";EAkJE,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,EAAE,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,EAAE;IACnB,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,EAAE,CAAC,CAAC,CAAC,CAAC;IACb,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,EAAE;MACf,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,EAAE,CAAC,CAAC,CAAC,CAAC;IACpB;EACF","file":"/home/ubuntu/essentials-ui-extension/pkg/harvester/edit/harvesterhci.io.addon/rancher-vcluster.vue","sourceRoot":"","sourcesContent":["<script>\nimport merge from 'lodash/merge';\nimport jsyaml from 'js-yaml';\nimport { LabeledInput } from '@components/Form/LabeledInput';\nimport { RadioGroup } from '@components/Form/Radio';\n\nconst DEFAUL_VALUE = {\n  hostname:          '',\n  rancherVersion:    '',\n  bootstrapPassword: '',\n};\n\nexport default {\n  name:       'EditAddonVcluster',\n  components: { LabeledInput, RadioGroup },\n\n  inheritAttrs: false,\n\n  props: {\n    value: {\n      type:     Object,\n      required: true,\n    },\n\n    mode: {\n      type:     String,\n      required: true\n    },\n    registerBeforeHook: {\n      type:     Function,\n      required: true,\n    },\n  },\n\n  data() {\n    let valuesContentJson = {};\n\n    try {\n      valuesContentJson = merge({}, DEFAUL_VALUE, jsyaml.load(this.value.spec.valuesContent));\n    } catch (err) {\n      valuesContentJson = DEFAUL_VALUE;\n\n      this.$store.dispatch('growl/fromError', {\n        title: this.$store.getters['i18n/t']('generic.notification.title.error'),\n        err:   err.data || err,\n      }, { root: true });\n    }\n\n    return { valuesContentJson };\n  },\n\n  created() {\n    if (this.registerBeforeHook) {\n      this.registerBeforeHook(this.willSave, 'willSave');\n    }\n  },\n\n  methods: {\n    willSave() {\n      const errors = [];\n\n      if (!this.value.spec.enabled) {\n        return Promise.resolve();\n      }\n\n      if (!this.valuesContentJson.hostname) {\n        errors.push(this.t('validation.required', { key: this.t('harvester.addons.rancherVcluster.hostname') }, true));\n      }\n\n      if (!this.valuesContentJson.bootstrapPassword) {\n        errors.push(this.t('validation.required', { key: this.t('harvester.addons.rancherVcluster.password') }, true));\n      }\n\n      if (errors.length > 0) {\n        return Promise.reject(errors);\n      } else {\n        return Promise.resolve();\n      }\n    },\n  },\n\n  watch: {\n    valuesContentJson: {\n      handler(neu) {\n        this.value.spec['valuesContent'] = jsyaml.dump(neu);\n      },\n      deep:      true,\n      immediate: true\n    },\n  },\n};\n</script>\n\n<template>\n  <div>\n    <div class=\"row\">\n      <div class=\"col span-12\">\n        <RadioGroup\n          v-model:value=\"value.spec.enabled\"\n          class=\"mb-20\"\n          name=\"model\"\n          :mode=\"mode\"\n          :options=\"[true,false]\"\n          :labels=\"[t('generic.enabled'), t('generic.disabled')]\"\n        />\n      </div>\n    </div>\n\n    <template v-if=\"value.spec.enabled\">\n      <div class=\"row mb-20\">\n        <div class=\"col span-6\">\n          <LabeledInput\n            v-model:value=\"valuesContentJson.hostname\"\n            label-key=\"harvester.addons.rancherVcluster.hostname\"\n            :required=\"true\"\n            :mode=\"mode\"\n            placeholder=\"rancher.$vip.nip.io\"\n          />\n        </div>\n\n        <div class=\"col span-6\">\n          <LabeledInput\n            v-model:value=\"valuesContentJson.rancherVersion\"\n            label-key=\"harvester.addons.rancherVcluster.rancherVersion\"\n            :required=\"true\"\n            :disabled=\"true\"\n          />\n        </div>\n      </div>\n\n      <div class=\"row mt-20\">\n        <div class=\"col span-6\">\n          <LabeledInput\n            v-model:value=\"valuesContentJson.bootstrapPassword\"\n            label-key=\"harvester.addons.rancherVcluster.password\"\n            :mode=\"mode\"\n            :required=\"true\"\n            type=\"password\"\n          />\n        </div>\n      </div>\n    </template>\n  </div>\n</template>\n\n<style lang=\"scss\" scoped>\n  :deep() .radio-group {\n    display: flex;\n    .radio-container {\n      margin-right: 30px;\n    }\n  }\n</style>\n"]}]}