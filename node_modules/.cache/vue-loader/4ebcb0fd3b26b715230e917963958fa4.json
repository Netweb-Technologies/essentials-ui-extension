=\"button\"\n    aria-haspopup=\"menu\"\n    :aria-expanded=\"isMenuOpen\"\n    @keydown.enter.space=\"handleKeydown\"\n    @click=\"showMenu(true)\"\n  >\n    <template #before>\n      <slot name=\"before\">\n        <!-- Empty Content -->\n      </slot>\n    </template>\n    <slot name=\"default\">\n      <!--Empty slot content-->\n    </slot>\n    <template #after>\n      <slot name=\"after\">\n        <!-- Empty Content -->\n      </slot>\n    </template>\n  </RcButton>\n</template>\n"]}]}