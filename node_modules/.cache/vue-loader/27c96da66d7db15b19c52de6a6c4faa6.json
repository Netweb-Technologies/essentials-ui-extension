{"remainingRequest":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js??ruleSet[0].use[1]!/home/ubuntu/essentials-ui-extension/node_modules/@rancher/shell/components/GradientBox.vue?vue&type=style&index=0&id=c4203070&lang=scss","dependencies":[{"path":"/home/ubuntu/essentials-ui-extension/node_modules/@rancher/shell/components/GradientBox.vue","mtime":1773205215283},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/css-loader/dist/cjs.js","mtime":1773205218439},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/stylePostLoader.js","mtime":1773205228903},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/postcss-loader/dist/cjs.js","mtime":1773205228871},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/sass-loader/dist/cjs.js","mtime":1773205221561},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/cache-loader/dist/cjs.js","mtime":1773205218077},{"path":"/home/ubuntu/essentials-ui-extension/node_modules/vue-loader/dist/index.js","mtime":1773205228903}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:CiAgLmdyYWRpZW50LWJveCB7CiAgICAgIGJvcmRlci1yYWRpdXM6IDVweDsKICB9CiA="},{"version":3,"sources":["/home/ubuntu/essentials-ui-extension/node_modules/@rancher/shell/components/GradientBox.vue"],"names":[],"mappings":";EAwEE,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,EAAE;MACV,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,EAAE,CAAC,CAAC,CAAC;EACtB","file":"/home/ubuntu/essentials-ui-extension/node_modules/@rancher/shell/components/GradientBox.vue","sourceRoot":"","sourcesContent":["<script>\nexport default {\n  props: {\n    // a \"r, g, b\" tuple\n    primaryColorVar: {\n      type:    String,\n      default: null,\n    },\n\n    // Show the left side\n    showTab: {\n      type:    Boolean,\n      default: true,\n    },\n    showSolid: {\n      type:    Boolean,\n      default: false,\n    },\n    backgroundOpacityAdjustment: {\n      type:    Number,\n      default: 1\n    },\n    plain: {\n      type:    Boolean,\n      default: false,\n    }\n  },\n\n  computed: {\n    leftColor() {\n      return this.showSolid ? this.primaryColor : this.customizePrimaryColorOpacity(0.25 * this.backgroundOpacityAdjustment);\n    },\n\n    rightColor() {\n      return this.showSolid ? this.primaryColor : this.customizePrimaryColorOpacity(0.125 * this.backgroundOpacityAdjustment);\n    },\n\n    primaryColor() {\n      return this.customizePrimaryColorOpacity(1);\n    },\n\n    style() {\n      if (!this.plain) {\n        const background = `background: transparent linear-gradient(94deg, ${ this.leftColor } 0%, ${ this.rightColor } 100%) 0% 0% no-repeat padding-box;`;\n        const borderLeft = this.showTab ? `border-left: 9px solid ${ this.primaryColor };` : '';\n\n        return `${ background }${ borderLeft }`;\n      }\n\n      return '';\n    },\n  },\n\n  methods: {\n    customizePrimaryColorOpacity(opacity) {\n      return `rgba(var(${ this.primaryColorVar }), ${ opacity })`;\n    }\n  }\n};\n</script>\n\n<template>\n  <div\n    class=\"gradient-box\"\n    :class=\"{'show-tab': showTab, 'plain': plain}\"\n    :style=\"style\"\n  >\n    <slot />\n  </div>\n</template>\n\n<style lang=\"scss\">\n  .gradient-box {\n      border-radius: 5px;\n  }\n </style>\n\n<style lang=\"scss\" scoped>\n  .gradient-box.plain {\n      border: 1px solid var(--border);\n  }\n</style>\n"]}]}