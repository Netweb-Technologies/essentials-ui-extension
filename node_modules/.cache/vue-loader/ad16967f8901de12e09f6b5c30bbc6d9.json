ancher/shell/rancher-components/RcItemCard/RcItemCardAction.vue","sourceRoot":"","sourcesContent":["<script setup lang=\"ts\">\n/**\n * RcItemCardAction\n *\n * This component is used to wrap any interactive elements (like buttons, links)\n * inside an RcItemCard so they don't trigger the card-click event.\n *\n * Usage:\n *\n * <rc-item-card-action @click=\"doSomething\">\n *   <a href=\"#\">Click me</a>\n * </rc-item-card-action>\n *\n */\n</script>\n\n<template>\n  <div\n    item-card-action\n    class=\"rc-item-card-action\"\n    data-testid=\"rc-item-card-action\"\n  >\n    <slot />\n  </div>\n</template>\n\n<style lang=\"scss\">\n.rc-item-card-action {\n  .v-popper {\n    .icon-actions {\n      color: var(--body-text);\n      font-size: 19px;\n    }\n  }\n}\n</style>\n"]}]}